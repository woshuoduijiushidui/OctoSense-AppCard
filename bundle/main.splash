// Independent Octoscript application. All pantry behaviour lives here.
let state = {schema: 2 foods: [] plans: [] active: 0 next_id: 1 revision: 0
    profile_revision: 1 next_operation_id: 1 inventory_events: []
    offset: 0 demo: false paused: false reminders: true snooze: 0 risk_key: ""
    handled: 0 baseline: 0 cycle_start: time_now() log: [] model_enabled: true auto_generate: false
    profile: {done: false scene: "" sex: "" age: "" height: "" weight: "" allergies: "" avoidances: "" preferences: "" special: "" activity: "轻活动" basics_done: false plan_approved: false}
    programs: [] program_active: 0 program_next: 1 program_history: []
    health: {start: 0 day: 0 meals_per_day: 2 meals_week: 0 meals_today: 0
        protein_week: 0 fiber_week: 0 protein_goal: 0 fiber_goal: 0 calcium_goal: 0 iron_goal: 0}
    daily_target: 2000 consumed_kcal: 0 meal_count: 0 last_meal: "" last_goal: ""}
let tab = 0
let message = "先记库存，再安排今晚菜单。"
let draft_name = ""
let draft_grams = ""
let draft_unit = "g"
let draft_days = ""
let draft_date = ""
let draft_package_size = ""
let draft_package_unit = ""
let draft_average = ""
let draft_kcal = ""
let draft_protein = ""
let draft_fiber = ""
let draft_vitamin_c = ""
let show_nutrition_input = false
let goal = "优先吃掉快过期的食材"
let intake_draft = nil
let vision_phase = 0 // 0 unknown, 1 supported, 2 unavailable
let vision_sequence = 0
let vision_reply = nil
let recognition_sequence = 0
let recognition_phase = "" // choose, camera, import, model
let recognition_mode = ""
let recognition_image = ""
let recognition_deadline = 0
let recognition_reply = nil
let expanded_name = ""
let selected = -1
let details = false
let pending = false
let plan_removal = nil
let reset_pending = false
let booted = false
let storage_blocked = false
let editing_id = 0
let removal = nil
// Credentials stay in the host; image calls send only an app-local path.
let use_ai = true
let ai_phase = 0 // 0 checking, 1 configured, 2 no config, 3 error, 4 unsupported host
let ai_busy = false
let ai_error = ""
let ai_model = ""
let ai_calls = 0
let ai_sequence = 0
let probe_sequence = 0
let config_deadline = 0
let model_deadline = 0
let ai_snapshot = nil
let host_request_id = 0
let config_reply = nil
let model_reply = nil
let retry_reason = "用户请求"
// Push-to-talk audio stays in the trusted host; the script only receives text.
let voice_phase = 0 // 0 idle, 1 opening, 2 recording, 3 transcribing
let voice_sequence = 0
let voice_deadline = 0
let voice_reply = nil
let onboarding_step = 0
let profile_edit_backup = nil
let profile_sex = "不透露"
let profile_age = ""
let profile_height = ""
let profile_weight = ""
let profile_allergies = ""
let profile_avoidances = ""
let profile_preferences = ""
let profile_special = ""
let profile_activity = "轻活动"
let program_selected = 0
let extra_kcal_text = "0"
let show_shopping = false

let ink = #x22211f
let muted = #x77736d
let cream = #xf3efe8
let lime = #xe9e3d8
let line = #xe2ddd4
let glass = #xffffffe6
let glass_soft = #xffffffe0
let moss = #x272623
// Abstract cream light with restrained sage/lime blooms.
let Ambient = SolidView{width: Fill height: Fill draw_bg +: {
    pixel: fn(){
        let uv = self.pos
        let base = mix(#xf5f1eb, #e9e5de, uv.y)
        let sage = clamp(1.0 - length(uv - vec2(.82, .18)) * 1.65, 0.0, 1.0)
        let leaf = clamp(1.0 - length(uv - vec2(.14, .72)) * 1.35, 0.0, 1.0)
        let glow = clamp(1.0 - length(uv - vec2(.72, .84)) * 2.05, 0.0, 1.0)
        let color = mix(base, #xd7d0c5, sage * .30)
        let color = mix(color, #xc1b8aa, leaf * .18)
        let color = mix(color, #xffffff, glow * .35)
        return color
    }
}}
let Pill = ButtonFlat{draw_bg +: {
    pixel: fn(){
        let sdf = Sdf2d.viewport(self.pos * self.rect_size)
        sdf.box(1, 1, self.rect_size.x - 2, self.rect_size.y - 2, self.border_radius)
        let fill = mix(mix(self.color, self.color_hover, self.hover), self.color_down, self.down)
        sdf.fill_keep(mix(fill, #xe4e5d7, self.disabled))
        sdf.stroke(mix(fill, #x778470, self.focus), self.focus * 1.5)
        return sdf.result
    }
}}
let Action = Pill{width: Fill height: 56 margin: 0 padding: 12
    draw_bg +: {border_radius: 28 color: moss color_hover: #x373632 color_down: #x171714 color_focus: moss border_size: 0}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff text_style.font_size: 16}}
let Soft = Pill{width: Fill height: 48 margin: 0 padding: 9
    draw_bg +: {border_radius: 24 color: lime color_hover: #ded7cb color_down: #d2c9bb color_focus: lime border_size: 0}
    draw_text +: {color: ink color_hover: ink color_down: ink color_focus: ink text_style.font_size: 14}}
let Quiet = Pill{height: 42 margin: 0 padding: Inset{left: 13 right: 13}
    draw_bg +: {border_radius: 21 color: #xf4f1eced color_hover: #ebe6de color_down: #ddd6cb color_focus: #xf4f1eced border_size: 0}
    draw_text +: {color: ink color_hover: ink color_down: ink color_focus: ink text_style.font_size: 12}}
let ChosenSoft = Soft{
    draw_bg +: {color: moss color_hover: #x373632 color_down: #x171714 color_focus: moss}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff}}
let ChosenQuiet = Quiet{
    draw_bg +: {color: moss color_hover: #x373632 color_down: #x171714 color_focus: moss}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff}}
let Copy = Label{width: Fill padding: 0 draw_text +: {color: ink text_style.font_size: 14 line_spacing: 1.35}}
let Hint = Label{width: Fill padding: 0 draw_text +: {color: muted text_style.font_size: 12 line_spacing: 1.35}}
let Heading = Label{width: Fill padding: 0 draw_text +: {color: ink text_style: theme.font_bold{font_size: 27} line_spacing: 1.15}}
let Field = TextInput{width: Fill height: 54 margin: 0 padding: Inset{left: 16 right: 16}
    draw_bg +: {color: #xffffffc9 color_hover: #xffffffe5 color_focus: #xfffffff2 color_empty: #xffffffc9 border_radius: 22
        pixel: fn(){
            let sdf = Sdf2d.viewport(self.pos * self.rect_size)
            sdf.box(1, 1, self.rect_size.x - 2, self.rect_size.y - 2, 22)
            sdf.fill_keep(mix(#xffffffc9, #xfffffff2, self.focus))
            sdf.stroke(mix(#xffffffb8, #x4e765d, self.focus), 1)
            return sdf.result
        }}
    draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted text_style.font_size: 14}}
let VoiceButton = ButtonFlat{width: 64 height: 54 margin: 0 padding: 0 text: ""
    draw_bg +: {
        active: instance(0.0)
        pixel: fn(){
            let sdf = Sdf2d.viewport(self.pos * self.rect_size)
            sdf.box(2, 4, self.rect_size.x - 4, self.rect_size.y - 8, 22)
            sdf.fill(mix(#x00000000, mix(#xe8e3db80, #ddd5ca9a, self.down), self.hover))
            sdf.box(1, 11, 1, self.rect_size.y - 22, .5)
            sdf.fill(#xd8d1c7c8)
            let wave = mix(mix(#x22211f, #xc44d42, self.active), #x77736d, self.disabled)
            let cx = self.rect_size.x * .54
            let cy = self.rect_size.y * .5
            sdf.box(cx - 5, cy - 13, 10, 22, 5) sdf.fill(wave)
            sdf.box(cx - 11, cy - 2, 3, 10, 1.5) sdf.fill(wave)
            sdf.box(cx + 8, cy - 2, 3, 10, 1.5) sdf.fill(wave)
            sdf.box(cx - 9, cy + 7, 18, 3, 1.5) sdf.fill(wave)
            sdf.box(cx - 1.5, cy + 8, 3, 8, 1.5) sdf.fill(wave)
            sdf.box(cx - 7, cy + 14, 14, 3, 1.5) sdf.fill(wave)
            return sdf.result
        }}
    draw_text +: {color: #x00000000 color_hover: #x00000000 color_down: #x00000000 color_focus: #x00000000 text_style.font_size: 1}}
let Frost = RoundedView{show_bg: true width: Fill height: Fit flow: Down padding: 16 spacing: 10
    draw_bg +: {color: glass_soft border_radius: 24}}
let Tint = RoundedView{show_bg: true width: Fill height: Fit flow: Down padding: 15 spacing: 6
    draw_bg +: {color: #xf7f1df9e border_radius: 22}}
let EmojiGlass = RoundedView{show_bg: true width: 42 height: 42 flow: Overlay align: Align{x: .5 y: .5}
    draw_bg +: {color: #xffffff8f border_radius: 21}}
// The OctoSense host supplies the window frame; fill its entire content area.
// Keep the app surface in the normal draw order. GlassPanel hoists its entire
// child tree above the host's native device-permission sheet, leaving that
// sheet invisible while it still intercepts clicks.
let GlassCard = RoundedView{show_bg: true width: Fill height: Fill flow: Down padding: 0 spacing: 0
    draw_bg +: {color: #xf7f1ebe8 border_radius: 0}}
let Divider = SolidView{width: Fill height: 1 draw_bg.color: #x75826842}
let StatusDot = SolidView{width: 10 height: 10 draw_bg +: {color: #xb7a58a border_radius: 5}}
let ProgressRing = SolidView{width: 84 height: 84 draw_bg +: {
    progress: instance(.72)
    pixel: fn(){
        let sdf = Sdf2d.viewport(self.pos * self.rect_size)
        sdf.circle(self.rect_size.x * .5, self.rect_size.y * .5, self.rect_size.x * .39)
        sdf.stroke(mix(#xd4cec4, #x9f8b6d, clamp(self.progress, .0, 1.0)), self.rect_size.x * .075)
        return sdf.result
    }
}}

fn program_by_id(id){
    for p in state.programs { if p.id == id { return p } }
    nil
}
fn active_program(){ program_by_id(state.program_active) }
fn program_option(days, name, kcal_day, protein_day, fiber_day, vitamin_day){
    let p = {id: state.program_next name: name days: days daily_kcal: kcal_day
        kcal_goal: kcal_day * days protein_goal: protein_day * days
        fiber_goal: fiber_day * days vitamin_c_goal: vitamin_day * days
        consumed_kcal: 0 consumed_protein: 0 consumed_fiber: 0 consumed_vitamin_c: 0
        started: 0 intake: []}
    state.program_next = state.program_next + 1
    p
}
fn make_programs(){
    let age = state.profile.age.to_f64()
    let height = state.profile.height.to_f64()
    let weight = state.profile.weight.to_f64()
    let ready = age >= 19 && age <= 78 && state.profile.special == "" && (state.profile.sex == "女性" || state.profile.sex == "男性")
    let daily = 0
    let protein = 0
    let fiber = 0
    let vitamin = 0
    if ready {
        // Mifflin-St Jeor estimates resting expenditure, not an individual prescription.
        let resting = 10 * weight + 6.25 * height - 5 * age - 161
        if state.profile.sex == "男性" { resting = 10 * weight + 6.25 * height - 5 * age + 5 }
        let activity = 1.2
        if state.profile.activity == "中活动" { activity = 1.45 }
        if state.profile.activity == "高活动" { activity = 1.65 }
        let factor = 1.0
        if state.profile.scene == "减脂控卡" { factor = .93 }
        if state.profile.scene == "健身增肌" { factor = 1.05 }
        if state.profile.scene == "健身减脂" { factor = .96 }
        daily = floor(max(resting, resting * activity * factor) / 50) * 50
        protein = floor(weight * .8)
        if state.profile.scene == "健身增肌" || state.profile.scene == "健身减脂" { protein = floor(weight * 1.2) }
        fiber = floor(daily * .014)
        vitamin = 75
        if state.profile.sex == "男性" { vitamin = 90 }
    }
    let a = "7天均衡起步"
    let b = "21天持续饮食计划"
    let c = "30天长期管理"
    if state.profile.scene == "减脂控卡" { a = "7天减脂起步" b = "21天减脂餐" c = "30天稳态控卡" }
    if state.profile.scene == "健身增肌" { a = "7天训练餐" b = "21天增肌餐" c = "30天增肌饮食" }
    if state.profile.scene == "健身减脂" { a = "7天健身减脂起步" b = "21天健身减脂餐" c = "30天健身减脂计划" }
    state.programs = [program_option(7, a, daily, protein, fiber, vitamin)
        program_option(21, b, daily, protein, fiber, vitamin)
        program_option(30, c, daily, protein, fiber, vitamin)]
    program_selected = state.programs[0].id
}
fn select_program(id){ program_selected = id message = "已选择周期候选；确认后才开始执行。" redraw() }
fn confirm_health_plan(){
    let chosen = program_by_id(program_selected)
    if chosen == nil { message = "请先选择一份周期方案。" redraw() return }
    if chosen.kcal_goal <= 0 {
        message = "当前档案不能自动推算安全的数值目标，请由专业人员确认后再使用数值追踪。"
        redraw() return
    }
    let before = state.to_json()
    chosen.started = now()
    state.program_active = chosen.id
    state.profile.plan_approved = true
    state.health.start = now()
    state.health.day = floor(now() / 86400)
    state.health.meals_week = 0 state.health.meals_today = 0
    state.health.protein_week = 0 state.health.fiber_week = 0
    onboarding_step = 3
    state.daily_target = chosen.daily_kcal
    state.consumed_kcal = 0
    state.health.protein_goal = floor(chosen.protein_goal * 7 / chosen.days)
    state.health.fiber_goal = floor(chosen.fiber_goal * 7 / chosen.days)
    record("确认周期方案：" + chosen.name + " · " + chosen.days + " 天 · " + chosen.kcal_goal + " kcal")
    if profile_edit_backup != nil {
        let original = profile_edit_backup
        state.profile.done = true
        onboarding_step = 4 tab = 4
        if commit(original) { message = "用户画像与新周期方案已保存，原有库存不变。" }
        profile_edit_backup = nil
        redraw() return
    }
    if commit(before) { message = "已启用「" + chosen.name + "」。现在请录入冰箱里的真实食材。" }
    redraw()
}
fn choose_meals_per_day(value){
    if value < 1 || value > 4 { return }
    state.health.meals_per_day = value
    message = "每日执行餐数已选择 " + value + " 餐；确认方案后生效。"
    redraw()
}
fn renew_programs(){
    if pending || ai_busy || plan_removal != nil { message = "请先结束当前确认或方案生成。" redraw() return }
    let before = state.to_json()
    let old = active_program()
    if old != nil {
        if state.program_history.len() >= 12 { state.program_history.remove(0) }
        state.program_history.push(old.to_json().parse_json())
    }
    state.program_active = 0 state.profile.plan_approved = false
    state.profile.done = false state.active = 0 state.profile_revision = state.profile_revision + 1
    make_programs() onboarding_step = 2 tab = 0
    record("开始选择下一周期；旧周期已存档，库存保持不变")
    if commit(before) { message = "新周期候选已生成。请选定后继续；旧库存未删除。" }
    redraw()
}
fn program_day_index(p){
    if p == nil || p.started <= 0 { return 0 }
    health_day() - floor(p.started / 86400) + 1
}
fn program_today_kcal(p){
    if p == nil { return 0 }
    let today = health_day()
    let total = 0
    for meal in p.intake { if meal.day == today { total = total + meal.kcal } }
    total
}
fn program_remaining_total(p){ if p == nil { return 0 } max(0, p.kcal_goal - p.consumed_kcal) }
fn program_remaining_daily(p){
    if p == nil || program_day_index(p) > p.days || program_day_index(p) < 1 { return 0 }
    min(program_remaining_total(p), max(0, p.daily_kcal - program_today_kcal(p)))
}
fn goal_percent(value, target){ if target <= 0 { return 0 } min(100, floor(value * 100 / target)) }
fn health_day(){ floor(now() / 86400) }
fn health_today_meals(){ if state.health.day != health_day() { return 0 } state.health.meals_today }
fn health_week_meals(){ if state.health.start <= 0 || now() - state.health.start >= 604800 { return 0 } state.health.meals_week }
fn health_week_protein(){ if health_week_meals() == 0 { return 0 } state.health.protein_week }
fn health_week_fiber(){ if health_week_meals() == 0 { return 0 } state.health.fiber_week }
fn health_daily_percent(){
    if state.health.meals_per_day <= 0 { return 0 }
    min(100, floor(health_today_meals() * 100 / state.health.meals_per_day))
}
fn health_week_percent(){
    if state.health.meals_per_day <= 0 { return 0 }
    min(100, floor(health_week_meals() * 100 / (state.health.meals_per_day * 7)))
}
fn nutrient_reference(name, food_id){
    // Per-100-g demonstration references, not a comprehensive food database.
    // Unknown or mixed foods cannot be certified against a numeric plan.
    for f in state.foods {
        if f.id == food_id && f.to_json().search("nutrition") >= 0 {
            return {known: true kcal: f.nutrition.kcal protein: f.nutrition.protein fiber: f.nutrition.fiber vitamin_c: f.nutrition.vitamin_c}
        }
    }
    if name == "豆腐" { return {known: true kcal: 76 protein: 8 fiber: 1 vitamin_c: 0} }
    if name == "菠菜" { return {known: true kcal: 23 protein: 3 fiber: 2.2 vitamin_c: 28} }
    if name == "鸡蛋" { return {known: true kcal: 143 protein: 13 fiber: 0 vitamin_c: 0} }
    if name == "蘑菇" { return {known: true kcal: 22 protein: 3 fiber: 1 vitamin_c: 2} }
    {known: false kcal: 0 protein: 0 fiber: 0 vitamin_c: 0}
}
fn meal_nutrients(uses){
    let kcal = 0
    let protein = 0
    let fiber = 0
    let vitamin = 0
    let complete = true
    for u in uses {
        let n = nutrient_reference(u.name, u.food_id)
        if !n.known { complete = false }
        if n.known {
            kcal = kcal + u.grams * n.kcal / 100
            protein = protein + u.grams * n.protein / 100
            fiber = fiber + u.grams * n.fiber / 100
            vitamin = vitamin + u.grams * n.vitamin_c / 100
        }
    }
    {complete: complete kcal: floor(kcal) protein: floor(protein * 10) / 10
        fiber: floor(fiber * 10) / 10 vitamin_c: floor(vitamin * 10) / 10}
}
fn record_health_meal(uses, numeric){
    if state.health.start <= 0 { state.health.start = now() }
    if now() - state.health.start >= 604800 {
        state.health.start = now() state.health.meals_week = 0
        state.health.protein_week = 0 state.health.fiber_week = 0
        state.health.meals_today = 0 state.health.day = health_day()
    }
    if state.health.day != health_day() { state.health.day = health_day() state.health.meals_today = 0 }
    state.health.meals_today = state.health.meals_today + 1
    state.health.meals_week = state.health.meals_week + 1
    let estimate = meal_nutrients(uses)
    if numeric && estimate.complete {
        state.health.protein_week = state.health.protein_week + estimate.protein
        state.health.fiber_week = state.health.fiber_week + estimate.fiber
    }
}
fn clear_nutrition_draft(){
    draft_kcal = "" draft_protein = "" draft_fiber = "" draft_vitamin_c = ""
    show_nutrition_input = false
}
fn numeric_budget_ok(uses){
    let program = active_program()
    if program == nil || program.kcal_goal <= 0 { return false }
    let estimate = meal_nutrients(uses)
    estimate.complete && estimate.kcal > 0 && estimate.kcal <= program_remaining_daily(program)
}
fn plan_numeric(p){
    if p != nil && p.to_json().search("\"numeric\"") >= 0 && p.numeric == false { return false }
    true
}
fn plan_ready(p){
    if !validate(p) { return false }
    if plan_numeric(p) { return numeric_budget_ok(p.uses) }
    let program = active_program()
    program != nil && program_remaining_daily(program) > 0
}
fn now(){ time_now() + state.offset }
fn available(){
    state.foods.len()
}
fn record(text){
    state.log.push({at: time_now() text: text})
    if state.log.len() > 24 { state.log.remove(0) }
}
fn commit(before){
    if storage_blocked { state = before.parse_json() message = "库存文件异常，已停止写入。请先备份并修复数据。" return false }
    let result = fs.write("pantry.json", state.to_json())
    if result != nil {
        state = before.parse_json()
        message = "保存失败，操作未生效。请检查本地存储空间。"
        return false
    }
    fs.write("pantry.backup.json", state.to_json())
    true
}
fn valid_legacy_state(value){
    try {
        if value.schema != 1 || value.foods.len() > 60 || value.plans.len() > 20 { return false }
        if !(value.revision >= 0) || !(value.next_id >= 1) || !(value.offset >= 0) { return false }
        if value.health.meals_per_day < 1 || value.health.meals_per_day > 4 || value.health.meals_week < 0 || value.health.meals_today < 0 { return false }
        if value.health.protein_goal < 0 || value.health.fiber_goal < 0 || value.health.calcium_goal < 0 || value.health.iron_goal < 0 { return false }
        if value.health.protein_week < 0 || value.health.fiber_week < 0 { return false }
        if value.programs.len() > 3 || value.program_history.len() > 12 || value.program_next < 1 { return false }
        for program in value.programs {
            if program.days < 7 || program.days > 30 || program.kcal_goal < 0 || program.daily_kcal < 0 || program.consumed_kcal < 0 || program.intake.len() > 150 { return false }
            if program.protein_goal < 0 || program.fiber_goal < 0 || program.vitamin_c_goal < 0 { return false }
        }
        if value.program_active > 0 {
            let found_program = false
            for program in value.programs { if program.id == value.program_active && program.started > 0 { found_program = true } }
            if !found_program { return false }
        }
        for f in value.foods {
            if f.name.len() == 0 || f.name.len() > 40 || !(f.id > 0) || !(f.grams >= 0) || f.grams > 100000 || !(f.expires > 0) { return false }
            if f.to_json().search("nutrition") >= 0 {
                if !(f.nutrition.kcal > 0) || f.nutrition.kcal > 900 || f.nutrition.protein < 0 || f.nutrition.protein > 100 || f.nutrition.fiber < 0 || f.nutrition.fiber > 100 || f.nutrition.vitamin_c < 0 || f.nutrition.vitamin_c > 1000 { return false }
            }
        }
        for p in value.plans {
            if p.uses.len() > 60 || p.title.len() == 0 || !(p.revision >= 0) { return false }
            for u in p.uses { if !(u.grams > 0) || !(u.food_id > 0) { return false } }
            let check = p.accepted && !p.consumed
        }
        let fields = value.active + value.snooze + value.handled + value.baseline + value.cycle_start + value.log.len()
        let options = value.demo && value.paused && value.reminders
        value.risk_key.len()
        true
    } catch { false }
}
fn today_day(){ floor(now() / 86400) }
fn canonical_unit(unit){
    if unit == "g" || unit == "kg" { return "g" }
    if unit == "ml" || unit == "L" { return "ml" }
    if unit == "个" { return "piece" }
    ""
}
fn unit_scale(unit){
    if unit == "kg" || unit == "L" { return 1000 }
    if unit == "g" || unit == "ml" || unit == "个" { return 1 }
    0
}
fn package_unit(unit){ unit == "盒" || unit == "袋" || unit == "瓶" }
fn valid_nutrition(n){
    n.kcal > 0 && n.kcal <= 900 && n.protein >= 0 && n.protein <= 100 &&
        n.fiber >= 0 && n.fiber <= 100 && n.vitamin_c >= 0 && n.vitamin_c <= 1000
}
fn normalize_batch(input, id){
    let name = input.name.trim()
    let quantity = input.quantity
    let unit = input.unit
    let size = input.package_size
    let size_unit = input.package_size_unit
    let average = input.average_item_grams
    let day = input.expires_on_day
    let precision = input.expiry_precision
    let source = input.source
    if id < 1 || id != floor(id) || name.len() < 1 || name.len() > 40 || !(quantity > 0) || quantity > 100000 ||
        !(size >= 0) || !(average >= 0) || average > 100000 || !(day >= 0) || day > 1000000 || day != floor(day) { return nil }
    if (day == 0 && precision != "unknown") || (day > 0 && precision != "exact" && precision != "estimated") { return nil }
    if source != "manual" && source != "receipt_image" && source != "food_image" && source != "legacy" { return nil }
    let target = canonical_unit(unit)
    let canonical_quantity = 0
    if target != "" {
        if size != 0 || size_unit != "" { return nil }
        if unit == "个" && quantity != floor(quantity) { return nil }
        canonical_quantity = quantity * unit_scale(unit)
    } else {
        if !package_unit(unit) { return nil }
        if size == 0 {
            if size_unit != "" { return nil }
        } else {
            if size_unit != "g" && size_unit != "ml" && size_unit != "piece" { return nil }
            if size_unit == "piece" && size != floor(size) { return nil }
            target = size_unit
            canonical_quantity = quantity * size
        }
    }
    if canonical_quantity > 100000000 || (average > 0 && target != "piece") { return nil }
    let batch = {id: id name: name quantity: quantity unit: unit
        canonical_quantity: canonical_quantity canonical_unit: target
        package_size: size package_size_unit: size_unit average_item_grams: average
        expires_on_day: day expiry_precision: precision source: source}
    if input.to_json().search("\"nutrition\"") >= 0 {
        if !valid_nutrition(input.nutrition) { return nil }
        batch.nutrition = input.nutrition
    }
    if input.to_json().search("\"source_image_path\"") >= 0 { batch.source_image_path = input.source_image_path }
    batch
}
fn valid_state(value){
    try {
        if value.schema != 2 || value.foods.len() > 60 || value.plans.len() > 20 ||
            !(value.revision >= 0) || value.revision != floor(value.revision) ||
            !(value.profile_revision >= 1) || value.profile_revision != floor(value.profile_revision) ||
            !(value.next_operation_id >= 1) || value.next_operation_id != floor(value.next_operation_id) ||
            !(value.next_id >= 1) || value.next_id != floor(value.next_id) || !(value.offset >= 0) { return false }
        let profile = value.profile
        profile.allergies.len() profile.avoidances.len() profile.preferences.len()
        if value.health.meals_per_day < 1 || value.health.meals_per_day > 4 || value.health.meals_week < 0 || value.health.meals_today < 0 { return false }
        if value.health.protein_goal < 0 || value.health.fiber_goal < 0 || value.health.calcium_goal < 0 || value.health.iron_goal < 0 { return false }
        if value.health.protein_week < 0 || value.health.fiber_week < 0 { return false }
        if value.programs.len() > 3 || value.program_history.len() > 12 || value.program_next < 1 { return false }
        for program in value.programs {
            if program.days < 7 || program.days > 30 || program.kcal_goal < 0 || program.daily_kcal < 0 || program.consumed_kcal < 0 || program.intake.len() > 150 { return false }
            if program.protein_goal < 0 || program.fiber_goal < 0 || program.vitamin_c_goal < 0 { return false }
        }
        if value.program_active > 0 {
            let found_program = false
            for program in value.programs { if program.id == value.program_active && program.started > 0 { found_program = true } }
            if !found_program { return false }
        }
        let ids = []
        for f in value.foods {
            let normalized = normalize_batch(f, f.id)
            if normalized == nil || normalized.name != f.name || normalized.canonical_quantity != f.canonical_quantity || normalized.canonical_unit != f.canonical_unit { return false }
            if f.id >= value.next_id { return false }
            for seen in ids { if seen == f.id { return false } }
            ids.push(f.id)
        }
        let event_ids = []
        for event in value.inventory_events {
            if event.operation_id.len() == 0 || event.batch_ids.len() == 0 ||
                (event.type != "add" && event.type != "edit" && event.type != "discard" && event.type != "consume") { return false }
            for seen in event_ids { if seen == event.operation_id { return false } }
            event_ids.push(event.operation_id)
            for id in event.batch_ids { if !(id > 0) || id != floor(id) { return false } }
        }
        for p in value.plans {
            if p.uses.len() > 60 || p.title.len() == 0 || !(p.revision >= 0) || !(p.profile_revision >= 1) { return false }
            for u in p.uses {
                if !(u.food_id > 0) || !(u.grams >= 0) || (plan_numeric(p) && !(u.grams > 0)) { return false }
            }
        }
        let fields = value.active + value.snooze + value.handled + value.baseline + value.cycle_start + value.log.len()
        let options = value.demo && value.paused && value.reminders
        value.risk_key.len()
        true
    } catch { false }
}
fn migrate_state(value){
    if value.schema == 2 { return value }
    if value.schema != 1 { return value }
    // The embedded OctoSense desktop can use an older script runtime where
    // missing-field try/catch is unreliable. Inspect serialized keys first,
    // then add V2 fields explicitly without discarding V1 inventory or plans.
    let json = value.to_json()
    if json.search("profile") < 0 {
        value.profile = {done: false scene: "" sex: "" age: "" height: "" weight: "" avoid: "" diet: "" special: "" activity: "轻活动" basics_done: false plan_approved: false}
    }
    let profile_json = value.profile.to_json()
    if profile_json.search("basics_done") < 0 { value.profile.basics_done = value.profile.age != "" }
    if profile_json.search("plan_approved") < 0 { value.profile.plan_approved = value.profile.done }
    if profile_json.search("special") < 0 { value.profile.special = "" }
    if profile_json.search("activity") < 0 { value.profile.activity = "轻活动" }
    if json.search("programs") < 0 {
        value.programs = [] value.program_active = 0 value.program_next = 1 value.program_history = []
        // A previously approved generic scene has no numeric cycle. Keep the inventory,
        // but ask the user to review and activate one concrete program before planning.
        value.profile.plan_approved = false
    }
    if json.search("program_history") < 0 { value.program_history = [] }
    if json.search("program_next") < 0 { value.program_next = 1 }
    if json.search("program_active") < 0 { value.program_active = 0 }
    if json.search("health") < 0 {
        value.health = {start: 0 day: 0 meals_per_day: 2 meals_week: 0 meals_today: 0
            protein_week: 0 fiber_week: 0 protein_goal: 0 fiber_goal: 0 calcium_goal: 0 iron_goal: 0}
        let age = 0
        let weight = 0
        if value.profile.age != "" { age = value.profile.age.to_f64() }
        if value.profile.weight != "" { weight = value.profile.weight.to_f64() }
        if age >= 19 && age <= 50 && weight >= 25 && value.profile.special == "" {
            value.health.protein_goal = floor(weight * .8 * 7)
            value.health.fiber_goal = 175
            if value.profile.sex == "男性" { value.health.fiber_goal = 266 }
            value.health.calcium_goal = 7000
            if value.profile.sex == "女性" { value.health.iron_goal = 126 }
            if value.profile.sex == "男性" { value.health.iron_goal = 56 }
        }
        if value.profile.done { value.health.start = time_now() value.health.day = floor(time_now() / 86400) }
    }
    if json.search("daily_target") < 0 { value.daily_target = 2000 }
    if json.search("consumed_kcal") < 0 { value.consumed_kcal = 0 }
    if json.search("meal_count") < 0 { value.meal_count = 0 }
    if json.search("last_meal") < 0 { value.last_meal = "" }
    if json.search("last_goal") < 0 { value.last_goal = "" }
    if json.search("model_enabled") < 0 { value.model_enabled = true }
    if json.search("auto_generate") < 0 { value.auto_generate = false }
    if !valid_legacy_state(value) { return value }
    let old_profile = value.profile
    let avoidances = ""
    let preferences = ""
    if old_profile.to_json().search("\"avoid\"") >= 0 { avoidances = old_profile.avoid }
    if old_profile.to_json().search("\"diet\"") >= 0 { preferences = old_profile.diet }
    value.profile = {done: old_profile.done scene: old_profile.scene sex: old_profile.sex
        age: old_profile.age height: old_profile.height weight: old_profile.weight
        allergies: "" avoidances: avoidances.trim() preferences: preferences.trim()
        special: old_profile.special activity: old_profile.activity
        basics_done: old_profile.basics_done plan_approved: old_profile.plan_approved}
    let converted = []
    let clock = time_now() + value.offset
    let day = floor(clock / 86400)
    for f in value.foods {
        if f.grams > 0 {
            let expiry = day + max(0, ceil((f.expires - clock) / 86400))
            if f.expires < clock { expiry = day - 1 }
            let batch = {id: f.id name: f.name.trim() quantity: f.grams unit: "g"
                canonical_quantity: f.grams canonical_unit: "g"
                package_size: 0 package_size_unit: "" average_item_grams: 0
                expires_on_day: expiry expiry_precision: "estimated" source: "legacy"}
            if f.to_json().search("\"nutrition\"") >= 0 {
                batch.nutrition = {kcal: f.nutrition.kcal protein: f.nutrition.protein
                    fiber: f.nutrition.fiber vitamin_c: f.nutrition.vitamin_c precision: "estimated"}
            }
            converted.push(batch)
            if f.id >= value.next_id { value.next_id = f.id + 1 }
        }
    }
    value.foods = converted
    for p in value.plans { p.profile_revision = 1 }
    value.schema = 2
    value.profile_revision = 1
    value.next_operation_id = 1
    value.inventory_events = []
    value
}
fn ensure_extended_state(){
    if state.profile.basics_done && state.programs.len() == 0 { make_programs() }
    if state.profile.done && state.program_active > 0 && state.profile.plan_approved { onboarding_step = 4 }
    else {
        onboarding_step = 0
        if state.profile.scene != "" { onboarding_step = 1 }
        if state.profile.basics_done { onboarding_step = 2 }
        if state.profile.plan_approved && state.program_active > 0 { onboarding_step = 3 }
    }
    if state.profile.sex != "" { profile_sex = state.profile.sex }
    profile_age = state.profile.age
    profile_height = state.profile.height
    profile_weight = state.profile.weight
    profile_allergies = state.profile.allergies
    profile_avoidances = state.profile.avoidances
    profile_preferences = state.profile.preferences
    profile_special = state.profile.special
    profile_activity = state.profile.activity
    if program_selected == 0 && state.programs.len() > 0 { program_selected = state.programs[0].id }
}
fn choose_scene(name){
    ensure_extended_state()
    let before = state.to_json()
    state.profile.scene = name
    state.profile_revision = state.profile_revision + 1
    // A direction is a preference, never an executable numeric plan.
    onboarding_step = 1
    record("首次建档：选择场景 · " + name)
    if profile_edit_backup == nil { commit(before) }
    message = "再补充一点基础信息，让后续每一餐都沿用同一份用户画像。"
    redraw()
}
fn save_profile(){
    let age = profile_age.trim().to_f64()
    let height = profile_height.trim().to_f64()
    let weight = profile_weight.trim().to_f64()
    if !(age >= 12) || age > 100 || age != floor(age) { message = "年龄请填写 12–100 的整数。" redraw() return }
    if !(height >= 80) || height > 230 || height != floor(height) { message = "身高请填写 80–230 cm 的整数。" redraw() return }
    if !(weight >= 25) || weight > 300 { message = "体重请填写 25–300 kg 的数字。" redraw() return }
    let before = state.to_json()
    state.profile.sex = profile_sex
    state.profile.age = profile_age.trim()
    state.profile.height = profile_height.trim()
    state.profile.weight = profile_weight.trim()
    state.profile.allergies = profile_allergies.trim()
    state.profile.avoidances = profile_avoidances.trim()
    state.profile.preferences = profile_preferences.trim()
    state.profile.special = profile_special.trim()
    state.profile.activity = profile_activity
    state.profile.basics_done = true
    state.profile.plan_approved = false
    state.program_active = 0
    state.active = 0 state.profile_revision = state.profile_revision + 1
    make_programs()
    // An explicit reference plan is created before the first inventory entry.
    // These are demo estimates for healthy adults, not an assessment of disease.
    state.health.protein_goal = floor(weight * .8 * 7)
    state.health.fiber_goal = 175
    if profile_sex == "男性" { state.health.fiber_goal = 266 }
    state.health.calcium_goal = 7000
    state.health.iron_goal = 0
    if profile_sex == "女性" && age <= 50 { state.health.iron_goal = 126 }
    if profile_sex == "男性" { state.health.iron_goal = 56 }
    if age < 19 || age > 50 || state.profile.special != "" {
        state.health.protein_goal = 0 state.health.fiber_goal = 0
        state.health.calcium_goal = 0 state.health.iron_goal = 0
    }
    onboarding_step = 2
    record("首次建档：基础画像已确认")
    if profile_edit_backup != nil { message = "已生成 3 份周期候选。确认选中的方案后保存画像。" }
    else { if commit(before) { message = "已生成 3 份具体周期候选。先选定其中一份，再录入冰箱。" } }
    redraw()
}
fn finish_onboarding(){
    if available() == 0 { message = "先至少录入 1 批食材，Agent 才能根据真实库存开始托管。" redraw() return }
    let before = state.to_json()
    state.profile.done = true
    onboarding_step = 4
    tab = 0
    record("首次建档完成：用户画像 + 冰箱库存")
    if commit(before) { message = "建档完成。之后只需要持续更新购买与用餐状态，不必每次从头说明。" }
    redraw()
}
fn restart_profile(){
    if profile_edit_backup != nil { return }
    if pending || ai_busy || plan_removal != nil || intake_draft != nil || editing_id > 0 || recognition_phase != "" {
        message = "请先结束当前操作，再修改用户画像。" redraw() return
    }
    profile_edit_backup = state.to_json()
    let old = active_program()
    if old != nil {
        if state.program_history.len() >= 12 { state.program_history.remove(0) }
        state.program_history.push(old.to_json().parse_json())
    }
    state.program_active = 0 state.programs = [] program_selected = 0
    state.profile.done = false
    state.profile.basics_done = false
    state.profile.plan_approved = false
    state.profile_revision = state.profile_revision + 1
    onboarding_step = 0
    message = "正在修改用户画像；确认新周期方案前不会保存更改。"
    redraw()
}
fn cancel_profile_edit(){
    if profile_edit_backup == nil { return }
    state = profile_edit_backup.parse_json()
    profile_edit_backup = nil
    program_selected = state.program_active
    ensure_extended_state()
    onboarding_step = 4 tab = 4
    message = "已取消画像修改，原有档案和库存保持不变。"
    redraw()
}
fn set_goal(text){ goal = text message = "已切换本餐偏好：" + text redraw() }
fn generate_alternative(){
    if ai_busy { message = "当前方案还在生成，请稍候。" redraw() return }
    plan("用户请求备选")
    tab = 2
    redraw()
}
fn coming_soon(){ message = "第三方买菜平台的一键下单入口已预留，本次比赛版不执行外部购买。" redraw() }
fn meal_kcal(p){
    if p == nil { return 0 }
    if p.to_json().search("recorded_kcal") >= 0 { return p.recorded_kcal }
    let estimate = meal_nutrients(p.uses)
    if !estimate.complete { return 0 }
    estimate.kcal
}
fn remaining_budget(){
    program_remaining_daily(active_program())
}
fn nutrition_percent(){
    let p = active_program()
    if p == nil || p.kcal_goal <= 0 { return 0 }
    min(100, floor(p.consumed_kcal * 100 / p.kcal_goal))
}
fn unquantified_meals(){
    let p = active_program()
    if p == nil { return 0 }
    let count = 0
    for meal in p.intake {
        if meal.to_json().search("\"nutrition_known\"") >= 0 && meal.nutrition_known == false { count = count + 1 }
    }
    count
}
fn preference_summary(){
    ensure_extended_state()
    let value = state.last_goal
    if value == "" { return "正在从你的入库、选择与实际用餐中学习" }
    if value.search("清淡") >= 0 { return "最近更偏好 · 清淡" }
    if value.search("蛋白") >= 0 { return "最近更偏好 · 高蛋白" }
    if value.search("低卡") >= 0 || value.search("减脂") >= 0 { return "最近更偏好 · 控卡" }
    if value.search("荤") >= 0 || value.search("肉") >= 0 { return "最近更偏好 · 荤食" }
    "最近一次需求 · " + value
}
fn render_dashboard(){
    if onboarding_step < 4 { return }
    ui.navigation.render()
    ui.content.render()
    ui.actions.render()
    ui.notice.set_text(message)
    let status = "本地规则 · 正在守护"
    if use_ai {
        if ai_phase == 0 { status = "AI 配置 · 正在读取" }
        if ai_phase == 1 { status = "在线 AI · 宿主服务可用" }
        if ai_phase == 2 { status = "本地规则 · 未配置 AI" }
        if ai_phase == 3 { status = "在线 AI · 配置异常" }
        if ai_phase == 4 { status = "本地规则 · 宿主未提供 AI" }
        if ai_error != "" && ai_phase == 1 { status = "在线 AI · 需要重试" }
    }
    if ai_busy { status = "在线 AI · 正在规划" }
    if voice_phase == 1 { status = "语音输入 · 正在打开麦克风" }
    if voice_phase == 2 { status = "语音输入 · 正在聆听" }
    if voice_phase == 3 { status = "语音输入 · 正在识别" }
    if state.paused { status = "管家已暂停" }
    if state.auto_generate { status = status + " · 自动生成" }
    else { status = status + " · 手动生成" }
    if state.demo { status = status + " · 演示" }
    ui.agent_status.set_text(status)
}
fn redraw(){
    ui.app_body.render()
    if onboarding_step == 4 && recognition_phase == "" { start_timeout(0.01, || render_dashboard()) }
}
fn navigate(index){
    if pending { message = "请先确认或取消本次扣减。" redraw() return }
    if plan_removal != nil { message = "请先确认或取消删除方案。" redraw() return }
    if voice_phase != 0 { message = "请先结束本次语音输入。" redraw() return }
    tab = index
    details = false
    reset_pending = false
    redraw()
}
fn read_saved_state(path){
    try {
        let candidate = migrate_state(fs.read(path).parse_json())
        if valid_state(candidate) { return candidate }
    } catch { return nil }
    nil
}
fn load(){
    let restored = false
    if fs.exists("pantry.json") {
        let saved = read_saved_state("pantry.json")
        if saved != nil { state = saved restored = true }
        if !restored && fs.exists("pantry.backup.json") {
            let backup = read_saved_state("pantry.backup.json")
            if backup != nil {
                state = backup restored = true
                message = "已从备份恢复库存。原文件保留，请检查最近一次操作。"
            }
        }
        if !restored { storage_blocked = true message = "库存文件无法读取，已停止写入并保留原文件。请先备份修复。" }
    }
    ensure_extended_state()
    if state.plans.len() > 0 { selected = state.plans.len() - 1 }
    use_ai = state.model_enabled == true
    booted = true
    redraw()
    read_ai_config()
    probe_vision()
}
fn batch_grams(food){
    if food.canonical_unit == "g" { return food.canonical_quantity }
    if food.canonical_unit == "piece" && food.average_item_grams > 0 {
        return food.canonical_quantity * food.average_item_grams
    }
    0
}
fn restriction_matches(text, name){
    let terms = [text]
    for delimiter in ["，" "、" "；" ";" ","] {
        let next = []
        for part in terms { for word in part.split(delimiter) { next.push(word) } }
        terms = next
    }
    for raw in terms {
        let term = raw.trim()
        if term != "" && (term.search(name) >= 0 || name.search(term) >= 0) { return true }
    }
    false
}
fn excluded_food(name){
    restriction_matches(state.profile.allergies, name) || restriction_matches(state.profile.avoidances, name)
}
fn plan_eligible(food){
    (food.expires_on_day == 0 || food.expires_on_day >= today_day()) &&
        batch_grams(food) > 0 && !excluded_food(food.name)
}
fn auto_plan_eligible(food){ plan_eligible(food) }
fn recipe_eligible(food){
    (food.expires_on_day == 0 || food.expires_on_day >= today_day()) &&
        food.canonical_quantity > 0 &&
        (food.canonical_unit == "g" || food.canonical_unit == "ml" || food.canonical_unit == "piece") &&
        !excluded_food(food.name)
}
fn expiry_order(food){
    if food.expires_on_day == 0 { return 1000000 }
    food.expires_on_day
}
fn use_quantity(item){
    if item.to_json().search("\"quantity\"") >= 0 { return item.quantity }
    item.grams
}
fn use_unit(item){
    if item.to_json().search("\"unit\"") >= 0 { return item.unit }
    "g"
}
fn use_unit_text(item){ if use_unit(item) == "piece" { return "个" } use_unit(item) }
fn plan_use(food, desired_grams){
    if !plan_eligible(food) { return nil }
    let quantity = min(food.canonical_quantity, max(1, floor(desired_grams)))
    let grams = quantity
    if food.canonical_unit == "piece" {
        quantity = min(food.canonical_quantity, max(1, floor(desired_grams / food.average_item_grams)))
        grams = quantity * food.average_item_grams
    }
    {food_id: food.id name: food.name quantity: quantity unit: food.canonical_unit grams: grams}
}
fn recipe_use(food, desired_quantity){
    if !recipe_eligible(food) { return nil }
    let quantity = min(food.canonical_quantity, max(1, floor(desired_quantity)))
    if food.canonical_unit == "piece" && quantity != floor(quantity) { return nil }
    let grams = 0
    if food.canonical_unit == "g" { grams = quantity }
    {food_id: food.id name: food.name quantity: quantity unit: food.canonical_unit grams: grams}
}
fn revise_plan_use(item, desired_grams){
    for food in state.foods {
        if food.id == item.food_id {
            let revised = plan_use(food, desired_grams)
            if revised != nil { item.quantity = revised.quantity item.unit = revised.unit item.grams = revised.grams }
        }
    }
}
fn remaining(food){
    if food.expires_on_day == 0 { return 0 }
    food.expires_on_day - today_day()
}
fn freshness(food){
    if food.expires_on_day == 0 { return "保质期未知" }
    let days = remaining(food)
    if days < 0 { return "已过期" }
    if days <= 3 { return "临期" }
    "正常"
}
fn inventory_failure(before, reason){
    state = before.parse_json()
    message = reason
    false
}
fn apply_inventory_operation(operation, before_state){
    let before = before_state
    if before == nil { before = state.to_json() }
    if storage_blocked { return inventory_failure(before, "库存文件异常，已停止写入。") }
    try {
        if operation.operation_id.len() == 0 { return inventory_failure(before, "库存操作缺少编号。") }
        for event in before.parse_json().inventory_events {
            if event.operation_id == operation.operation_id {
                state = before.parse_json()
                return true
            }
        }
        let next = state.to_json().parse_json()
        let affected = []
        if operation.type != "add" && operation.type != "edit" && operation.type != "discard" && operation.type != "consume" {
            return inventory_failure(before, "不支持的库存操作。")
        }
        if operation.type == "add" {
            if operation.batches.len() == 0 || next.foods.len() + operation.batches.len() > 60 {
                return inventory_failure(before, "入库批次数量无效或已超过 60 批上限。")
            }
            for input in operation.batches {
                let batch = normalize_batch(input, next.next_id)
                if batch == nil { return inventory_failure(before, "入库食材的数量、单位或到期信息无效。") }
                next.foods.push(batch)
                affected.push(batch.id)
                next.next_id = next.next_id + 1
            }
        }
        if operation.type == "edit" {
            let index = -1
            for i in next.foods.len() { if next.foods[i].id == operation.batch_id { index = i } }
            if index < 0 { return inventory_failure(before, "要编辑的批次已不存在。") }
            let old = next.foods[index]
            let input = operation.batch
            input.source = old.source
            let batch = normalize_batch(input, old.id)
            if batch == nil { return inventory_failure(before, "编辑后的数量、单位或到期信息无效。") }
            if old.to_json().search("\"source_image_path\"") >= 0 && batch.to_json().search("\"source_image_path\"") < 0 {
                batch.source_image_path = old.source_image_path
            }
            next.foods[index] = batch
            affected.push(batch.id)
        }
        if operation.type == "discard" {
            let kept = []
            for f in next.foods {
                if f.id == operation.batch_id { affected.push(f.id) }
                else { kept.push(f) }
            }
            if affected.len() != 1 { return inventory_failure(before, "要移除的批次已不存在。") }
            next.foods = kept
        }
        if operation.type == "consume" {
            if operation.uses.len() == 0 { return inventory_failure(before, "请先确认实际食用量。") }
            for u in operation.uses {
                let index = -1
                for i in next.foods.len() { if next.foods[i].id == u.food_id { index = i } }
                if index < 0 { return inventory_failure(before, "食用批次已不存在或用量重复。") }
                let batch = next.foods[index]
                if !(u.quantity > 0) || u.quantity > batch.canonical_quantity ||
                    u.unit != batch.canonical_unit ||
                    (batch.expires_on_day > 0 && batch.expires_on_day < today_day()) ||
                    (u.unit == "piece" && u.quantity != floor(u.quantity)) {
                    return inventory_failure(before, "食用数量、单位或批次有效期无效。")
                }
                let was_risk = freshness(batch) == "临期"
                let left = batch.canonical_quantity - u.quantity
                affected.push(batch.id)
                if left == 0 {
                    next.foods.remove(index)
                    if was_risk { next.handled = next.handled + 1 }
                } else {
                    let factor = unit_scale(batch.unit)
                    if package_unit(batch.unit) { factor = batch.package_size }
                    batch.canonical_quantity = left
                    batch.quantity = left / factor
                }
            }
        }
        next.revision = next.revision + 1
        next.next_operation_id = next.next_operation_id + 1
        next.risk_key = ""
        next.inventory_events.push({operation_id: operation.operation_id type: operation.type batch_ids: affected})
        state = next
        if operation.type == "add" { state.baseline = max(state.baseline, risk_count() + state.handled) }
        if operation.type == "add" { record("确认入库：" + operation.batches[0].name + " 等 " + operation.batches.len() + " 批") }
        if operation.type == "edit" { record("确认修改批次 #" + operation.batch_id + "：" + operation.batch.name) }
        if operation.type == "discard" { record("用户确认移除批次 #" + operation.batch_id + "（不计食用）") }
        if !valid_state(state) { return inventory_failure(before, "库存操作未通过完整校验。") }
        if !commit(before) { return false }
        true
    } catch { inventory_failure(before, "库存操作数据无效，未写入。") }
}
fn food_emoji(name){
    if name.search("菠菜") >= 0 || name.search("青菜") >= 0 || name.search("生菜") >= 0 { return "🥬" }
    if name.search("鸡蛋") >= 0 || name.search("蛋") >= 0 { return "🥚" }
    if name.search("番茄") >= 0 || name.search("西红柿") >= 0 { return "🍅" }
    if name.search("牛奶") >= 0 || name.search("奶") >= 0 { return "🥛" }
    if name.search("豆腐") >= 0 || name.search("豆") >= 0 { return "◻️" }
    if name.search("蘑菇") >= 0 || name.search("菌") >= 0 { return "🍄" }
    if name.search("胡萝卜") >= 0 { return "🥕" }
    if name.search("苹果") >= 0 { return "🍎" }
    if name.search("香蕉") >= 0 { return "🍌" }
    if name.search("肉") >= 0 { return "🥩" }
    "·"
}
fn risk_count(){
    let count = 0
    for food in state.foods { if freshness(food) == "临期" { count = count + 1 } }
    count
}
fn progress_percent(){
    let total = max(state.baseline, risk_count() + state.handled)
    if total <= 0 { return 0 }
    min(100, floor(state.handled * 100 / total))
}
fn urgent_names(){
    let text = ""
    let count = 0
    for food in state.foods {
        if count < 3 && freshness(food) == "临期" {
            if text != "" { text = text + " · " }
            text = text + food.name
            count = count + 1
        }
    }
    if text == "" { return "暂无临期食材" }
    text
}
fn plan_percent(p){
    if p == nil { return 0 }
    let planned = 0
    let stocked = 0
    for food in state.foods { if plan_eligible(food) { stocked = stocked + batch_grams(food) } }
    for u in p.uses { planned = planned + u.grams }
    if stocked <= 0 { return 0 }
    min(100, floor(planned * 100 / stocked))
}
fn two_digits(value){ if value < 10 { return "0" + value } "" + value }
fn calendar_day(text){
    let value = text.trim()
    let parts = value.split("-")
    if value.len() != 10 || parts.len() != 3 { return -1 }
    let year = parts[0].to_f64()
    let month = parts[1].to_f64()
    let day = parts[2].to_f64()
    if !(year >= 1970) || year > 2100 || year != floor(year) ||
        !(month >= 1) || month > 12 || month != floor(month) ||
        !(day >= 1) || day != floor(day) || parts[0] != "" + year ||
        parts[1] != two_digits(month) || parts[2] != two_digits(day) { return -1 }
    let limit = 31
    if month == 4 || month == 6 || month == 9 || month == 11 { limit = 30 }
    if month == 2 {
        limit = 28
        if year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) { limit = 29 }
    }
    if day > limit { return -1 }
    let y = year
    if month <= 2 { y = y - 1 }
    let era = floor(y / 400)
    let yoe = y - era * 400
    let mp = month + 9
    if month > 2 { mp = month - 3 }
    let doy = floor((153 * mp + 2) / 5) + day - 1
    let doe = yoe * 365 + floor(yoe / 4) - floor(yoe / 100) + doy
    era * 146097 + doe - 719468
}
fn calendar_text(day){
    let z = day + 719468
    let era = floor(z / 146097)
    let doe = z - era * 146097
    let yoe = floor((doe - floor(doe / 1460) + floor(doe / 36524) - floor(doe / 146096)) / 365)
    let year = yoe + era * 400
    let doy = doe - (365 * yoe + floor(yoe / 4) - floor(yoe / 100))
    let mp = floor((5 * doy + 2) / 153)
    let number = doy - floor((153 * mp + 2) / 5) + 1
    let month = mp - 9
    if mp < 10 { month = mp + 3 }
    if month <= 2 { year = year + 1 }
    year + "-" + two_digits(month) + "-" + two_digits(number)
}
fn expiry_text(batch){
    if batch.expires_on_day == 0 { return "保质期未知" }
    let days = remaining(batch)
    let text = calendar_text(batch.expires_on_day)
    if days < 0 { return text + " · 已过期 " + (0 - days) + " 天" }
    text + " · 剩余 " + days + " 天"
}
fn freshness_rank(status){
    if status == "已过期" { return 4 }
    if status == "临期" { return 3 }
    if status == "保质期未知" { return 2 }
    1
}
fn inventory_groups(){
    let groups = []
    for food in state.foods {
        let index = -1
        for i in groups.len() { if groups[i].name == food.name.trim() { index = i } }
        if index < 0 {
            groups.push({name: food.name.trim() batches: [] totals: [] status: "正常"})
            index = groups.len() - 1
        }
        let group = groups[index]
        group.batches.push(food)
        let status = freshness(food)
        if freshness_rank(status) > freshness_rank(group.status) { group.status = status }
        let unit = food.canonical_unit
        let amount = food.canonical_quantity
        if unit == "piece" { unit = "个" }
        if unit == "" { unit = food.unit amount = food.quantity }
        let found = false
        for total in group.totals {
            if total.unit == unit { total.quantity = total.quantity + amount found = true }
        }
        if !found { group.totals.push({quantity: amount unit: unit}) }
    }
    groups
}
fn batch_ordinal(id){
    let name = ""
    for food in state.foods { if food.id == id { name = food.name } }
    let ordinal = 0
    for food in state.foods {
        if food.name == name { ordinal = ordinal + 1 }
        if food.id == id { return ordinal }
    }
    0
}
fn group_total_text(group){
    let text = ""
    for total in group.totals {
        if text != "" { text = text + " / " }
        text = text + total.quantity + total.unit
    }
    text
}
fn toggle_group(name){
    if expanded_name == name { expanded_name = "" }
    else { expanded_name = name }
    redraw()
}
fn draft_batch(row){
    let days_text = row.remaining_days_text.trim()
    let date_text = row.printed_expires_on.trim()
    if days_text != "" && date_text != "" { return nil }
    let expiry = 0
    let precision = "unknown"
    if days_text != "" {
        let days = days_text.to_f64()
        if (!(days >= 0) && editing_id == 0) || days < -365 || days > 365 || days != floor(days) { return nil }
        expiry = today_day() + days
        precision = "estimated"
    }
    if date_text != "" {
        expiry = calendar_day(date_text)
        if expiry < 1 { return nil }
        precision = "exact"
    }
    let size = 0
    if row.package_size_text.trim() != "" { size = row.package_size_text.trim().to_f64() }
    let average = 0
    if row.average_item_grams_text.trim() != "" { average = row.average_item_grams_text.trim().to_f64() }
    let quantity = row.quantity_text.trim().to_f64()
    if (row.unit == "个" || (package_unit(row.unit) && editing_id == 0)) && quantity != floor(quantity) { return nil }
    if row.package_size_text.trim() != "" && !(size > 0) { return nil }
    if row.average_item_grams_text.trim() != "" && !(average > 0) { return nil }
    let size_unit = row.package_size_unit
    if !package_unit(row.unit) { size = 0 size_unit = "" }
    if package_unit(row.unit) && size == 0 && size_unit != "" { return nil }
    if row.unit != "个" && !(package_unit(row.unit) && size_unit == "piece") { average = 0 }
    let source = "manual"
    if intake_draft.mode == "receipt_image" { source = "receipt_image" }
    if intake_draft.mode == "food_image" { source = "food_image" }
    let batch = {name: row.name.trim() quantity: quantity unit: row.unit
        package_size: size package_size_unit: size_unit
        average_item_grams: average expires_on_day: expiry expiry_precision: precision source: source}
    let any_nutrient = row.kcal_text.trim() != "" || row.protein_text.trim() != "" ||
        row.fiber_text.trim() != "" || row.vitamin_c_text.trim() != ""
    if any_nutrient {
        if row.kcal_text.trim() == "" || row.protein_text.trim() == "" ||
            row.fiber_text.trim() == "" || row.vitamin_c_text.trim() == "" { return nil }
        batch.nutrition = {kcal: row.kcal_text.trim().to_f64() protein: row.protein_text.trim().to_f64()
            fiber: row.fiber_text.trim().to_f64() vitamin_c: row.vitamin_c_text.trim().to_f64()}
    }
    if intake_draft.image_path != "" { batch.source_image_path = intake_draft.image_path }
    if normalize_batch(batch, 1) == nil { return nil }
    batch
}
fn preview_food(){
    let row = {row_id: 1 selected: true name: draft_name quantity_text: draft_grams unit: draft_unit
        package_size_text: draft_package_size package_size_unit: draft_package_unit
        average_item_grams_text: draft_average remaining_days_text: draft_days printed_expires_on: draft_date
        kcal_text: draft_kcal protein_text: draft_protein fiber_text: draft_fiber vitamin_c_text: draft_vitamin_c}
    intake_draft = {draft_id: "manual-" + time_now() mode: "manual" image_path: "" rows: [row] busy: false error: ""}
    message = "请核对草稿；只有最终确认才会写入库存。"
    redraw()
}
fn cancel_preview(){ intake_draft = nil message = "已取消草稿，库存没有变化。" redraw() }
fn probe_vision(){
    vision_sequence = vision_sequence + 1
    let token = vision_sequence
    vision_phase = 0
    try { host.request("model.vision_capability", {}, |r| { vision_reply = {token: token reply: r} }) }
    catch { vision_phase = 2 }
}
fn begin_recognition(mode){
    if vision_phase != 1 {
        message = "当前宿主暂不支持图片识别，请使用手动录入"
        redraw() return
    }
    if intake_draft != nil {
        message = "请先最终确认入库或取消当前草稿，再开始新的图片识别。"
        redraw() return
    }
    if editing_id > 0 || recognition_phase != "" { return }
    recognition_sequence = recognition_sequence + 1
    recognition_mode = mode recognition_image = "" recognition_phase = "choose"
    message = "请选择拍照或从本机导入一张图片；识别后仍需逐项核对。"
    redraw()
}
fn cancel_recognition(){
    if recognition_phase == "camera" { ui.recognition_cam.stop() }
    recognition_sequence = recognition_sequence + 1
    recognition_phase = "" recognition_image = "" recognition_deadline = 0
    message = "已取消图片识别，库存没有变化；可继续手动录入。"
    redraw()
}
fn recognition_failed(reason){
    if recognition_phase == "camera" { ui.recognition_cam.stop() }
    recognition_sequence = recognition_sequence + 1
    recognition_phase = "" recognition_image = "" recognition_deadline = 0
    message = reason + "；可继续手动录入。"
    redraw()
}
fn choose_camera(){
    if recognition_phase != "choose" { return }
    recognition_phase = "camera" redraw()
    let token = recognition_sequence
    try { host.request("camera.permission.request", {}, |r| {
        recognition_reply = {token: token action: "permission" reply: r}
    }) } catch { recognition_failed("摄像头授权请求失败") }
}
fn camera_captured(){
    if recognition_phase != "camera" { return }
    let path = ui.recognition_cam.last()
    ui.recognition_cam.stop()
    if !path.is_string() || path == "" { recognition_failed("拍照失败") return }
    recognize_image(path)
}
fn import_recognition_image(){
    if recognition_phase != "choose" { return }
    recognition_phase = "import" redraw()
    let token = recognition_sequence
    try { host.request("files.import", {path: "/pantry-image-" + time_now() + "-" + token}, |r| {
        recognition_reply = {token: token action: "import" reply: r}
    }) } catch { recognition_failed("图片导入失败") }
}
fn recognition_schema(){
    let value = {type: "string" maxLength: 120}
    {type: "object" additionalProperties: false required: ["items"] properties: {
        items: {type: "array" minItems: 1 maxItems: 30 items: {type: "object" additionalProperties: false
            required: ["name" "quantity_text" "unit" "package_size_text" "package_size_unit"
                "average_item_grams_text" "remaining_days_text" "printed_expires_on"
                "kcal_text" "protein_text" "fiber_text" "vitamin_c_text"]
            properties: {name: value quantity_text: value unit: value package_size_text: value
                package_size_unit: value average_item_grams_text: value remaining_days_text: value
                printed_expires_on: value kcal_text: value protein_text: value fiber_text: value vitamin_c_text: value}}}}}
}
fn recognize_image(path){
    if !path.is_string() || path == "" { recognition_failed("图片路径无效") return }
    recognition_image = path recognition_phase = "model"
    recognition_deadline = time_now() + 95
    let task = "识别这张冰箱或食材照片中的食材；只列能看清的食材。无法看清的数量、单位、保质期、包装和营养字段留空。不要猜测重量或营养值。"
    if recognition_mode == "receipt_image" {
        task = "读取这张购物小票中的食材行；只列能看清的食材，排除价格、运费和非食品。小票未明确给出的数量、单位、保质期、包装和营养字段留空。"
    }
    message = "正在识别图片；结果仅为待核对草稿，不会自动入库。" redraw()
    let token = recognition_sequence
    try { host.request("model.complete", {task: task + " 最多30行；所有字段都是字符串；只输出符合 schema 的 JSON。"
        image: {app_path: path} input: {kind: recognition_mode} schema: recognition_schema() class: "fast"},
        |r| { recognition_reply = {token: token action: "model" reply: r} }) }
    catch { recognition_failed("图片识别请求失败") }
}
fn draft_text(value){ if value != nil && value.is_string() { return value.trim() } "" }
fn recognized_unit(value){
    let unit = draft_text(value)
    if canonical_unit(unit) != "" || package_unit(unit) { return unit }
    ""
}
fn recognized_package_size_unit(value){
    let unit = draft_text(value)
    if unit == "g" || unit == "ml" || unit == "piece" { return unit }
    if unit == "个" { return "piece" }
    ""
}
fn apply_recognition_reply(envelope){
    if envelope.token != recognition_sequence { return }
    let r = envelope.reply
    if envelope.action == "permission" && recognition_phase == "camera" {
        if r.is_ok && r.data.app_consent == true && r.data.os_permission == "granted" {
            ui.recognition_cam.start()
        } else { recognition_failed("摄像头未获授权") }
        return
    }
    if envelope.action == "import" && recognition_phase == "import" {
        if !r.is_ok {
            if ("" + r.error).search("foreground_required") >= 0 {
                recognition_phase = "choose"
                message = "系统文件选择框尚未把焦点还给冰箱管家。请先点击本窗口，再选择已有图片。"
                redraw() return
            }
            recognition_failed("图片导入失败：" + r.error) return
        }
        if r.data.cancelled == true { cancel_recognition() return }
        recognize_image(r.data.path) return
    }
    if envelope.action != "model" || recognition_phase != "model" { return }
    if !r.is_ok { recognition_failed("图片识别不可用：" + r.error) return }
    if r.data == nil || !r.data.is_object() { recognition_failed("识别结果格式无效") return }
    let output = r.data.output
    if output == nil || !output.is_object() { recognition_failed("识别结果格式无效") return }
    let items = output.items
    if items == nil || !items.is_array() || items.len() < 1 || items.len() > 30 {
        recognition_failed("识别结果格式无效") return
    }
    let rows = []
    for item in items {
        if item == nil || !item.is_object() { recognition_failed("识别结果格式无效") return }
        let row = {row_id: rows.len() + 1 selected: true name: draft_text(item.name)
            quantity_text: draft_text(item.quantity_text) unit: recognized_unit(item.unit)
            package_size_text: draft_text(item.package_size_text)
            package_size_unit: recognized_package_size_unit(item.package_size_unit)
            average_item_grams_text: draft_text(item.average_item_grams_text)
            remaining_days_text: draft_text(item.remaining_days_text) printed_expires_on: draft_text(item.printed_expires_on)
            kcal_text: draft_text(item.kcal_text) protein_text: draft_text(item.protein_text)
            fiber_text: draft_text(item.fiber_text) vitamin_c_text: draft_text(item.vitamin_c_text)}
        rows.push(row)
    }
    if rows.len() == 0 { recognition_failed("图片中没有可核对的食材") return }
    intake_draft = {draft_id: "image-" + time_now() mode: recognition_mode image_path: recognition_image
        rows: rows busy: false error: ""}
    recognition_sequence = recognition_sequence + 1
    recognition_phase = "" recognition_deadline = 0
    message = "图片识别得到 " + rows.len() + " 行草稿；请补全不确定的字段，确认后才会入库。"
    redraw()
}
fn remove_draft_row(id){
    if intake_draft == nil { return }
    let kept = []
    for row in intake_draft.rows { if row.row_id != id { kept.push(row) } }
    intake_draft.rows = kept
    if kept.len() == 0 { intake_draft = nil }
    redraw()
}
fn reset_manual_form(){
    draft_name = "" draft_grams = "" draft_unit = "g" draft_days = "" draft_date = ""
    draft_package_size = "" draft_package_unit = "" draft_average = ""
    clear_nutrition_draft()
}
fn draft_issue(row){
    let name = row.name.trim()
    if name == "" || name.len() > 40 { return "食材名称需为 1–40 字。" }
    let quantity = row.quantity_text.trim().to_f64()
    if !(quantity > 0) || quantity > 100000 { return "数量需为大于 0 的有效数字。" }
    if row.unit == "" { return "请选择页面提供的单位，并核对数量。" }
    if canonical_unit(row.unit) == "" && !package_unit(row.unit) {
        return "不支持单位“" + row.unit + "”；请选择页面提供的单位，并核对数量。"
    }
    if row.remaining_days_text.trim() != "" && row.printed_expires_on.trim() != "" {
        return "剩余天数和印刷日期只能填一个，或都留空。"
    }
    let nutrient_count = 0
    for value in [row.kcal_text row.protein_text row.fiber_text row.vitamin_c_text] {
        if value.trim() != "" { nutrient_count = nutrient_count + 1 }
    }
    if nutrient_count > 0 && nutrient_count < 4 { return "营养四项需要全部填写，或全部留空。" }
    "请核对数量、包装、日期和营养值。"
}
fn draft_rejected(reason){
    message = reason
    intake_draft.error = reason
    ui.draft_error.set_text(reason)
}
fn confirm_intake(){
    if intake_draft == nil || intake_draft.busy { return }
    intake_draft.error = ""
    ui.draft_error.set_text("")
    let batches = []
    for row in intake_draft.rows {
        if row.selected {
            let batch = draft_batch(row)
            if batch == nil {
                draft_rejected("第 " + row.row_id + " 行（" + row.name + "）：" + draft_issue(row))
                return
            }
            batches.push(batch)
        }
    }
    if batches.len() == 0 { draft_rejected("请至少勾选一行有效食材。") return }
    if editing_id > 0 && batches.len() != 1 { draft_rejected("编辑时只能确认当前批次。") return }
    let operation = {operation_id: "pantry-local-" + state.next_operation_id type: "add" batches: batches}
    if editing_id > 0 { operation.type = "edit" operation.batch_id = editing_id operation.batch = batches[0] }
    if !apply_inventory_operation(operation, nil) { draft_rejected(message) return }
    intake_draft = nil editing_id = 0 reset_manual_form()
    message = "已确认入库。旧方案需要重新校验；需要新方案时，请回首页点击生成这一餐。"
    if state.auto_generate && !state.paused && state.profile.done { plan("库存变化") }
    redraw()
}
fn edit_food(id){
    for f in state.foods {
        if f.id == id {
            editing_id = id draft_name = f.name draft_grams = "" + f.quantity draft_unit = f.unit
            draft_package_size = "" draft_package_unit = f.package_size_unit draft_average = ""
            if f.package_size > 0 { draft_package_size = "" + f.package_size }
            if f.average_item_grams > 0 { draft_average = "" + f.average_item_grams }
            draft_days = "" draft_date = ""
            if f.expiry_precision == "estimated" { draft_days = "" + remaining(f) }
            if f.expiry_precision == "exact" { draft_date = calendar_text(f.expires_on_day) }
            clear_nutrition_draft()
            if f.to_json().search("nutrition") >= 0 {
                show_nutrition_input = true
                draft_kcal = "" + f.nutrition.kcal draft_protein = "" + f.nutrition.protein
                draft_fiber = "" + f.nutrition.fiber draft_vitamin_c = "" + f.nutrition.vitamin_c
            }
            intake_draft = nil removal = nil message = "修改后先预览，再确认保存；现有方案会重新校验。"
        }
    }
    redraw()
}
fn cancel_edit(){ editing_id = 0 intake_draft = nil removal = nil reset_manual_form() message = "已取消修改。" redraw() }
fn request_remove(id){
    for f in state.foods { if f.id == id { removal = f } }
    intake_draft = nil message = "请确认移除这批食材。此操作不会计入已食用进度。" redraw()
}
fn confirm_remove(){
    if removal == nil { return }
    let operation = {operation_id: "pantry-local-" + state.next_operation_id type: "discard" batch_id: removal.id}
    if !apply_inventory_operation(operation, nil) { redraw() return }
    removal = nil editing_id = 0 reset_manual_form()
    message = "已移除，旧方案已重新校验。"
    if state.auto_generate && !state.paused { plan("库存移除") }
    redraw()
}
fn choose_plan(){
    if selected >= 0 && selected < state.plans.len() { return state.plans[selected] }
    nil
}
fn active_plan(){
    for p in state.plans { if p.id == state.active && p.accepted && !p.consumed { return p } }
    nil
}
fn validate(p){
    if p == nil || p.consumed || p.revision != state.revision || p.profile_revision != state.profile_revision || p.uses.len() == 0 { return false }
    let totals = {}
    for u in p.uses {
        let amount = use_quantity(u)
        let unit = use_unit(u)
        if !(amount > 0) || !(u.grams >= 0) || (plan_numeric(p) && !(u.grams > 0)) { return false }
        let found = false
        let total = amount
        for k v in totals { if k == "" + u.food_id { total = total + v } }
        totals["" + u.food_id] = total
        for f in state.foods {
            if f.id == u.food_id && unit == f.canonical_unit && total <= f.canonical_quantity {
                if plan_numeric(p) && plan_eligible(f) {
                    if unit == "g" && amount == u.grams { found = true }
                    if unit == "piece" && amount == floor(amount) &&
                        abs(u.grams - amount * f.average_item_grams) < .01 { found = true }
                }
                if !plan_numeric(p) && recipe_eligible(f) {
                    if unit == "g" && amount == u.grams { found = true }
                    if unit == "ml" && u.grams == 0 { found = true }
                    if unit == "piece" && amount == floor(amount) && u.grams == 0 { found = true }
                }
            }
        }
        if !found { return false }
    }
    true
}
fn recipe_rule_plan(reason){
    let picked = []
    let used = {}
    for step in 3 {
        let best = nil
        for f in state.foods {
            let seen = false
            for k v in used { if k == "" + f.id { seen = true } }
            if recipe_eligible(f) && !seen && (best == nil ||
                (nutrient_reference(f.name, f.id).known && !nutrient_reference(best.name, best.id).known) ||
                (nutrient_reference(f.name, f.id).known == nutrient_reference(best.name, best.id).known && expiry_order(f) < expiry_order(best))) { best = f }
        }
        if best != nil {
            picked.push(recipe_use(best, min(best.canonical_quantity, 150)))
            used["" + best.id] = true
        }
    }
    if picked.len() == 0 { message = "没有可规划的库存：请核对过期、忌口及按件食材的数量；包装食材需补充每包装数量。" return }
    let p = {id: state.next_id title: picked[0].name + "简餐" uses: picked accepted: false consumed: false numeric: false
        revision: state.revision profile_revision: state.profile_revision created: time_now() reason: reason + " · 营养参考缺失，仅提供做法与库存用量" goal: goal
        source: "本地规则 · 营养未核算" previous: "" minutes: 20
        steps: "1. 核对每种食材的新鲜度，保质期未知的食材请先自行确认。\n2. 按清单取用并清洗；根据食材种类选择适当做法。\n3. 充分处理需要加热的食材，完成后核对实际用量。"}
    let previous = active_plan()
    if previous != nil { p.previous = previous.title }
    if !plan_ready(p) { message = "库存用量校验未通过，未创建候选。" return }
    let before = state.to_json()
    if state.plans.len() >= 20 { state.plans.remove(0) }
    state.plans.push(p) state.next_id = state.next_id + 1
    record(reason + " → 本地规则 → 创建未核算营养的候选 #" + p.id)
    if !commit(before) { return }
    selected = state.plans.len() - 1
    message = "已创建菜谱候选。营养参考缺失，热量和周期营养无法核算；接受前请核对食材状态。"
}
fn rule_plan(reason){
    if state.paused { message = "管家已暂停，请在设置里恢复。" return }
    let program = active_program()
    if program == nil || program_remaining_daily(program) <= 0 {
        message = "本周期未启用、已结束，或今天热量额度已用完。请查看周期数据盘。" return
    }
    let picked = []
    let used = {}
    // Earliest expiry remains the primary signal; known nutrients help fill
    // the active cycle's protein and vitamin C gap without changing its cap.
    for step in 3 {
        let best = nil
        let best_score = 100000
        for f in state.foods {
            let seen = false
            for k v in used { if k == "" + f.id { seen = true } }
            if auto_plan_eligible(f) && !seen && nutrient_reference(f.name, f.id).known {
                let n = nutrient_reference(f.name, f.id)
                let score = expiry_order(f) * 10
                if program.consumed_protein < program.protein_goal && n.protein >= 8 { score = score - 8 }
                if program.consumed_fiber < program.fiber_goal && n.fiber >= 2 { score = score - 5 }
                if program.consumed_vitamin_c < program.vitamin_c_goal && n.vitamin_c >= 10 { score = score - 5 }
                if best == nil || score < best_score { best = f best_score = score }
            }
        }
        if best != nil {
            picked.push(plan_use(best, min(batch_grams(best), 150)))
            used["" + best.id] = true
        }
    }
    if picked.len() == 0 { recipe_rule_plan(reason) return }
    let estimate = meal_nutrients(picked)
    if estimate.kcal > program_remaining_daily(program) {
        let budget = program_remaining_daily(program)
        for u in picked { revise_plan_use(u, u.grams * budget / estimate.kcal) }
    }
    if !numeric_budget_ok(picked) { message = "剩余热量额度不足以安排这组食材；未创建候选。" return }
    let title = "清冰箱家常餐"
    let names = ""
    let tofu = false
    let spinach = false
    let egg = false
    for u in picked {
        if names != "" { names = names + "、" }
        names = names + u.name
        if u.name.search("豆腐") >= 0 { tofu = true }
        if u.name.search("菠菜") >= 0 { spinach = true }
        if u.name.search("蛋") >= 0 { egg = true }
    }
    if tofu { title = "香煎豆腐配时蔬" }
    else { if spinach && egg { title = "菠菜鸡蛋饼" } else { title = picked[0].name + "家常餐" } }
    let p = {id: state.next_id title: title uses: picked accepted: false consumed: false
        revision: state.revision profile_revision: state.profile_revision created: time_now() reason: reason + " · " + goal goal: goal
        source: "离线规则规划" previous: "" minutes: 20
        steps: "1. 核对食材状态，按清单称重。\n2. 蔬菜洗净切段，豆腐切块；鸡蛋若使用则打散。\n3. 有豆腐先少油煎至两面金黄；其余食材分别炒熟。\n4. 合适食材搭配出餐。按个人饮食需求调整调味。"}
    let previous = active_plan()
    if previous != nil { p.previous = previous.title }
    if !validate(p) || !numeric_budget_ok(p.uses) { message = "方案未通过库存或周期热量校验，库存没有变化。" return }
    let before = state.to_json()
    if state.plans.len() >= 20 { state.plans.remove(0) }
    state.plans.push(p)
    state.next_id = state.next_id + 1
    record(reason + " → 读取库存 → 按到期排序 → 用量校验 → 创建候选 #" + p.id)
    if !commit(before) { return }
    selected = state.plans.len() - 1
    message = "新候选已准备好，接受后才会替换今晚方案。"
}
fn read_ai_config(){
    if ai_busy || voice_phase != 0 { message = "请等待当前在线操作结束，再重新读取配置。" redraw() return }
    probe_sequence = probe_sequence + 1
    let token = probe_sequence
    ai_phase = 0 ai_error = ""
    config_deadline = time_now() + 10
    redraw()
    try {
        host_request_id = host.request("model.budget", {}, |r| config_received(token, r))
    } catch {
        probe_sequence = probe_sequence + 1 ai_phase = 3
        ai_error = "AI 宿主通信未启动，请重新读取配置。"
        message = ai_error redraw()
    }
}
fn config_received(token, r){
    config_reply = {token: token reply: r}
}
fn apply_config_reply(envelope){
        if ai_phase != 0 || envelope.token != probe_sequence { return }
        let r = envelope.reply
        probe_sequence = probe_sequence + 1
        if r.is_ok {
            ai_phase = 1
            // Official model.budget reports usage, not provider configuration.
            // A successful budget query does not prove a provider is configured.
            ai_model = "由宿主管理"
            if r.data.calls_today != nil { ai_calls = r.data.calls_today }
        } else {
            let error = "" + r.error
            ai_phase = 3 ai_error = error
            if error.search("no service answers") >= 0 || error.search("not granted") >= 0 || error.search("capability") >= 0 {
                ai_phase = 4 ai_error = "当前宿主未提供模型服务，已使用本地规则。"
            }
        }
        if ai_phase == 2 { message = "请在 OctoSense 的 AI 提供方设置中配置模型，当前使用本地规则。" }
        if ai_phase == 3 { message = ai_error }
        if ai_phase == 4 { message = ai_error }
        redraw()
        check_risk()
}
fn ai_watchdog(){
    // Host callbacks deliver data; a single timer applies responses and
    // deadlines through the usual UI event path.
    if config_reply != nil {
        let received = config_reply config_reply = nil
        apply_config_reply(received)
    }
    if model_reply != nil {
        let received = model_reply model_reply = nil
        apply_model_reply(received)
    }
    if vision_reply != nil {
        let received = vision_reply vision_reply = nil
        if received.token == vision_sequence {
            vision_phase = 2
            if received.reply.is_ok && received.reply.data.schema == 1 && received.reply.data.supported == true { vision_phase = 1 }
        }
    }
    if recognition_reply != nil {
        let received = recognition_reply recognition_reply = nil
        apply_recognition_reply(received)
    }
    if recognition_phase == "model" && recognition_deadline > 0 && time_now() >= recognition_deadline {
        recognition_failed("图片识别超时")
    }
    if voice_reply != nil {
        let received = voice_reply voice_reply = nil
        apply_voice_reply(received)
    }
    if ai_phase == 0 && config_deadline > 0 && time_now() >= config_deadline {
        probe_sequence = probe_sequence + 1 ai_phase = 3
        ai_error = "读取 AI 配置超时，请在设置里重新读取。"
        message = ai_error redraw()
    }
    if ai_busy && time_now() >= model_deadline {
        stop_ai()
        ai_failure("AI 生成超时，已停止等待。迟到的结果不会写入，可稍后重试。")
    }
    if voice_phase == 1 && time_now() >= voice_deadline {
        voice_sequence = voice_sequence + 1 voice_phase = 0 voice_deadline = 0
        message = "打开麦克风超时，请检查宿主与系统权限。" redraw()
    }
    if voice_phase == 2 && time_now() >= voice_deadline { stop_voice() }
    if voice_phase == 3 && time_now() >= voice_deadline {
        voice_sequence = voice_sequence + 1 voice_phase = 0 voice_deadline = 0
        message = "语音识别超时，迟到的结果不会填入。请检查网络后重试。" redraw()
    }
}
fn voice_received(token, action, r){ voice_reply = {token: token action: action reply: r} }
fn apply_voice_reply(envelope){
    if envelope.token != voice_sequence { return }
    let r = envelope.reply
    if envelope.action == "start" {
        if !r.is_ok {
            voice_phase = 0 message = "语音输入启动失败：" + r.error
        } else {
            voice_phase = 2 voice_deadline = time_now() + 18
            message = "正在听，请说出这一餐想吃什么；说完后再点一次麦克风。"
        }
        redraw() return
    }
    voice_phase = 0 voice_deadline = 0
    if !r.is_ok {
        message = "语音识别失败：" + r.error
    } else {
        goal = ("" + r.data.text).trim()
        if goal == "" { message = "没有识别到清晰内容，请重新录音。" }
        if goal != "" { message = "语音已填入，请确认文字后再生成方案。" }
    }
    redraw()
}
fn toggle_voice(){
    message = "官方宿主尚未提供本应用所需的语音识别服务，请直接输入文字。"
    redraw()
}
fn stop_voice(){
    voice_phase = 0 voice_deadline = 0
}
fn stop_ai(){
    ai_sequence = ai_sequence + 1
    ai_busy = false
}
fn cancel_ai(){ stop_ai() message = "已停止等待，库存未变化。后台请求可能仍会计费，请稍候再生成。" redraw() }
fn automatic_reason(reason){
    reason == "库存变化" || reason == "库存移除" || reason == "用餐后再规划" || reason.search("临期提醒：") == 0
}
fn toggle_auto_generation(){
    if pending || plan_removal != nil { message = "请先完成或取消当前确认。" redraw() return }
    let before = state.to_json()
    state.auto_generate = !state.auto_generate
    record("自动生成候选：" + state.auto_generate)
    if commit(before) {
        message = "已关闭自动生成。库存变化和临期只更新或提醒；请手动生成新方案。"
        if state.auto_generate { message = "已开启自动生成。之后库存变化、临期和用餐确认可创建候选，仍需你接受。" }
        if !state.auto_generate && ai_busy && automatic_reason(ai_snapshot.reason) {
            stop_ai()
            message = "已关闭自动生成并忽略正在等待的自动结果；已发出的请求可能仍会计费。"
        }
    }
    redraw()
}
fn toggle_model(){
    if ai_busy { message = "请先等待生成完成或停止等待。" redraw() return }
    let before = state.to_json()
    state.model_enabled = !use_ai
    record("用户切换在线 AI：" + state.model_enabled)
    if commit(before) {
        use_ai = !use_ai ai_error = ""
        message = "已切换为本地规则，菜单会标注来源。"
        if use_ai { message = "已启用在线 AI，正在读取配置。" read_ai_config() }
    }
    redraw()
}
fn ai_failure(text){
    ai_busy = false ai_error = text message = text
    if text.search("no_provider") >= 0 {
        ai_phase = 2
        message = "宿主未配置可用模型，请到 OctoSense 的 AI 提供方设置配置。当前使用本地规则，可重新生成。"
    }
    if text.search("no service answers") >= 0 || text.search("not granted") >= 0 {
        ai_phase = 4
        message = "当前宿主未提供模型服务，已使用本地规则，可重新生成。"
    }
    let before = state.to_json()
    record("AI 规划未完成；库存和正式方案保留，请重试或切换本地规则")
    commit(before)
    redraw()
}
fn recipe_display_text(text){
    text.replace(regex("库存全部\\s*nutrition_known\\s*=\\s*false", "gi"), "库存食材都缺少营养参考")
        .replace(regex("nutrition_known\\s*=\\s*false", "gi"), "营养参考不完整")
        .replace(regex("nutrition_known\\s*=\\s*true", "gi"), "有营养参考")
        .replace(regex("[ \\t]*food_id[ \\t]*[:=]?[ \\t]*\\d+[ \\t]*", "gi"), "相应批次")
        .replace(regex("[ \\t]*(unknown expiry|expiry_unknown)[ \\t]*", "gi"), "保质期未知")
        .replace(regex("[ \\t]*profile[ \\t]*", "gi"), "饮食档案")
}
fn save_ai_result(output, reason, requested_goal){
    try {
        if output.reason.len() == 0 || output.reason.len() > 1200 { return false }
        if output.feasible != true {
            ai_error = "这次要求无法满足：" + recipe_display_text(output.reason)
            message = ai_error
            return true
        }
        if output.title.len() == 0 || output.title.len() > 240 || output.uses.len() == 0 || output.uses.len() > 6 { return false }
        if !(output.minutes >= 1) || output.minutes > 120 || output.minutes != floor(output.minutes) { return false }
        if output.steps.len() < 2 || output.steps.len() > 8 { return false }
        let uses = []
        for u in output.uses {
            let planned = nil
            if ai_snapshot.recipe_only {
                if !(u.quantity > 0) || u.quantity != floor(u.quantity) { return false }
                for f in state.foods {
                    if f.id == u.food_id && u.quantity <= f.canonical_quantity { planned = recipe_use(f, u.quantity) }
                }
            } else {
                if !(u.grams > 0) || u.grams != floor(u.grams) { return false }
                for f in state.foods {
                    if f.id == u.food_id && u.grams <= batch_grams(f) { planned = plan_use(f, u.grams) }
                }
            }
            if planned == nil { return false }
            uses.push(planned)
        }
        let steps = ""
        for i in output.steps.len() {
            let text = output.steps[i].trim()
            if text.len() == 0 || text.len() > 600 { return false }
            if steps != "" { steps = steps + "\n" }
            steps = steps + (i + 1) + ". " + recipe_display_text(text)
        }
        let p = {id: state.next_id title: recipe_display_text(output.title) uses: uses accepted: false consumed: false
            revision: state.revision profile_revision: state.profile_revision created: time_now() reason: recipe_display_text(output.reason) goal: requested_goal
            source: "在线 AI" previous: "" minutes: output.minutes steps: steps}
        if ai_snapshot.recipe_only { p.numeric = false p.source = "在线 AI · 营养未核算" }
        let previous = active_plan()
        if previous != nil { p.previous = previous.title }
        if !plan_ready(p) { return false }
        let before = state.to_json()
        if state.plans.len() >= 20 { state.plans.remove(0) }
        state.plans.push(p) state.next_id = state.next_id + 1
        record(reason + " → 在线 AI → JSON 与库存用量校验 → 创建候选 #" + p.id)
        if !commit(before) { return true }
        selected = state.plans.len() - 1
        ai_error = ""
        message = "AI 候选已通过库存校验。接受后才会替换今晚方案。"
        if ai_snapshot.recipe_only { message = "AI 菜谱已生成；热量与营养无法核算。接受前请核对食材状态。" }
        true
    } catch { false }
}
fn online_plan(reason){
    if ai_busy { message = "正在生成，请稍候。库存若变化，旧结果会自动作废。" return }
    if goal.len() > 1500 { message = "目标太长，请缩短至约 500 字以内。" return }
    let program = active_program()
    if program == nil || program_remaining_daily(program) <= 0 { message = "没有有效的周期方案或今日额度不足。" return }
    let inventory = []
    for f in state.foods {
        let nutrient = nutrient_reference(f.name, f.id)
        if auto_plan_eligible(f) && nutrient.known {
            let entry = {food_id: f.id name: f.name grams: batch_grams(f)
                quantity: f.canonical_quantity unit: f.canonical_unit average_item_grams: f.average_item_grams
                remaining_days: remaining(f) expiry_unknown: f.expires_on_day == 0 expires_on_day: f.expires_on_day
                kcal_per_100g: nutrient.kcal protein_per_100g: nutrient.protein
                fiber_per_100g: nutrient.fiber vitamin_c_per_100g: nutrient.vitamin_c}
            let ordered = []
            let inserted = false
            for previous in inventory {
                if !inserted && (previous.expiry_unknown ||
                    (!entry.expiry_unknown && entry.expires_on_day < previous.expires_on_day)) {
                    ordered.push(entry) inserted = true
                }
                ordered.push(previous)
            }
            if !inserted { ordered.push(entry) }
            inventory = ordered
        }
    }
    let recipe_only = inventory.len() == 0
    if recipe_only {
        for f in state.foods {
            if recipe_eligible(f) {
                inventory.push({food_id: f.id name: f.name quantity: f.canonical_quantity unit: f.canonical_unit
                    nutrition_known: nutrient_reference(f.name, f.id).known
                    expiry_unknown: f.expires_on_day == 0 expires_on_day: f.expires_on_day})
            }
        }
    }
    if inventory.len() == 0 { message = "没有可规划的库存：请核对过期、忌口及按件食材的数量；包装食材需补充每包装数量。" return }
    let previous_title = ""
    let previous = active_plan()
    if previous != nil { previous_title = previous.title }
    let schema = {type: "object" additionalProperties: false
        required: ["feasible" "title" "minutes" "reason" "uses" "steps"]
        properties: {
            feasible: {type: "boolean"}
            title: {type: "string" minLength: 1 maxLength: 80}
            minutes: {type: "integer" minimum: 1 maximum: 120}
            reason: {type: "string" minLength: 1 maxLength: 400}
            uses: {type: "array" minItems: 0 maxItems: 6 items: {type: "object" additionalProperties: false
                required: ["food_id" "grams"] properties: {food_id: {type: "integer" minimum: 1}
                    grams: {type: "integer" minimum: 1 maximum: 100000}}}}
            steps: {type: "array" minItems: 0 maxItems: 8 items: {type: "string" minLength: 1 maxLength: 200}}
        }}
    if recipe_only {
        schema.properties.uses = {type: "array" minItems: 0 maxItems: 6 items: {type: "object" additionalProperties: false
            required: ["food_id" "quantity"] properties: {food_id: {type: "integer" minimum: 1}
                quantity: {type: "integer" minimum: 1 maximum: 100000}}}}
    }
    let task = "你是一名家常菜冰箱管家。用中文安排一顿可执行的餐食，结合用户当餐 goal、已选周期 program、剩余 daily_kcal 和周期营养缺口 nutrition_remaining，优先用掉临期批次。蛋白质、纤维和维生素 C 是周期累计目标，优先选择能填补缺口的食材；不要假装每餐必须凑齐整个周期目标。方向 profile.scene 不是执行方案。只使用 input.inventory 中食材，food_id 必须来自库存，用量不可超库存；营养参考未知的食材不得纳入候选。能量参考不得超过每日剩余额度，最终会由本地校验，不得编造营养数值。熟食充分加热；profile.allergies 和 profile.avoidances 必须遵守，profile.preferences 只作偏好。烹饪用油、饮料等须在实际用餐核对时另记。不能承诺过敏安全。可满足时 feasible=true，steps 2–8 项；不能满足时 feasible=false 并说明原因。title、reason、steps 必须写成用户能看懂的中文，不得包含 JSON 字段名、布尔值、内部编号或英文状态。只输出 JSON。"
    if recipe_only {
        task = "你是一名家常菜冰箱管家。用中文根据 input.inventory 的真实食材安排一顿可执行的餐食。只能使用库存给出的 food_id，uses 中 quantity 使用对应 unit 的原生数量，不能超过库存，也不能添加不存在的食材。优先选 nutrition_known=true 的食材，再考虑已知到期时间较近的食材；保质期未知时在做法中提醒用户先检查新鲜度。营养参考不足以完成整餐核算，不能估算、声称或编造热量、蛋白质、纤维、维生素 C 或周期目标达成情况。遵守 profile.allergies 和 profile.avoidances，熟食充分加热。可满足时 feasible=true，steps 2–8 项；不能满足时 feasible=false 并说明原因。title、reason、steps 必须写成用户能看懂的中文，不得包含 JSON 字段名、布尔值、内部编号或英文状态。只输出 JSON。"
    }
    let requested_goal = goal
    let model_input = {goal: requested_goal profile: state.profile inventory: inventory
        previous_menu: previous_title trigger: reason demo: state.demo}
    if !recipe_only {
        model_input.program = program
        model_input.daily_kcal_remaining = program_remaining_daily(program)
        model_input.nutrition_remaining = {protein_g: max(0, program.protein_goal - program.consumed_protein)
            fiber_g: max(0, program.fiber_goal - program.consumed_fiber)
            vitamin_c_mg: max(0, program.vitamin_c_goal - program.consumed_vitamin_c)}
        model_input.health = state.health
    }
    let revision = state.revision
    let offset = state.offset
    ai_sequence = ai_sequence + 1
    let token = ai_sequence
    ai_snapshot = {revision: revision profile_revision: state.profile_revision offset: offset goal: requested_goal reason: reason recipe_only: recipe_only
        program_id: program.id consumed_kcal: program.consumed_kcal}
    model_deadline = time_now() + 95
    ai_busy = true ai_error = "" retry_reason = reason
    message = "正在根据目标与真实库存安排菜单，通常需要几秒到一分钟。"
    redraw()
    host_request_id = host.request("model.complete", {
        task: task
        input: model_input
        schema: schema class: "fast"
    }, |r| model_received(token, r))
}
fn model_received(token, r){
    model_reply = {token: token reply: r}
}
fn apply_model_reply(envelope){
        if envelope.token != ai_sequence || !ai_busy { return }
        let r = envelope.reply
        ai_busy = false ai_sequence = ai_sequence + 1
        let current = active_program()
        if (!state.auto_generate && automatic_reason(ai_snapshot.reason)) || plan_removal != nil || current == nil || current.id != ai_snapshot.program_id || current.consumed_kcal != ai_snapshot.consumed_kcal || state.revision != ai_snapshot.revision || state.profile_revision != ai_snapshot.profile_revision || state.offset != ai_snapshot.offset || goal != ai_snapshot.goal || state.paused || !use_ai || pending {
            ai_error = "等待期间库存、目标或运行状态变化，已丢弃旧结果。请重新生成。"
            message = ai_error redraw() return
        }
        if !r.is_ok { ai_failure("" + r.error) return }
        if !save_ai_result(r.data.output, ai_snapshot.reason, ai_snapshot.goal) {
            ai_failure("AI 菜单未通过格式、到期或用量校验，未替换方案。请重试。") return
        }
        ai_calls = ai_calls + 1
        redraw()
}
fn plan(reason){
    if !state.auto_generate && automatic_reason(reason) { return }
    if storage_blocked { message = "库存文件异常，已停止生成和写入。请先备份修复。" return }
    if state.paused { message = "管家已暂停，请在设置里恢复。" return }
    if pending || plan_removal != nil { message = "请先完成或取消当前确认。" return }
    if active_program() == nil || program_remaining_daily(active_program()) <= 0 { message = "请先确认有效周期方案，或查看今日额度与周期进度。" return }
    if use_ai && ai_phase == 0 { message = "正在读取 AI 配置，请稍候。" return }
    if use_ai && ai_phase == 3 { message = ai_error return }
    if use_ai && ai_phase == 1 { online_plan(reason) return }
    rule_plan(reason)
}
fn retry_ai(){ plan("用户请求重试") redraw() }
fn generate(){
    if ai_busy { message = "方案正在生成，请稍候或停止等待。" redraw() return }
    if voice_phase != 0 { message = "请先结束语音输入并确认识别文字。" redraw() return }
    goal = ui.request.text().trim()
    if goal == "" { goal = "优先吃掉快过期的食材" }
    plan("用户请求") tab = 2 details = false redraw()
}
fn accept(){
    let p = choose_plan()
    if !plan_ready(p) { message = "库存或周期状态已变化，请重新生成方案。" redraw() return }
    let before = state.to_json()
    p.accepted = true
    state.active = p.id
    record("接受方案 #" + p.id + "：" + p.title)
    if commit(before) { message = "已设为今晚方案，做完后点击“我吃完了”。" }
    redraw()
}
fn begin_consume(){
    let p = choose_plan()
    if p == nil || !p.accepted || p.id != state.active || !validate(p) { message = "只能扣减当前已接受且有效的方案。" redraw() return }
    pending = true message = "请核对实际食用数量。最后一次确认后才会扣减。" redraw()
}
fn revise_amount(index, text){
    let amount = text.trim().to_f64()
    let item = consumption[index]
    item.quantity = amount
    if !plan_numeric(choose_plan()) {
        item.grams = 0
        if use_unit(item) == "g" { item.grams = amount }
    } else { if use_unit(item) == "piece" {
        for food in state.foods { if food.id == item.food_id { item.grams = amount * food.average_item_grams } }
    } else { item.grams = amount } }
    if amount > 0 && (use_unit(item) != "piece" || amount == floor(amount)) {
        message = "已修改实际用量。确认后才会扣减库存。" ui.notice.set_text(message)
    }
}
fn cycle_consume_batch(index){
    if !pending { return }
    let current = consumption[index]
    let options = []
    for food in state.foods {
        if food.name == current.name && food.canonical_unit == use_unit(current) &&
            ((plan_numeric(choose_plan()) && plan_eligible(food)) || (!plan_numeric(choose_plan()) && recipe_eligible(food))) {
            let ordered = []
            let inserted = false
            for earlier in options {
                if !inserted && expiry_order(food) < expiry_order(earlier) { ordered.push(food) inserted = true }
                ordered.push(earlier)
            }
            if !inserted { ordered.push(food) }
            options = ordered
        }
    }
    if options.len() < 2 { message = "没有其他可选的同名兼容批次。" redraw() return }
    let position = -1
    for i in options.len() { if options[i].id == current.food_id { position = i } }
    let next = options[(position + 1) % options.len()]
    let revised = nil
    if plan_numeric(choose_plan()) { revised = plan_use(next, current.grams) }
    else { revised = recipe_use(next, current.quantity) }
    if revised == nil { return }
    current.food_id = revised.food_id current.quantity = revised.quantity
    current.unit = revised.unit current.grams = revised.grams
    message = "已改用同名食材的第 " + batch_ordinal(next.id) + " 批；请核对数量后再确认。"
    redraw()
}
let consumption = []
fn prepare_consume(){
    let p = choose_plan()
    if p == nil { return }
    consumption = p.uses.to_json().parse_json()
    begin_consume()
}
fn confirm_consume(){
    if !pending { return }
    let p = choose_plan()
    if p == nil || p.id != state.active || !p.accepted || !validate(p) { pending = false message = "方案已失效，未扣减库存。" redraw() return }
    let revised = p.to_json().parse_json()
    revised.uses = consumption
    if !validate(revised) { message = "用量需为正整数，不能超出库存；请修改或取消。" ui.notice.set_text(message) return }
    if !plan_numeric(p) {
        let program = active_program()
        if program == nil || program_remaining_daily(program) <= 0 {
            message = "周期方案已结束或今日额度已用完，未扣库存。" ui.notice.set_text(message) return
        }
        let before = state.to_json()
        p.uses = revised.uses p.consumed = true
        ensure_extended_state()
        program.intake.push({at: now() day: health_day() title: p.title kcal: 0 nutrition_known: false
            protein: 0 fiber: 0 vitamin_c: 0 extra_kcal: 0})
        state.meal_count = state.meal_count + 1
        state.last_meal = p.title state.last_goal = p.goal
        record_health_meal(revised.uses, false)
        state.active = 0
        record("确认食用 #" + p.id + "：营养未核算；库存已扣减")
        let uses = []
        for u in revised.uses { uses.push({food_id: u.food_id quantity: use_quantity(u) unit: use_unit(u)}) }
        let operation = {operation_id: "pantry-local-" + state.next_operation_id type: "consume" uses: uses}
        if !apply_inventory_operation(operation, before) { redraw() return }
        pending = false details = false extra_kcal_text = "0"
        message = "已记录用餐并扣减库存；本餐热量与营养未核算，不计入周期数值。"
        if state.auto_generate && !state.paused { plan("用餐后再规划") }
        redraw() return
    }
    let estimate = meal_nutrients(revised.uses)
    let extra = extra_kcal_text.trim().to_f64()
    let program = active_program()
    if !estimate.complete || estimate.kcal <= 0 || !(extra >= 0) || extra > 2000 || extra != floor(extra) {
        message = "营养参考缺失，或额外热量无效；未扣库存。请核对整餐与用油。"
        ui.notice.set_text(message) return
    }
    let calories = estimate.kcal + extra
    if program == nil || calories > program_remaining_daily(program) {
        message = "本餐约 " + calories + " kcal，超过方案今日剩余 " + program_remaining_daily(program) + " kcal。未扣库存，请调整用量。"
        ui.notice.set_text(message) return
    }
    let before = state.to_json()
    p.uses = revised.uses p.consumed = true p.recorded_kcal = calories
    ensure_extended_state()
    program.intake.push({at: now() day: health_day() title: p.title kcal: calories
        protein: estimate.protein fiber: estimate.fiber vitamin_c: estimate.vitamin_c extra_kcal: extra})
    program.consumed_kcal = program.consumed_kcal + calories
    program.consumed_protein = program.consumed_protein + estimate.protein
    program.consumed_fiber = program.consumed_fiber + estimate.fiber
    program.consumed_vitamin_c = program.consumed_vitamin_c + estimate.vitamin_c
    state.consumed_kcal = program_today_kcal(program)
    state.meal_count = state.meal_count + 1
    state.last_meal = p.title
    state.last_goal = p.goal
    record_health_meal(revised.uses, true)
    state.active = 0
    record("确认食用 #" + p.id + "：" + calories + " kcal，周期已用 " + program.consumed_kcal + " / " + program.kcal_goal + "；库存已扣减")
    let uses = []
    for u in revised.uses { uses.push({food_id: u.food_id quantity: use_quantity(u) unit: use_unit(u)}) }
    let operation = {operation_id: "pantry-local-" + state.next_operation_id type: "consume" uses: uses}
    if !apply_inventory_operation(operation, before) { redraw() return }
    pending = false details = false
    extra_kcal_text = "0"
    message = "已记录这顿饭：" + calories + " kcal；本周期还可记录 " + program_remaining_total(program) + " kcal。下一餐请回首页手动生成。"
    let next_before = state.next_id
    if state.auto_generate && !state.paused { plan("用餐后再规划") }
    if state.next_id > next_before { message = "已确认食用并更新库存。请查看下一餐候选。" }
    redraw()
}
fn cancel_consume(){ pending = false message = "已取消，库存没有变化。" redraw() }
fn step_history(delta){
    if pending || plan_removal != nil { return }
    selected = clamp(selected + delta, 0, state.plans.len() - 1)
    details = false redraw()
}
fn request_delete_plan(){
    if pending || ai_busy { message = "请先完成当前操作，再删除方案。" redraw() return }
    let p = choose_plan()
    if p == nil { return }
    plan_removal = {id: p.id title: p.title}
    message = "请确认删除；不会修改食材库存或已记录的用餐数据。"
    redraw()
}
fn cancel_delete_plan(){
    plan_removal = nil
    message = "已取消删除，方案和库存没有变化。"
    redraw()
}
fn confirm_delete_plan(){
    if plan_removal == nil { return }
    if pending || ai_busy { message = "当前操作未结束，暂不能删除方案。" redraw() return }
    let kept = []
    let found = false
    for p in state.plans {
        if p.id == plan_removal.id { found = true }
        else { kept.push(p) }
    }
    if !found { plan_removal = nil message = "这个方案已不在列表中。" redraw() return }
    let before = state.to_json()
    let was_active = state.active == plan_removal.id
    state.plans = kept
    if was_active { state.active = 0 }
    record("删除方案 #" + plan_removal.id + "：" + plan_removal.title + "（不改变库存或用餐记录）")
    if !commit(before) { redraw() return }
    selected = min(selected, state.plans.len() - 1)
    plan_removal = nil details = false
    message = "方案已删除，库存和用餐记录保持不变。"
    if was_active { message = "已删除并取消今晚方案，库存和用餐记录保持不变。" }
    redraw()
}
fn check_risk(){
    if onboarding_step != 4 { return }
    if !booted || storage_blocked || pending || plan_removal != nil || intake_draft != nil || editing_id > 0 || ai_busy || voice_phase != 0 || (use_ai && (ai_phase == 0 || ai_phase == 3)) { return }
    if now() - state.cycle_start >= 604800 {
        let before = state.to_json()
        state.cycle_start = now() state.handled = 0 state.baseline = risk_count()
        record("开始新的 7 天临期清零周期")
        commit(before)
    }
    if state.paused || !state.reminders || state.snooze > time_now() { return }
    let active = active_plan()
    let key = ""
    let names = ""
    for f in state.foods {
        if freshness(f) == "临期" && remaining(f) <= 1 {
            let covered = false
            if active != nil { for u in active.uses { if u.food_id == f.id { covered = true } } }
            if !covered { key = key + f.id + ":" names = names + f.name + " " }
        }
    }
    let invalid_active = active != nil && !validate(active)
    if invalid_active { key = "invalid:" + active.id + ":" + state.revision names = "当前菜单已失效" }
    if key == "" || key == state.risk_key { return }
    if state.plans.len() > 0 {
        let latest = state.plans[state.plans.len() - 1]
        if !invalid_active && !latest.accepted && !latest.consumed && validate(latest) { return }
    }
    let before = state.to_json()
    state.risk_key = key
    let notice = names + "将在 24 小时内到期，当前菜单没有覆盖。"
    if invalid_active { notice = "当前菜单已失效，库存或有效期已变化。" }
    record("主动检查：" + notice)
    if !commit(before) { redraw() return }
    if !state.auto_generate {
        message = notice + "请按需回首页手动生成；不会自动创建方案。"
        redraw() return
    }
    let next_before = state.next_id
    plan("临期提醒：" + names)
    if ai_busy { if tab != 1 { tab = 2 } redraw() return }
    if state.next_id == next_before { redraw() return }
    if tab != 1 { tab = 2 }
    message = names + "快到期了，已准备新候选；原方案保留到你接受。"
    if invalid_active { message = "正式菜单已失效，已准备新候选。请检查后接受。" }
    redraw()
}
fn snooze(){
    let before = state.to_json()
    state.snooze = time_now() + 1800
    record("用户选择稍后提醒：30 分钟")
    if commit(before) { message = "30 分钟内不再主动提醒，当前方案保留。" }
    redraw()
}
fn toggle_pause(){ let before = state.to_json() state.paused = !state.paused record("管家暂停状态：" + state.paused) if commit(before) { if state.paused && ai_busy { cancel_ai() } } redraw() }
fn toggle_reminders(){ let before = state.to_json() state.reminders = !state.reminders record("主动提醒：" + state.reminders) commit(before) redraw() }
fn fast_forward(){
    if !state.demo { message = "先载入演示数据，再使用时间快进。" redraw() return }
    let before = state.to_json()
    state.offset = state.offset + 43200 state.snooze = 0
    record("演示时间推进 12 小时；不修改系统时间")
    if !commit(before) { redraw() return }
    message = "演示已推进 12 小时，正在检查临期风险。"
    check_risk() redraw()
}
fn request_demo(){ reset_pending = true message = "演示会替换这个脚本版的库存和方案，请确认。" redraw() }
fn cancel_demo(){ reset_pending = false message = "已取消替换。" redraw() }
fn install_demo(){
    stop_ai()
    let before = state.to_json()
    if !state.demo {
        let result = fs.write("before-demo.json", before)
        if result != nil { message = "演示前备份失败，未替换库存。" redraw() return }
    }
    let today = time_now()
    state = {schema: 1 foods: [
        {id: 1 name: "菠菜" grams: 200 expires: today + 172800}
        {id: 2 name: "鸡蛋" grams: 100 expires: today + 518400}
        {id: 3 name: "豆腐" grams: 250 expires: today + 103680}
        {id: 4 name: "蘑菇" grams: 150 expires: today + 259200}]
        plans: [{id: 5 title: "菠菜鸡蛋饼" uses: [{food_id: 1 name: "菠菜" grams: 100} {food_id: 2 name: "鸡蛋" grams: 100}]
            accepted: true consumed: false revision: 1 created: today reason: "演示的原菜单" goal: "先安排晚饭"
            source: "明确标记的演示菜单" previous: "" minutes: 15 steps: "菠菜洗净切碎，与打散的鸡蛋拌匀，少油煎至熟透。"}]
        active: 5 next_id: 6 revision: 1 offset: 0 demo: true paused: false reminders: true snooze: 0 risk_key: ""
        handled: 0 baseline: 3 cycle_start: today log: [] model_enabled: use_ai auto_generate: state.auto_generate
        profile: {done: true scene: "日常健康" sex: "女性" age: "28" height: "165" weight: "55" avoid: "" diet: "清淡家常" special: "" activity: "轻活动" basics_done: true plan_approved: true}
        programs: [{id: 1 name: "7天均衡起步 · 演示" days: 7 daily_kcal: 2000 kcal_goal: 14000
            protein_goal: 308 fiber_goal: 196 vitamin_c_goal: 525 started: today
            consumed_kcal: 680 consumed_protein: 0 consumed_fiber: 0 consumed_vitamin_c: 0
            intake: [{at: today day: floor(today / 86400) title: "演示前一餐" kcal: 680 protein: 0 fiber: 0 vitamin_c: 0 extra_kcal: 0}]}]
        program_active: 1 program_next: 2 program_history: []
        health: {start: today day: floor(today / 86400) meals_per_day: 2 meals_week: 1 meals_today: 1
            protein_week: 0 fiber_week: 0 protein_goal: 308 fiber_goal: 175 calcium_goal: 7000 iron_goal: 126}
        daily_target: 2000 consumed_kcal: 680 meal_count: 1 last_meal: "番茄豆腐汤" last_goal: "清淡一点"}
    state = migrate_state(state)
    if !valid_state(state) { state = before.parse_json() message = "演示数据无效，未替换库存。" redraw() return }
    record("载入演示库存与原菜单；确认后才改写正式方案")
    if !commit(before) { redraw() return }
    selected = 0 intake_draft = nil pending = false plan_removal = nil reset_pending = false tab = 0 editing_id = 0 removal = nil
    message = "演示已就绪：去设置推进 12 小时，观察豆腐提醒与菜单重排。"
    redraw()
}
fn restore_before_demo(){
    if !fs.exists("before-demo.json") { message = "没有可恢复的演示前库存。" redraw() return }
    let previous = read_saved_state("before-demo.json")
    if previous == nil { message = "备份无法读取，未替换当前库存。" redraw() return }
    let before = state.to_json()
    stop_ai()
    state = previous
    ensure_extended_state()
    state.model_enabled = use_ai
    if commit(before) { selected = state.plans.len() - 1 message = "已恢复演示前的数据。" }
    redraw()
}

start_timeout(0.05, || load())
start_interval(60, || check_risk())
start_interval(0.5, || ai_watchdog())

width: Fill height: Fill
View{width: Fill height: Fill flow: Overlay
    Ambient{}
    SolidView{width: Fill height: Fill draw_bg.color: #xffffff18}
    View{width: Fill height: Fill padding: 0
        GlassCard{
            app_body := View{width: Fill height: Fill on_render: || {
                if recognition_phase != "" {
                    View{width: Fill height: Fill flow: Down align: Align{x: .5 y: .5} padding: 24
                        Frost{width: 720 height: Fit padding: 24 spacing: 14 new_batch: true
                            Heading{text: "图片识别" draw_text.text_style.font_size: 26}
                            Hint{text: "一次选择一张照片；结果仅生成可编辑草稿。"}
                            if recognition_phase == "choose" {
                                Hint{text: message}
                                View{width: Fill height: Fit flow: Right spacing: 10
                                    Action{text: "打开摄像头" on_click: || choose_camera()}
                                    Action{text: "选择已有图片" on_click: || import_recognition_image()}
                                }
                            }
                            if recognition_phase == "camera" {
                                Hint{text: "等待摄像头授权和画面；请在宿主弹出的授权提示中确认。"}
                                recognition_cam := CameraPreview{width: Fill height: 340 facing: "front"
                                    on_capture: || camera_captured()
                                    on_error: || recognition_failed("摄像头打开或拍照失败：" + ui.recognition_cam.error())}
                                Action{text: "拍照并识别" on_click: || ui.recognition_cam.capture({library: false})}
                            }
                            if recognition_phase == "import" { Hint{text: "请在系统文件选择框选择图片。"} }
                            if recognition_phase == "model" { Hint{text: "正在识别，请稍候…"} }
                            Soft{text: "取消，返回手动录入" on_click: || cancel_recognition()}
                        }
                    }
                    return
                }
                if onboarding_step < 4 {
                    ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 42 right: 42 top: 34 bottom: 30} spacing: 24
                        View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: .5}
                            RoundedView{show_bg: true width: 48 height: 48 flow: Overlay align: Align{x: .5 y: .5}
                                draw_bg +: {color: moss border_radius: 16}
                                Label{text: "F" padding: 0 draw_text +: {color: #xffffff text_style: theme.font_bold{font_size: 22}}}
                            }
                            View{width: Fill height: Fit flow: Down spacing: 3
                                Label{text: "SMART FRIDGE" padding: 0 draw_text +: {color: muted text_style.font_size: 10}}
                                Copy{text: "冰箱管家" draw_text.text_style: theme.font_bold{font_size: 19}}
                            }
                            if profile_edit_backup == nil { Hint{text: "首次建档  " + (onboarding_step + 1) + " / 4"} }
                            if profile_edit_backup != nil { Hint{text: "修改用户画像  " + (onboarding_step + 1) + " / 3"} }
                        }
                        Divider{}
                        if profile_edit_backup != nil { Soft{text: "取消修改 · 返回设置" on_click: || cancel_profile_edit()} }
                        if onboarding_step == 0 {
                            View{width: Fill height: Fit flow: Down spacing: 10
                                Heading{text: "让每一餐，更懂你" draw_text.text_style.font_size: 38}
                                Copy{text: "先告诉冰箱谁在使用它。这个选择会成为长期饮食计划的起点。" draw_text.color: muted}
                            }
                            View{width: Fill height: Fit flow: Right spacing: 14
                                Tint{padding: 18 spacing: 12
                                    EmojiGlass{width: 50 height: 50 Label{text: "◎" padding: 0 draw_text.text_style.font_size: 22}}
                                    Copy{text: "减脂控卡" draw_text.text_style: theme.font_bold{font_size: 18}}
                                    Hint{text: "更关注份量、饱腹感与长期执行"}
                                    if state.profile.scene == "减脂控卡" { ChosenSoft{text: "已选中" on_click: || choose_scene("减脂控卡")} }
                                    else { Soft{text: "选择" on_click: || choose_scene("减脂控卡")} }
                                }
                                Tint{padding: 18 spacing: 12
                                    EmojiGlass{width: 50 height: 50 Label{text: "✦" padding: 0 draw_text.text_style.font_size: 22}}
                                    Copy{text: "日常健康" draw_text.text_style: theme.font_bold{font_size: 18}}
                                    Hint{text: "营养均衡、少浪费、少做决定"}
                                    if state.profile.scene == "日常健康" { ChosenSoft{text: "已选中" on_click: || choose_scene("日常健康")} }
                                    else { Soft{text: "选择" on_click: || choose_scene("日常健康")} }
                                }
                                Tint{padding: 18 spacing: 12
                                    EmojiGlass{width: 50 height: 50 Label{text: "↑" padding: 0 draw_text.text_style.font_size: 22}}
                                    Copy{text: "健身增肌" draw_text.text_style: theme.font_bold{font_size: 18}}
                                    Hint{text: "更关注蛋白质与训练后的餐食安排"}
                                    if state.profile.scene == "健身增肌" { ChosenSoft{text: "已选中" on_click: || choose_scene("健身增肌")} }
                                    else { Soft{text: "选择" on_click: || choose_scene("健身增肌")} }
                                }
                                Tint{padding: 18 spacing: 12
                                    EmojiGlass{width: 50 height: 50 Label{text: "≈" padding: 0 draw_text.text_style.font_size: 22}}
                                    Copy{text: "轻负担饮食" draw_text.text_style: theme.font_bold{font_size: 18}}
                                    Hint{text: "偏清淡、规律、简单好执行"}
                                    if state.profile.scene == "轻负担饮食" { ChosenSoft{text: "已选中" on_click: || choose_scene("轻负担饮食")} }
                                    else { Soft{text: "选择" on_click: || choose_scene("轻负担饮食")} }
                                }
                            }
                            View{width: Fill height: 20}
                            Hint{text: "比赛版只做饮食管理与提醒，不做疾病诊断或医疗建议。"}
                        }
                        if onboarding_step == 1 {
                            View{width: Fill height: Fit flow: Down spacing: 9
                                Heading{text: "告诉我一些关于你的信息" draw_text.text_style.font_size: 34}
                                Copy{text: "只问会影响后续规划的必要信息；以后可以在设置里修改。" draw_text.color: muted}
                            }
                            View{width: Fill height: Fit flow: Right spacing: 22
                                Frost{width: Fill height: Fit padding: 20 spacing: 14 draw_bg.color: #xffffffb8
                                    Copy{text: "基础资料" draw_text.text_style: theme.font_bold{font_size: 18}}
                                    View{width: Fill height: Fit flow: Right spacing: 8
                                        if profile_sex == "女性" { ChosenSoft{text: "女性" on_click: || { profile_sex = "女性" redraw() }} }
                                        else { Soft{text: "女性" on_click: || { profile_sex = "女性" redraw() }} }
                                        if profile_sex == "男性" { ChosenSoft{text: "男性" on_click: || { profile_sex = "男性" redraw() }} }
                                        else { Soft{text: "男性" on_click: || { profile_sex = "男性" redraw() }} }
                                        if profile_sex == "不透露" { ChosenSoft{text: "不透露" on_click: || { profile_sex = "不透露" redraw() }} }
                                        else { Soft{text: "不透露" on_click: || { profile_sex = "不透露" redraw() }} }
                                    }
                                    Hint{text: "当前选择 · " + profile_sex}
                                    View{width: Fill height: Fit flow: Right spacing: 10
                                        Field{text: profile_age empty_text: "年龄" on_change: |text| { profile_age = text }}
                                        Field{text: profile_height empty_text: "身高 cm" on_change: |text| { profile_height = text }}
                                        Field{text: profile_weight empty_text: "体重 kg" on_change: |text| { profile_weight = text }}
                                    }
                                    Copy{text: "活动与特殊情况"}
                                    View{width: Fill height: Fit flow: Right spacing: 8
                                        if profile_activity == "轻活动" { ChosenSoft{text: "轻活动" on_click: || { profile_activity = "轻活动" redraw() }} }
                                        else { Soft{text: "轻活动" on_click: || { profile_activity = "轻活动" redraw() }} }
                                        if profile_activity == "中活动" { ChosenSoft{text: "中活动" on_click: || { profile_activity = "中活动" redraw() }} }
                                        else { Soft{text: "中活动" on_click: || { profile_activity = "中活动" redraw() }} }
                                        if profile_activity == "高活动" { ChosenSoft{text: "高活动" on_click: || { profile_activity = "高活动" redraw() }} }
                                        else { Soft{text: "高活动" on_click: || { profile_activity = "高活动" redraw() }} }
                                    }
                                    Hint{text: "当前活动 · " + profile_activity}
                                    Field{text: profile_special empty_text: "特殊情况（如有请填写）" on_change: |text| { profile_special = text }}
                                    Copy{text: "过敏" draw_text.text_style: theme.font_bold{font_size: 16}}
                                    Field{text: profile_allergies empty_text: "例如：牛奶、花生" on_change: |text| { profile_allergies = text }}
                                    Copy{text: "忌口" draw_text.text_style: theme.font_bold{font_size: 16}}
                                    Field{text: profile_avoidances empty_text: "例如：不吃香菜" on_change: |text| { profile_avoidances = text }}
                                    Copy{text: "饮食偏好" draw_text.text_style: theme.font_bold{font_size: 16}}
                                    Field{text: profile_preferences empty_text: "例如：清淡、家常、少油" on_change: |text| { profile_preferences = text }}
                                    Action{text: "下一步 · 选择周期方案  →" on_click: || save_profile()}
                                }
                                Frost{width: 330 height: Fit padding: 22 spacing: 14 draw_bg.color: #xf4f0e9d9
                                    Hint{text: "你的长期基线"}
                                    Heading{text: state.profile.scene draw_text.text_style.font_size: 27}
                                    Divider{}
                                    View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: .5}
                                        ProgressRing{width: 68 height: 68 draw_bg.progress: .32}
                                        View{width: Fill height: Fit flow: Down spacing: 4
                                            Copy{text: "不是一次性问答" draw_text.text_style: theme.font_bold{font_size: 16}}
                                            Hint{text: "之后每次入库、选菜、确认吃完，都会继续更新这份档案。"}
                                        }
                                    }
                                    Hint{text: "热量与营养数值在比赛版仅作演示估算。"}
                                }
                            }
                        }
                        if onboarding_step == 2 {
                            View{width: Fill height: Fit flow: Down spacing: 8
                                Heading{text: "选择具体周期方案" draw_text.text_style.font_size: 29}
                                Copy{text: "方向只是偏好。下面是根据档案和活动量生成的 7、21、30 天候选，选择一份后才执行。" draw_text.color: muted}
                            }
                            for p in state.programs {
                                Frost{padding: 20 spacing: 12 draw_bg.color: #ffffffc2
                                    let marker = "候选方案"
                                    if p.id == program_selected { marker = "✓ 当前选中" }
                                    Hint{text: marker + " · " + state.profile.scene}
                                    Copy{text: p.name draw_text.text_style: theme.font_bold{font_size: 22}}
                                    if p.kcal_goal > 0 {
                                        Copy{text: p.days + " 天 · 总 " + p.kcal_goal + " kcal · 每日参考 " + p.daily_kcal + " kcal"}
                                        Hint{text: "蛋白质 " + p.protein_goal + " g · 膳食纤维 " + p.fiber_goal + " g · 维生素 C " + p.vitamin_c_goal + " mg / 周期"}
                                    }
                                    if p.kcal_goal == 0 { Hint{text: "该档案需要专业人员确认摄入目标，当前不自动填入数值。"} }
                                    if p.id == program_selected { ChosenSoft{text: "当前已选中" on_click: || select_program(p.id)} }
                                    else { Soft{text: "选择这份周期方案" on_click: || select_program(p.id)} }
                                }
                            }
                            Frost{padding: 18 spacing: 10 draw_bg.color: #eef3e8
                                Copy{text: "执行与营养核算" draw_text.text_style: theme.font_bold{font_size: 17}}
                                Hint{text: "确认实际吃完才扣库存和热量；本地只识别少数原料营养，未知食材不冒充严格达标。烹饪油等需另计。"}
                                Hint{text: "这里只是原型参考估算，不是医疗处方；不自动给未成年人或有特殊情况的档案填写数值目标。"}
                                Soft{text: "返回修改基础资料" on_click: || { onboarding_step = 1 redraw() }}
                                if profile_edit_backup == nil { Action{text: "确认选中方案 · 去录冰箱  →" on_click: || confirm_health_plan()} }
                                if profile_edit_backup != nil { Action{text: "保存画像与周期方案  →" on_click: || confirm_health_plan()} }
                            }
                        }
                        if onboarding_step == 3 {
                            View{width: Fill height: Fit flow: Down spacing: 9
                                Heading{text: "录入冰箱食材 · 建立食材档案" draw_text.text_style.font_size: 34}
                                Copy{text: "第一次先把真实库存录进去。以后只需要持续补充新买的食材与实际吃掉的量。" draw_text.color: muted}
                            }
                            View{width: Fill height: Fit flow: Right spacing: 8
                                if intake_draft == nil {
                                    Hint{text: "下方可手动添加食材"}
                                } else {
                                    Soft{text: "取消当前草稿" on_click: || cancel_preview()}
                                }
                                Quiet{text: "拍照识别" enabled: intake_draft == nil on_click: || begin_recognition("food_image")}
                                Quiet{text: "导入小票" enabled: intake_draft == nil on_click: || begin_recognition("receipt_image")}
                            }
                            if intake_draft != nil { Hint{text: "请先确认或取消当前草稿，再开始新的手动添加、拍照或导入。"} }
                            Hint{text: message}
                            View{width: Fill height: Fit flow: Right spacing: 18
                                Frost{width: Fill height: Fit padding: 20 spacing: 12 draw_bg.color: #xffffffc2
                                    if intake_draft == nil {
                                        Field{text: draft_name empty_text: "食材名称" on_change: |text| { draft_name = text }}
                                        View{width: Fill height: Fit flow: Right spacing: 8
                                            Field{text: draft_grams empty_text: "数量" on_change: |text| { draft_grams = text }}
                                            Copy{text: "单位 · " + draft_unit}
                                        }
                                        View{width: Fill height: Fit flow: Right spacing: 6
                                            if draft_unit == "g" { ChosenQuiet{text: "g" on_click: || { draft_unit = "g" redraw() }} }
                                            else { Quiet{text: "g" on_click: || { draft_unit = "g" redraw() }} }
                                            if draft_unit == "kg" { ChosenQuiet{text: "kg" on_click: || { draft_unit = "kg" redraw() }} }
                                            else { Quiet{text: "kg" on_click: || { draft_unit = "kg" redraw() }} }
                                            if draft_unit == "ml" { ChosenQuiet{text: "ml" on_click: || { draft_unit = "ml" redraw() }} }
                                            else { Quiet{text: "ml" on_click: || { draft_unit = "ml" redraw() }} }
                                            if draft_unit == "L" { ChosenQuiet{text: "L" on_click: || { draft_unit = "L" redraw() }} }
                                            else { Quiet{text: "L" on_click: || { draft_unit = "L" redraw() }} }
                                            if draft_unit == "个" { ChosenQuiet{text: "个" on_click: || { draft_unit = "个" redraw() }} }
                                            else { Quiet{text: "个" on_click: || { draft_unit = "个" redraw() }} }
                                        }
                                        View{width: Fill height: Fit flow: Right spacing: 6
                                            if draft_unit == "盒" { ChosenQuiet{text: "盒" on_click: || { draft_unit = "盒" redraw() }} }
                                            else { Quiet{text: "盒" on_click: || { draft_unit = "盒" redraw() }} }
                                            if draft_unit == "袋" { ChosenQuiet{text: "袋" on_click: || { draft_unit = "袋" redraw() }} }
                                            else { Quiet{text: "袋" on_click: || { draft_unit = "袋" redraw() }} }
                                            if draft_unit == "瓶" { ChosenQuiet{text: "瓶" on_click: || { draft_unit = "瓶" redraw() }} }
                                            else { Quiet{text: "瓶" on_click: || { draft_unit = "瓶" redraw() }} }
                                        }
                                        if package_unit(draft_unit) {
                                            Field{text: draft_package_size empty_text: "每包装数量（可留空）" on_change: |text| { draft_package_size = text }}
                                            Hint{text: "每包装单位 · " + draft_package_unit + "；填包装数量时请选择单位"}
                                            View{width: Fill height: Fit flow: Right spacing: 6
                                                if draft_package_unit == "" { ChosenQuiet{text: "未知" on_click: || { draft_package_size = "" draft_package_unit = "" redraw() }} }
                                                else { Quiet{text: "未知" on_click: || { draft_package_size = "" draft_package_unit = "" redraw() }} }
                                                if draft_package_unit == "g" { ChosenQuiet{text: "g" on_click: || { draft_package_unit = "g" redraw() }} }
                                                else { Quiet{text: "g" on_click: || { draft_package_unit = "g" redraw() }} }
                                                if draft_package_unit == "ml" { ChosenQuiet{text: "ml" on_click: || { draft_package_unit = "ml" redraw() }} }
                                                else { Quiet{text: "ml" on_click: || { draft_package_unit = "ml" redraw() }} }
                                                if draft_package_unit == "piece" { ChosenQuiet{text: "个" on_click: || { draft_package_unit = "piece" redraw() }} }
                                                else { Quiet{text: "个" on_click: || { draft_package_unit = "piece" redraw() }} }
                                            }
                                        }
                                        if draft_unit == "个" || (package_unit(draft_unit) && draft_package_unit == "piece") {
                                            Field{text: draft_average empty_text: "平均每个约多少 g（可留空）" on_change: |text| { draft_average = text }}
                                        }
                                        Field{text: draft_days empty_text: "还剩几天（可留空）" on_change: |text| { draft_days = text }}
                                        Field{text: draft_date empty_text: "印刷日期 YYYY-MM-DD" on_change: |text| { draft_date = text }}
                                        Hint{text: "剩余天数与印刷日期二选一；都留空表示保质期未知。"}
                                        Quiet{text: "填写 / 收起包装营养参考" on_click: || { show_nutrition_input = !show_nutrition_input redraw() }}
                                        if show_nutrition_input {
                                            Field{text: draft_kcal empty_text: "每100g热量 kcal" on_change: |text| { draft_kcal = text }}
                                            Field{text: draft_protein empty_text: "每100g蛋白质 g" on_change: |text| { draft_protein = text }}
                                            Field{text: draft_fiber empty_text: "每100g膳食纤维 g" on_change: |text| { draft_fiber = text }}
                                            Field{text: draft_vitamin_c empty_text: "每100g维生素C mg" on_change: |text| { draft_vitamin_c = text }}
                                        }
                                        Action{text: "预览并确认  →" on_click: || preview_food()}
                                        if editing_id > 0 {
                                            Soft{text: "取消修改" on_click: || cancel_edit()}
                                        }
                                    }
                                    if intake_draft != nil {
                                        Hint{text: "点击状态按钮可切换选择；只有已选中的行会在最终确认时入库。"}
                                        for i in intake_draft.rows.len() {
                                            let row = intake_draft.rows[i]
                                            Tint{draw_bg.color: #f0ece4
                                                View{width: Fill height: Fit flow: Right spacing: 6
                                                    Quiet{text: "" + row.row_id + " · " + row.name}
                                                    let selected_text = "✓ 已选中"
                                                    if !row.selected { selected_text = "○ 未选中" }
                                                    if row.selected { ChosenSoft{text: selected_text on_click: || { row.selected = !row.selected redraw() }} }
                                                    else { Soft{text: selected_text on_click: || { row.selected = !row.selected redraw() }} }
                                                    Quiet{text: "移除" on_click: || remove_draft_row(row.row_id)}
                                                }
                                                Field{text: row.name empty_text: "食材名称" on_change: |text| { row.name = text }}
                                                View{width: Fill height: Fit flow: Right spacing: 8
                                                    Field{text: row.quantity_text empty_text: "数量" on_change: |text| { row.quantity_text = text }}
                                                    Hint{text: "单位 · " + (if row.unit == "" { "未选择" } else { row.unit })}
                                                }
                                                View{width: Fill height: Fit flow: Right spacing: 6
                                                    if row.unit == "g" { ChosenQuiet{text: "g" on_click: || { row.unit = "g" redraw() }} }
                                                    else { Quiet{text: "g" on_click: || { row.unit = "g" redraw() }} }
                                                    if row.unit == "kg" { ChosenQuiet{text: "kg" on_click: || { row.unit = "kg" redraw() }} }
                                                    else { Quiet{text: "kg" on_click: || { row.unit = "kg" redraw() }} }
                                                    if row.unit == "ml" { ChosenQuiet{text: "ml" on_click: || { row.unit = "ml" redraw() }} }
                                                    else { Quiet{text: "ml" on_click: || { row.unit = "ml" redraw() }} }
                                                    if row.unit == "L" { ChosenQuiet{text: "L" on_click: || { row.unit = "L" redraw() }} }
                                                    else { Quiet{text: "L" on_click: || { row.unit = "L" redraw() }} }
                                                    if row.unit == "个" { ChosenQuiet{text: "个" on_click: || { row.unit = "个" redraw() }} }
                                                    else { Quiet{text: "个" on_click: || { row.unit = "个" redraw() }} }
                                                }
                                                View{width: Fill height: Fit flow: Right spacing: 6
                                                    if row.unit == "盒" { ChosenQuiet{text: "盒" on_click: || { row.unit = "盒" redraw() }} }
                                                    else { Quiet{text: "盒" on_click: || { row.unit = "盒" redraw() }} }
                                                    if row.unit == "袋" { ChosenQuiet{text: "袋" on_click: || { row.unit = "袋" redraw() }} }
                                                    else { Quiet{text: "袋" on_click: || { row.unit = "袋" redraw() }} }
                                                    if row.unit == "瓶" { ChosenQuiet{text: "瓶" on_click: || { row.unit = "瓶" redraw() }} }
                                                    else { Quiet{text: "瓶" on_click: || { row.unit = "瓶" redraw() }} }
                                                }
                                                if canonical_unit(row.unit) == "" && !package_unit(row.unit) {
                                                    Hint{text: "请从上方选择单位，并核对数量。"}
                                                }
                                                if package_unit(row.unit) {
                                                    Field{text: row.package_size_text empty_text: "每包装数量（可留空）" on_change: |text| { row.package_size_text = text }}
                                                    Hint{text: "每包装单位 · " + row.package_size_unit}
                                                    View{width: Fill height: Fit flow: Right spacing: 6
                                                        if row.package_size_unit == "" { ChosenQuiet{text: "未知" on_click: || { row.package_size_text = "" row.package_size_unit = "" redraw() }} }
                                                        else { Quiet{text: "未知" on_click: || { row.package_size_text = "" row.package_size_unit = "" redraw() }} }
                                                        if row.package_size_unit == "g" { ChosenQuiet{text: "g" on_click: || { row.package_size_unit = "g" redraw() }} }
                                                        else { Quiet{text: "g" on_click: || { row.package_size_unit = "g" redraw() }} }
                                                        if row.package_size_unit == "ml" { ChosenQuiet{text: "ml" on_click: || { row.package_size_unit = "ml" redraw() }} }
                                                        else { Quiet{text: "ml" on_click: || { row.package_size_unit = "ml" redraw() }} }
                                                        if row.package_size_unit == "piece" { ChosenQuiet{text: "个" on_click: || { row.package_size_unit = "piece" redraw() }} }
                                                        else { Quiet{text: "个" on_click: || { row.package_size_unit = "piece" redraw() }} }
                                                    }
                                                }
                                                if row.unit == "个" || (package_unit(row.unit) && row.package_size_unit == "piece") {
                                                    Field{text: row.average_item_grams_text empty_text: "平均每个约多少 g（可留空）" on_change: |text| { row.average_item_grams_text = text }}
                                                }
                                                Field{text: row.remaining_days_text empty_text: "还剩几天（可留空）" on_change: |text| { row.remaining_days_text = text }}
                                                Field{text: row.printed_expires_on empty_text: "印刷日期 YYYY-MM-DD（可留空）" on_change: |text| { row.printed_expires_on = text }}
                                                Hint{text: "营养参考四项同时填写，或全部留空。"}
                                                Field{text: row.kcal_text empty_text: "每100g热量 kcal" on_change: |text| { row.kcal_text = text }}
                                                Field{text: row.protein_text empty_text: "每100g蛋白质 g" on_change: |text| { row.protein_text = text }}
                                                Field{text: row.fiber_text empty_text: "每100g膳食纤维 g" on_change: |text| { row.fiber_text = text }}
                                                Field{text: row.vitamin_c_text empty_text: "每100g维生素C mg" on_change: |text| { row.vitamin_c_text = text }}
                                            }
                                        }
                                        draft_error := Hint{text: intake_draft.error}
                                        Action{text: "最终确认入库" on_click: || confirm_intake()}
                                        Soft{text: "取消草稿" on_click: || cancel_preview()}
                                    }
                                }
                                Frost{width: 360 height: Fit padding: 18 spacing: 10
                                    View{width: Fill height: Fit flow: Right
                                        Copy{text: "库存已录入" draw_text.text_style: theme.font_bold{font_size: 17}}
                                        Hint{text: "" + available() + " 批"}
                                    }
                                    if state.foods.len() == 0 {
                                        Hint{text: "识别结果仍是草稿。请在左侧勾选食材，滚动到底部点“最终确认入库”。"}
                                    }
                                    for group in inventory_groups() {
                                        View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: .5}
                                            EmojiGlass{Label{text: food_emoji(group.name) padding: 0 draw_text.text_style.font_size: 18}}
                                            View{width: Fill height: Fit flow: Down spacing: 2
                                                Copy{text: group.name + " · " + group.batches.len() + " 批" draw_text.text_style: theme.font_bold{font_size: 15}}
                                                Hint{text: group_total_text(group) + " · " + group.status}
                                            }
                                        }
                                    }
                                    Divider{}
                                    if available() == 0 {
                                        Soft{text: "待确认入库至少 1 批" enabled: false}
                                    } else {
                                        Action{text: "完成建档 · 开始托管  →" on_click: || finish_onboarding()}
                                    }
                                }
                            }
                        }
                    }
                }
                if onboarding_step == 4 {
                    View{width: Fill height: Fill flow: Right
                        RoundedView{show_bg: true width: 112 height: Fill flow: Down padding: Inset{left: 10 right: 10 top: 18 bottom: 18} spacing: 12
                            draw_bg +: {color: #xf7f4efcf border_radius: 30}
                            RoundedView{show_bg: true width: 48 height: 48 flow: Overlay align: Align{x: .5 y: .5}
                                draw_bg +: {color: moss border_radius: 16}
                                Label{text: "F" padding: 0 draw_text +: {color: #xffffff text_style: theme.font_bold{font_size: 22}}}
                            }
                            View{width: Fill height: 8}
                            navigation := View{width: Fill height: Fit flow: Down spacing: 8 on_render: || {
                                let labels = ["⌂  首页" "▣  冰箱" "✦  方案" "◔  档案" "⚙  设置"]
                                for i in 5 {
                                    let bg = #x00000000
                                    let tc = muted
                                    let hover = #eee9e2
                                    let down = #ddd6cb
                                    if tab == i { bg = moss tc = #xffffff hover = #x373632 down = #x171714 }
                                    Pill{width: Fill height: 44 margin: 0 padding: 8 text: labels[i] on_click: || navigate(i)
                                        draw_bg +: {color: bg color_hover: hover color_down: down color_focus: bg border_radius: 14 border_size: 0}
                                        draw_text +: {color: tc color_hover: tc color_down: tc color_focus: tc text_style.font_size: 12}}
                                }
                            }}
                            View{width: Fill height: Fill}
                            Hint{text: "长期托管" draw_text.text_style.font_size: 10}
                            StatusDot{}
                        }
                        View{width: Fill height: Fill flow: Down padding: Inset{left: 28 right: 28 top: 22 bottom: 18} spacing: 14
                            View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: .5}
                                View{width: Fill height: Fit flow: Down spacing: 4
                                    Label{text: "冰箱管家" padding: 0 draw_text +: {color: ink text_style: theme.font_bold{font_size: 21}}}
                                    View{width: Fill height: Fit flow: Right spacing: 7 align: Align{y: .5}
                                        StatusDot{}
                                        agent_status := Hint{text: "本地规则 · 正在启动"}
                                    }
                                }
                                Quiet{text: "+  更新冰箱" on_click: || navigate(1)}
                            }
                            content := View{width: Fill height: Fill on_render: || { ScrollYView{width: Fill height: Fill flow: Down spacing: 16 padding: Inset{right: 5}
                                if ai_busy {
                                    Tint{draw_bg.color: #f0ece4
                                        Copy{text: "AI 正在根据长期画像与真实库存安排这一餐" draw_text.text_style: theme.font_bold{font_size: 16}}
                                        Hint{text: "库存、临期、当下口味和长期目标会一起参与判断。"}
                                        Soft{text: "停止等待" on_click: || cancel_ai()}
                                    }
                                }
                                if use_ai && ai_error != "" && !ai_busy {
                                    Tint{draw_bg.color: #f4ede4
                                        Copy{text: "这次还没生成新方案" draw_text.text_style: theme.font_bold{font_size: 16}}
                                        Hint{text: ai_error}
                                        if ai_phase == 1 { Soft{text: "重新生成" on_click: || retry_ai()} }
                                        if ai_phase == 3 || ai_phase == 4 { Soft{text: "查看 AI 设置" on_click: || navigate(4)} }
                                    }
                                }
                                if tab == 0 {
                                    Frost{padding: 24 spacing: 14 draw_bg.color: #ffffffc9
                                        View{width: Fill height: Fit flow: Right spacing: 18 align: Align{y: .5}
                                            View{width: Fill height: Fit flow: Down spacing: 8
                                                Hint{text: "TODAY · " + state.profile.scene}
                                                Heading{text: "今天想吃点什么？" draw_text.text_style.font_size: 36}
                                                Copy{text: "一句话说当下需求，剩下的交给你的长期档案与冰箱库存。" draw_text.color: muted}
                                            }
                                            RoundedView{show_bg: true width: 150 height: 112 flow: Overlay align: Align{x: .5 y: .5}
                                                draw_bg +: {color: #eee9e2 border_radius: 28}
                                                Label{text: "F  ·  AI" padding: 0 draw_text +: {color: ink text_style: theme.font_bold{font_size: 24}}}
                                            }
                                        }
                                        View{width: Fill height: 54 flow: Overlay
                                            request := Field{padding: Inset{left: 16 right: 74} text: goal empty_text: "例如：我今天想吃点清淡的" on_change: |text| { goal = text }}
                                            View{width: Fill height: Fill align: Align{x: 1 y: .5}
                                                let voice_active = 0.0
                                                if voice_phase == 2 { voice_active = 1.0 }
                                                voice_button := VoiceButton{enabled: voice_phase != 1 && voice_phase != 3
                                                    draw_bg.active: voice_active on_click: || toggle_voice()}
                                            }
                                        }
                                        View{width: Fill height: Fit flow: Right spacing: 8
                                            if goal == "今天想吃点清淡的" { ChosenQuiet{text: "清淡" on_click: || set_goal("今天想吃点清淡的")} }
                                            else { Quiet{text: "清淡" on_click: || set_goal("今天想吃点清淡的")} }
                                            if goal == "今天想吃高蛋白一点" { ChosenQuiet{text: "高蛋白" on_click: || set_goal("今天想吃高蛋白一点")} }
                                            else { Quiet{text: "高蛋白" on_click: || set_goal("今天想吃高蛋白一点")} }
                                            if goal == "今天想吃低卡一点" { ChosenQuiet{text: "低卡" on_click: || set_goal("今天想吃低卡一点")} }
                                            else { Quiet{text: "低卡" on_click: || set_goal("今天想吃低卡一点")} }
                                            if goal == "今天只想做 15 分钟快手菜" { ChosenQuiet{text: "快手" on_click: || set_goal("今天只想做 15 分钟快手菜")} }
                                            else { Quiet{text: "快手" on_click: || set_goal("今天只想做 15 分钟快手菜")} }
                                            Action{width: 210 text: "生成这一餐  →" enabled: !ai_busy && voice_phase == 0 && (!use_ai || ai_phase != 0) on_click: || generate()}
                                        }
                                    }
                                    let p = active_plan()
                                    View{width: Fill height: Fit flow: Right spacing: 14
                                        View{width: Fill height: Fit flow: Down spacing: 12
                                            Copy{text: "今日概览" draw_text.text_style: theme.font_bold{font_size: 17}}
                                            View{width: Fill height: Fit flow: Right spacing: 10
                                                Tint{draw_bg.color: #f1ede7
                                                    Hint{text: "优先食用"}
                                                    Copy{text: urgent_names() draw_text.text_style: theme.font_bold{font_size: 17}}
                                                }
                                                Tint{draw_bg.color: #f5f2ed
                                                    Hint{text: "冰箱库存"}
                                                    Copy{text: "" + available() + " 批食材" draw_text.text_style: theme.font_bold{font_size: 17}}
                                                }
                                            }
                                            View{width: Fill height: Fit flow: Right spacing: 10
                                                Tint{draw_bg.color: #f1ede7
                                                    Hint{text: "今晚建议"}
                                                    if p == nil { Copy{text: "等待生成" draw_text.text_style: theme.font_bold{font_size: 17}} }
                                                    if p != nil { Copy{text: p.title draw_text.text_style: theme.font_bold{font_size: 17}} }
                                                }
                                                Tint{draw_bg.color: #f5f2ed
                                                    Hint{text: "今日预算剩余"}
                                                    Copy{text: "约 " + remaining_budget() + " kcal" draw_text.text_style: theme.font_bold{font_size: 17}}
                                                }
                                            }
                                        }
                                        Frost{width: 320 height: Fit padding: 20 spacing: 12 draw_bg.color: #f5f1ebd9
                                            Hint{text: "长期档案"}
                                            Copy{text: state.profile.scene draw_text.text_style: theme.font_bold{font_size: 21}}
                                            View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: .5}
                                                View{width: 82 height: 82 flow: Overlay align: Align{x: .5 y: .5}
                                                    ProgressRing{width: 82 height: 82 draw_bg.progress: nutrition_percent() / 100}
                                                    Label{text: "" + nutrition_percent() + "%" padding: 0 draw_text +: {color: ink text_style: theme.font_bold{font_size: 14}}}
                                                }
                                                View{width: Fill height: Fit flow: Down spacing: 4
                                                    Copy{text: "今日已记录 " + state.meal_count + " 餐" draw_text.text_style: theme.font_bold{font_size: 15}}
                                                    Hint{text: preference_summary()}
                                                }
                                            }
                                            Divider{}
                                            Hint{text: "Agent 会在库存、时间或你的反馈变化后继续重排，而不是每次从零回答。"}
                                        }
                                    }
                                    if p != nil { Quiet{text: "查看当前方案与做法  ›" on_click: || { for i in state.plans.len() { if state.plans[i].id == state.active { selected = i } } tab = 2 details = false redraw() }} }
                                }
                                if tab == 1 {
                                    View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: .5}
                                        View{width: Fill height: Fit flow: Down spacing: 4
                                            Heading{text: "冰箱食材" draw_text.text_style.font_size: 30}
                                            Hint{text: "购买后更新一次，Agent 会持续维护数量、临期与下一餐。"}
                                        }
                                        Quiet{text: "拍照识别" enabled: intake_draft == nil on_click: || begin_recognition("food_image")}
                                        Quiet{text: "导入小票" enabled: intake_draft == nil on_click: || begin_recognition("receipt_image")}
                                    }
                                    if intake_draft != nil { Hint{text: "先确认或取消当前草稿，才能开始新的拍照或导入。"} }
                                    View{width: Fill height: Fit flow: Right spacing: 16
                                        Frost{width: 360 height: Fit padding: 18 spacing: 10
                                            Copy{text: "手动添加 / 修改" draw_text.text_style: theme.font_bold{font_size: 17}}
                                            if intake_draft == nil && removal == nil {
                                                Field{text: draft_name empty_text: "食材名称" on_change: |text| { draft_name = text }}
                                                View{width: Fill height: Fit flow: Right spacing: 8
                                                    Field{text: draft_grams empty_text: "数量" on_change: |text| { draft_grams = text }}
                                                    Copy{text: "单位 · " + draft_unit}
                                                }
                                                View{width: Fill height: Fit flow: Right spacing: 6
                                                    if draft_unit == "g" { ChosenQuiet{text: "g" on_click: || { draft_unit = "g" redraw() }} }
                                                    else { Quiet{text: "g" on_click: || { draft_unit = "g" redraw() }} }
                                                    if draft_unit == "kg" { ChosenQuiet{text: "kg" on_click: || { draft_unit = "kg" redraw() }} }
                                                    else { Quiet{text: "kg" on_click: || { draft_unit = "kg" redraw() }} }
                                                    if draft_unit == "ml" { ChosenQuiet{text: "ml" on_click: || { draft_unit = "ml" redraw() }} }
                                                    else { Quiet{text: "ml" on_click: || { draft_unit = "ml" redraw() }} }
                                                    if draft_unit == "L" { ChosenQuiet{text: "L" on_click: || { draft_unit = "L" redraw() }} }
                                                    else { Quiet{text: "L" on_click: || { draft_unit = "L" redraw() }} }
                                                    if draft_unit == "个" { ChosenQuiet{text: "个" on_click: || { draft_unit = "个" redraw() }} }
                                                    else { Quiet{text: "个" on_click: || { draft_unit = "个" redraw() }} }
                                                }
                                                View{width: Fill height: Fit flow: Right spacing: 6
                                                    if draft_unit == "盒" { ChosenQuiet{text: "盒" on_click: || { draft_unit = "盒" redraw() }} }
                                                    else { Quiet{text: "盒" on_click: || { draft_unit = "盒" redraw() }} }
                                                    if draft_unit == "袋" { ChosenQuiet{text: "袋" on_click: || { draft_unit = "袋" redraw() }} }
                                                    else { Quiet{text: "袋" on_click: || { draft_unit = "袋" redraw() }} }
                                                    if draft_unit == "瓶" { ChosenQuiet{text: "瓶" on_click: || { draft_unit = "瓶" redraw() }} }
                                                    else { Quiet{text: "瓶" on_click: || { draft_unit = "瓶" redraw() }} }
                                                }
                                                if package_unit(draft_unit) {
                                                    Field{text: draft_package_size empty_text: "每包装数量（可留空）" on_change: |text| { draft_package_size = text }}
                                                    Hint{text: "每包装单位 · " + draft_package_unit + "；填包装数量时请选择单位"}
                                                    View{width: Fill height: Fit flow: Right spacing: 6
                                                        if draft_package_unit == "" { ChosenQuiet{text: "未知" on_click: || { draft_package_size = "" draft_package_unit = "" redraw() }} }
                                                        else { Quiet{text: "未知" on_click: || { draft_package_size = "" draft_package_unit = "" redraw() }} }
                                                        if draft_package_unit == "g" { ChosenQuiet{text: "g" on_click: || { draft_package_unit = "g" redraw() }} }
                                                        else { Quiet{text: "g" on_click: || { draft_package_unit = "g" redraw() }} }
                                                        if draft_package_unit == "ml" { ChosenQuiet{text: "ml" on_click: || { draft_package_unit = "ml" redraw() }} }
                                                        else { Quiet{text: "ml" on_click: || { draft_package_unit = "ml" redraw() }} }
                                                        if draft_package_unit == "piece" { ChosenQuiet{text: "个" on_click: || { draft_package_unit = "piece" redraw() }} }
                                                        else { Quiet{text: "个" on_click: || { draft_package_unit = "piece" redraw() }} }
                                                    }
                                                }
                                                if draft_unit == "个" || (package_unit(draft_unit) && draft_package_unit == "piece") {
                                                    Field{text: draft_average empty_text: "平均每个约多少 g（可留空）" on_change: |text| { draft_average = text }}
                                                }
                                                Field{text: draft_days empty_text: "还剩几天（可留空）" on_change: |text| { draft_days = text }}
                                                Field{text: draft_date empty_text: "印刷日期 YYYY-MM-DD" on_change: |text| { draft_date = text }}
                                                Hint{text: "剩余天数与印刷日期二选一；都留空表示保质期未知。"}
                                                Quiet{text: "填写 / 收起包装营养参考" on_click: || { show_nutrition_input = !show_nutrition_input redraw() }}
                                                if show_nutrition_input {
                                                    Field{text: draft_kcal empty_text: "每100g热量 kcal" on_change: |text| { draft_kcal = text }}
                                                    Field{text: draft_protein empty_text: "每100g蛋白质 g" on_change: |text| { draft_protein = text }}
                                                    Field{text: draft_fiber empty_text: "每100g膳食纤维 g" on_change: |text| { draft_fiber = text }}
                                                    Field{text: draft_vitamin_c empty_text: "每100g维生素C mg" on_change: |text| { draft_vitamin_c = text }}
                                                }
                                                Action{text: "预览并确认  →" on_click: || preview_food()}
                                                if editing_id > 0 {
                                                    Soft{text: "取消修改" on_click: || cancel_edit()}
                                                }
                                            }
                                            if removal != nil {
                                                Tint{draw_bg.color: #f4ede4
                                                    Copy{text: "确认移除 " + removal.name + " · " + removal.quantity + removal.unit + "？" draw_text.text_style: theme.font_bold{font_size: 17}}
                                                    Hint{text: "不会计作吃完；已有菜单会重新校验。"}
                                                    Action{text: "确认移除" on_click: || confirm_remove()}
                                                    Soft{text: "取消" on_click: || cancel_edit()}
                                                }
                                            }
                                            if intake_draft != nil {
                                                Hint{text: "点击状态按钮可切换选择；只有已选中的行会在最终确认时入库。"}
                                                for i in intake_draft.rows.len() {
                                                    let row = intake_draft.rows[i]
                                                    Tint{draw_bg.color: #f0ece4
                                                        View{width: Fill height: Fit flow: Right spacing: 6
                                                            Quiet{text: "" + row.row_id + " · " + row.name}
                                                            let selected_text = "✓ 已选中"
                                                            if !row.selected { selected_text = "○ 未选中" }
                                                            if row.selected { ChosenSoft{text: selected_text on_click: || { row.selected = !row.selected redraw() }} }
                                                            else { Soft{text: selected_text on_click: || { row.selected = !row.selected redraw() }} }
                                                            Quiet{text: "移除" on_click: || remove_draft_row(row.row_id)}
                                                        }
                                                        Field{text: row.name empty_text: "食材名称" on_change: |text| { row.name = text }}
                                                        View{width: Fill height: Fit flow: Right spacing: 8
                                                            Field{text: row.quantity_text empty_text: "数量" on_change: |text| { row.quantity_text = text }}
                                                            Hint{text: "单位 · " + (if row.unit == "" { "未选择" } else { row.unit })}
                                                        }
                                                        View{width: Fill height: Fit flow: Right spacing: 6
                                                            if row.unit == "g" { ChosenQuiet{text: "g" on_click: || { row.unit = "g" redraw() }} }
                                                            else { Quiet{text: "g" on_click: || { row.unit = "g" redraw() }} }
                                                            if row.unit == "kg" { ChosenQuiet{text: "kg" on_click: || { row.unit = "kg" redraw() }} }
                                                            else { Quiet{text: "kg" on_click: || { row.unit = "kg" redraw() }} }
                                                            if row.unit == "ml" { ChosenQuiet{text: "ml" on_click: || { row.unit = "ml" redraw() }} }
                                                            else { Quiet{text: "ml" on_click: || { row.unit = "ml" redraw() }} }
                                                            if row.unit == "L" { ChosenQuiet{text: "L" on_click: || { row.unit = "L" redraw() }} }
                                                            else { Quiet{text: "L" on_click: || { row.unit = "L" redraw() }} }
                                                            if row.unit == "个" { ChosenQuiet{text: "个" on_click: || { row.unit = "个" redraw() }} }
                                                            else { Quiet{text: "个" on_click: || { row.unit = "个" redraw() }} }
                                                        }
                                                        View{width: Fill height: Fit flow: Right spacing: 6
                                                            if row.unit == "盒" { ChosenQuiet{text: "盒" on_click: || { row.unit = "盒" redraw() }} }
                                                            else { Quiet{text: "盒" on_click: || { row.unit = "盒" redraw() }} }
                                                            if row.unit == "袋" { ChosenQuiet{text: "袋" on_click: || { row.unit = "袋" redraw() }} }
                                                            else { Quiet{text: "袋" on_click: || { row.unit = "袋" redraw() }} }
                                                            if row.unit == "瓶" { ChosenQuiet{text: "瓶" on_click: || { row.unit = "瓶" redraw() }} }
                                                            else { Quiet{text: "瓶" on_click: || { row.unit = "瓶" redraw() }} }
                                                        }
                                                        if canonical_unit(row.unit) == "" && !package_unit(row.unit) {
                                                            Hint{text: "请从上方选择单位，并核对数量。"}
                                                        }
                                                        if package_unit(row.unit) {
                                                            Field{text: row.package_size_text empty_text: "每包装数量（可留空）" on_change: |text| { row.package_size_text = text }}
                                                            Hint{text: "每包装单位 · " + row.package_size_unit}
                                                            View{width: Fill height: Fit flow: Right spacing: 6
                                                                if row.package_size_unit == "" { ChosenQuiet{text: "未知" on_click: || { row.package_size_text = "" row.package_size_unit = "" redraw() }} }
                                                                else { Quiet{text: "未知" on_click: || { row.package_size_text = "" row.package_size_unit = "" redraw() }} }
                                                                if row.package_size_unit == "g" { ChosenQuiet{text: "g" on_click: || { row.package_size_unit = "g" redraw() }} }
                                                                else { Quiet{text: "g" on_click: || { row.package_size_unit = "g" redraw() }} }
                                                                if row.package_size_unit == "ml" { ChosenQuiet{text: "ml" on_click: || { row.package_size_unit = "ml" redraw() }} }
                                                                else { Quiet{text: "ml" on_click: || { row.package_size_unit = "ml" redraw() }} }
                                                                if row.package_size_unit == "piece" { ChosenQuiet{text: "个" on_click: || { row.package_size_unit = "piece" redraw() }} }
                                                                else { Quiet{text: "个" on_click: || { row.package_size_unit = "piece" redraw() }} }
                                                            }
                                                        }
                                                        if row.unit == "个" || (package_unit(row.unit) && row.package_size_unit == "piece") {
                                                            Field{text: row.average_item_grams_text empty_text: "平均每个约多少 g（可留空）" on_change: |text| { row.average_item_grams_text = text }}
                                                        }
                                                        Field{text: row.remaining_days_text empty_text: "还剩几天（可留空）" on_change: |text| { row.remaining_days_text = text }}
                                                        Field{text: row.printed_expires_on empty_text: "印刷日期 YYYY-MM-DD（可留空）" on_change: |text| { row.printed_expires_on = text }}
                                                        Hint{text: "营养参考四项同时填写，或全部留空。"}
                                                        Field{text: row.kcal_text empty_text: "每100g热量 kcal" on_change: |text| { row.kcal_text = text }}
                                                        Field{text: row.protein_text empty_text: "每100g蛋白质 g" on_change: |text| { row.protein_text = text }}
                                                        Field{text: row.fiber_text empty_text: "每100g膳食纤维 g" on_change: |text| { row.fiber_text = text }}
                                                        Field{text: row.vitamin_c_text empty_text: "每100g维生素C mg" on_change: |text| { row.vitamin_c_text = text }}
                                                    }
                                                }
                                                draft_error := Hint{text: intake_draft.error}
                                                Action{text: "最终确认入库" on_click: || confirm_intake()}
                                                Soft{text: "取消草稿" on_click: || cancel_preview()}
                                            }
                                        }
                                        View{width: Fill height: Fit flow: Down spacing: 10
                                            View{width: Fill height: Fit flow: Right
                                                Copy{text: "库存清单" draw_text.text_style: theme.font_bold{font_size: 18}}
                                                Hint{text: "" + available() + " 批"}
                                            }
                                            if state.foods.len() == 0 { Hint{text: "冰箱还是空的，先录入第一批食材。"} }
                                            for group in inventory_groups() {
                                                Tint{padding: 13 draw_bg.color: #ffffffa8
                                                    View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: .5}
                                                        EmojiGlass{Label{text: food_emoji(group.name) padding: 0 draw_text.text_style.font_size: 19}}
                                                        View{width: Fill height: Fit flow: Down spacing: 3
                                                            Copy{text: group.name + " · " + group.batches.len() + " 批" draw_text.text_style: theme.font_bold{font_size: 16}}
                                                            Hint{text: group_total_text(group) + " · " + group.status}
                                                        }
                                                        Quiet{text: "展开 / 收起" on_click: || toggle_group(group.name)}
                                                    }
                                                    if expanded_name == group.name {
                                                        for i in group.batches.len() {
                                                            let f = group.batches[i]
                                                            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: .5}
                                                                View{width: Fill height: Fit flow: Down spacing: 2
                                                                    Copy{text: "第 " + (i + 1) + " 批 · " + f.quantity + f.unit}
                                                                    Hint{text: freshness(f) + " · " + expiry_text(f)}
                                                                }
                                                                Quiet{text: "编辑" on_click: || edit_food(f.id)}
                                                                Quiet{text: "丢弃/移除" on_click: || request_remove(f.id)}
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if tab == 2 {
                                    View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: .5}
                                        View{width: Fill height: Fit flow: Down spacing: 4
                                            Heading{text: "AI 生成食谱方案" draw_text.text_style.font_size: 30}
                                            if state.auto_generate { Hint{text: "自动生成已开启：库存、临期或用餐变化可创建候选，仍需你确认接受。"} }
                                            else { Hint{text: "手动生成：库存变化和临期只更新或提醒，点击生成或备选才创建新方案。"} }
                                        }
                                        Quiet{text: "+ 再给我一个备选" enabled: !ai_busy && plan_removal == nil on_click: || generate_alternative()}
                                    }
                                    let p = choose_plan()
                                    if plan_removal != nil {
                                        Frost{padding: 20 spacing: 12
                                            Copy{text: "确认删除这个方案？" draw_text.text_style: theme.font_bold{font_size: 20}}
                                            Copy{text: plan_removal.title}
                                            Hint{text: "只删除方案，不恢复或扣减库存，也不删除已记录的用餐数据。确认后无法在方案列表中撤销。"}
                                            if state.active == plan_removal.id { Hint{text: "这是当前今晚方案，删除后也会取消今晚方案。"} }
                                            View{width: Fill height: Fit flow: Right spacing: 10
                                                Soft{text: "确认删除方案" on_click: || confirm_delete_plan()}
                                                Soft{text: "取消删除" on_click: || cancel_delete_plan()}
                                            }
                                        }
                                    }
                                    if p == nil {
                                        Frost{padding: 26
                                            Copy{text: "还没有候选方案" draw_text.text_style: theme.font_bold{font_size: 20}}
                                            Hint{text: message}
                                            Action{text: "回首页" on_click: || navigate(0)}
                                        }
                                    }
                                    if p != nil && !pending && plan_removal == nil {
                                        let status = "候选 · 等你确认"
                                        if p.accepted { status = "已接受 · 今晚按此执行" }
                                        if p.accepted && p.id != state.active { status = "历史方案" }
                                        if p.consumed { status = "已完成 · 已记录到档案" }
                                        if !p.consumed && !plan_ready(p) { status = "方案已失效 · 请重新生成" }
                                        View{width: Fill height: Fit flow: Right spacing: 16
                                            Frost{width: Fill height: Fit padding: 22 spacing: 13 draw_bg.color: #ffffffc2
                                                View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: .5}
                                                    StatusDot{}
                                                    Hint{text: status}
                                                }
                                                Copy{text: p.title draw_text.text_style: theme.font_bold{font_size: 28}}
                                                Hint{text: "约 " + p.minutes + " 分钟 · " + p.source}
                                                if !p.consumed && !validate(p) {
                                                    Tint{draw_bg.color: #f4ede4
                                                        Copy{text: "库存或有效期已变化" draw_text.text_style: theme.font_bold{font_size: 16}}
                                                        Hint{text: "这个方案仅供查看，不能设为今晚方案或扣减库存。"}
                                                        if state.auto_generate { Hint{text: "自动生成已开启：请查看新候选并确认，也可以回首页手动生成。"} }
                                                        else { Hint{text: "回首页后点击生成这一餐；不会自动生成。"} }
                                                        Soft{text: "回首页重新生成" on_click: || navigate(0)}
                                                    }
                                                }
                                                Divider{}
                                                Copy{text: recipe_display_text(p.reason)}
                                                View{width: Fill height: Fit flow: Right spacing: 10
                                                    if plan_numeric(p) {
                                                        Tint{draw_bg.color: #f1ede7
                                                            Hint{text: "库存利用率"}
                                                            Copy{text: "" + plan_percent(p) + "%" draw_text.text_style: theme.font_bold{font_size: 20}}
                                                        }
                                                        Tint{draw_bg.color: #f5f2ed
                                                            Hint{text: "本餐估算"}
                                                            Copy{text: "约 " + meal_kcal(p) + " kcal" draw_text.text_style: theme.font_bold{font_size: 20}}
                                                        }
                                                    } else {
                                                        Tint{draw_bg.color: #f4ede4
                                                            Copy{text: "热量与营养无法核算" draw_text.text_style: theme.font_bold{font_size: 17}}
                                                            Hint{text: "按库存原单位规划；保质期未知的食材，请先确认新鲜度。"}
                                                        }
                                                    }
                                                }
                                                Copy{text: "将使用" draw_text.text_style: theme.font_bold{font_size: 16}}
                                                View{width: Fill height: Fit flow: Right spacing: 8
                                                    for u in p.uses { Quiet{text: food_emoji(u.name) + " " + u.name + "  " + use_quantity(u) + use_unit_text(u)} }
                                                }
                                                if details {
                                                    Tint{draw_bg.color: #f4f0e9
                                                        Copy{text: "做法" draw_text.text_style: theme.font_bold{font_size: 16}}
                                                        Copy{text: recipe_display_text(p.steps)}
                                                        if plan_numeric(p) { Hint{text: "请复核食材状态；营养数值为粗略估算，不替代医疗或营养专业建议。"} }
                                                        else { Hint{text: "保质期未知的食材请先确认新鲜度；本餐不提供热量或营养数值。"} }
                                                    }
                                                }
                                                if p.previous != "" {
                                                    Tint{draw_bg.color: #f4ede4
                                                        Copy{text: "Agent 已因状态变化重新规划" draw_text.text_style: theme.font_bold{font_size: 16}}
                                                        Hint{text: "原方案 · " + p.previous}
                                                        Copy{text: "新方案 · " + p.title}
                                                    }
                                                }
                                            }
                                            Frost{width: 310 height: Fit padding: 20 spacing: 12 draw_bg.color: #f5f1ebd9
                                                Copy{text: "采购补齐" draw_text.text_style: theme.font_bold{font_size: 18}}
                                                Hint{text: "当前比赛版只使用已确认库存生成方案，不虚构缺失食材。第三方买菜入口已预留。"}
                                                Divider{}
                                                Quiet{text: "生成采购清单 · 扩展能力" on_click: || { show_shopping = true redraw() }}
                                                if show_shopping {
                                                    Tint{draw_bg.color: #ffffffb0
                                                        Hint{text: "可接入：美团 / 盒马 / 京东到家"}
                                                        Copy{text: "一键下单 · 敬请期待" draw_text.text_style: theme.font_bold{font_size: 16}}
                                                    }
                                                }
                                                Soft{text: "查看 / 收起做法" on_click: || { details = !details redraw() }}
                                                Quiet{text: "稍后提醒" on_click: || snooze()}
                                            }
                                        }
                                        View{width: Fill height: Fit flow: Right spacing: 8
                                            Quiet{text: "‹ 上一个" enabled: selected > 0 && plan_removal == nil on_click: || step_history(-1)}
                                            Label{width: Fill text: "方案 " + (selected + 1) + " / " + state.plans.len() padding: 0 draw_text.color: muted}
                                            Soft{text: "删除这个方案…" enabled: !pending && !ai_busy && plan_removal == nil on_click: || request_delete_plan()}
                                            Quiet{text: "下一个 ›" enabled: selected + 1 < state.plans.len() && plan_removal == nil on_click: || step_history(1)}
                                        }
                                    }
                                    if p != nil && pending {
                                        Frost{padding: 22 spacing: 12
                                            Heading{text: "核对实际吃掉的量" draw_text.text_style.font_size: 26}
                                            Hint{text: "只有最后确认后才会扣减库存，并写入今天和本周期的饮食档案。"}
                                            if plan_numeric(p) { Field{text: extra_kcal_text empty_text: "额外用油、饮料等热量 kcal" on_change: |text| { extra_kcal_text = text }} }
                                            else { Hint{text: "本餐热量与营养未核算；确认后只扣实际使用的库存。"} }
                                            for i in consumption.len() {
                                                let u = consumption[i]
                                                View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: .5}
                                                    Copy{text: u.name + " · 第 " + batch_ordinal(u.food_id) + " 批"}
                                                    Field{width: 120 text: "" + use_quantity(u) on_change: |text| revise_amount(i, text)}
                                                    Hint{text: use_unit_text(u)}
                                                    Quiet{text: "换同名批次" on_click: || cycle_consume_batch(i)}
                                                }
                                            }
                                        }
                                    }
                                }
                                if tab == 3 {
                                    Frost{padding: 20 spacing: 10
                                        let program = active_program()
                                        Heading{text: "当前周期方案"}
                                        Copy{text: program.name + " · 第 " + program_day_index(program) + " / " + program.days + " 天"}
                                        Hint{text: "周期已核算热量 " + program.consumed_kcal + " / " + program.kcal_goal + " kcal"}
                                        Hint{text: "按已核算餐食计算的余额 " + program_remaining_total(program) + " kcal · 今日已核算 " + program_today_kcal(program) + " kcal"}
                                        if unquantified_meals() > 0 { Hint{text: "另有 " + unquantified_meals() + " 餐营养未核算；上述余额不代表实际剩余额度。"} }
                                        Hint{text: "蛋白质 " + program.consumed_protein + " / " + program.protein_goal + " g"}
                                        Hint{text: "膳食纤维 " + program.consumed_fiber + " / " + program.fiber_goal + " g"}
                                        Hint{text: "维生素 C " + program.consumed_vitamin_c + " / " + program.vitamin_c_goal + " mg"}
                                        Hint{text: "这里只累计你确认吃完的餐食，数值是示例估算，不等于全天真实摄入或医疗建议。"}
                                        Soft{text: "选择下一周期方案…" on_click: || renew_programs()}
                                    }
                                                                        View{width: Fill height: Fit flow: Down spacing: 4
                                        Heading{text: "长期饮食档案" draw_text.text_style.font_size: 30}
                                        Hint{text: "每次确认用餐后留下可追踪状态，下一餐继续在这份历史上规划。"}
                                    }
                                    View{width: Fill height: Fit flow: Right spacing: 16
                                        Frost{width: 330 height: Fit padding: 22 spacing: 14 draw_bg.color: #ffffffc2
                                            Hint{text: "今日已核算摄入 · 本地示例估算"}
                                            View{width: Fill height: Fit flow: Right spacing: 14 align: Align{y: .5}
                                                View{width: 100 height: 100 flow: Overlay align: Align{x: .5 y: .5}
                                                    ProgressRing{width: 100 height: 100 draw_bg.progress: nutrition_percent() / 100}
                                                    Label{text: "" + program_today_kcal(active_program()) padding: 0 draw_text +: {color: ink text_style: theme.font_bold{font_size: 20}}}
                                                }
                                                View{width: Fill height: Fit flow: Down spacing: 5
                                                    Copy{text: "/ " + state.daily_target + " kcal" draw_text.text_style: theme.font_bold{font_size: 17}}
                                                    Hint{text: "按已核算餐食剩余约 " + remaining_budget() + " kcal"}
                                                    Hint{text: "已记录 " + state.meal_count + " 餐"}
                                                    if unquantified_meals() > 0 { Hint{text: "其中 " + unquantified_meals() + " 餐营养未核算"} }
                                                }
                                            }
                                            Divider{}
                                            Hint{text: "比赛版不计算临床级营养指标；这里主要用于展示长期状态如何影响下一次规划。"}
                                        }
                                        Frost{width: Fill height: Fit padding: 22 spacing: 12
                                            Copy{text: "饮食画像正在形成" draw_text.text_style: theme.font_bold{font_size: 19}}
                                            View{width: Fill height: Fit flow: Right spacing: 10
                                                Tint{draw_bg.color: #f1ede7 Hint{text: "使用场景"} Copy{text: state.profile.scene draw_text.text_style: theme.font_bold{font_size: 16}}}
                                                Tint{draw_bg.color: #f5f2ed Hint{text: "近期偏好"} Copy{text: preference_summary() draw_text.text_style: theme.font_bold{font_size: 16}}}
                                                Tint{draw_bg.color: #f1ede7 Hint{text: "过敏 / 忌口"} Copy{text: state.profile.allergies + " / " + state.profile.avoidances draw_text.text_style: theme.font_bold{font_size: 16}}}
                                            }
                                            Divider{}
                                            Copy{text: "最近完成的餐" draw_text.text_style: theme.font_bold{font_size: 16}}
                                            if state.meal_count == 0 { Hint{text: "还没有确认完成的用餐记录。"} }
                                            for p2 in state.plans {
                                                if p2.consumed {
                                                    View{width: Fill height: Fit flow: Right spacing: 8
                                                        Copy{text: p2.title}
                                                        if plan_numeric(p2) { Hint{text: "约 " + meal_kcal(p2) + " kcal"} }
                                                        else { Hint{text: "热量与营养未核算"} }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    Action{width: 260 text: "去安排下一餐  →" on_click: || navigate(0)}
                                }
                                if tab == 4 {
                                    View{width: Fill height: Fit flow: Down spacing: 4
                                        Heading{text: "管家设置" draw_text.text_style.font_size: 30}
                                        Hint{text: "管理用户画像、Agent 运行方式与比赛演示。"}
                                    }
                                    View{width: Fill height: Fit flow: Right spacing: 16
                                        Frost{width: Fill height: Fit padding: 20 spacing: 12
                                            Copy{text: "用户画像" draw_text.text_style: theme.font_bold{font_size: 18}}
                                            Hint{text: state.profile.scene + " · " + state.profile.preferences}
                                            if state.profile.allergies != "" { Hint{text: "过敏 · " + state.profile.allergies} }
                                            if state.profile.avoidances != "" { Hint{text: "忌口 · " + state.profile.avoidances} }
                                            Soft{text: "重新设置用户画像" on_click: || restart_profile()}
                                            Soft{text: "选择下一周期方案…" on_click: || renew_programs()}
                                            Divider{}
                                            Copy{text: "运行与提醒" draw_text.text_style: theme.font_bold{font_size: 18}}
                                            View{width: Fill height: Fit flow: Right spacing: 8
                                                let pause_text = "暂停管家"
                                                if state.paused { pause_text = "恢复管家" }
                                                Soft{text: pause_text on_click: || toggle_pause()}
                                                let reminder_text = "关闭提醒"
                                                if !state.reminders { reminder_text = "打开提醒" }
                                                Soft{text: reminder_text on_click: || toggle_reminders()}
                                            }
                                            Divider{}
                                            Copy{text: "生成触发方式" draw_text.text_style: theme.font_bold{font_size: 18}}
                                            let trigger_text = "手动生成（默认）：库存变化、临期和吃完只更新数据或提醒。"
                                            let trigger_button = "开启自动生成（可选）"
                                            if state.auto_generate {
                                                trigger_text = "自动生成：库存变化、临期和吃完会创建新候选；不自动替换今晚方案或扣减库存。"
                                                trigger_button = "关闭自动生成"
                                            }
                                            Hint{text: trigger_text}
                                            Soft{text: trigger_button on_click: || toggle_auto_generation()}
                                            Hint{text: "此选项会保存。启用后在线 AI 可能额外计费；切换开关本身不生成方案。"}
                                        }
                                        Frost{width: Fill height: Fit padding: 20 spacing: 12
                                            Copy{text: "比赛演示" draw_text.text_style: theme.font_bold{font_size: 18}}
                                            Hint{text: "原菜单 → 时间推进 → 临期提醒 → 手动生成 → 确认吃完 → 写入档案。自动生成可在左侧选择开启。"}
                                            if !reset_pending { Soft{text: "载入演示数据…" on_click: || request_demo()} }
                                            if reset_pending {
                                                Hint{text: "将替换脚本版库存；演示前数据会另存备份。"}
                                                Action{text: "确认替换并开始演示" on_click: || install_demo()}
                                                Soft{text: "取消" on_click: || cancel_demo()}
                                            }
                                            View{width: Fill height: Fit flow: Right spacing: 8
                                                Soft{text: "时间 +12 小时" on_click: || fast_forward()}
                                                Soft{text: "恢复演示前数据" on_click: || restore_before_demo()}
                                            }
                                            if state.demo { Hint{text: "已快进 " + floor(state.offset / 3600) + " 小时 · 演示数据"} }
                                        }
                                    }
                                    Frost{padding: 20 spacing: 10
                                        Copy{text: "菜单生成方式" draw_text.text_style: theme.font_bold{font_size: 18}}
                                        let model_status = "本地规则：按到期时间安排家常搭配。"
                                        if use_ai {
                                            if ai_phase == 0 { model_status = "正在读取宿主 AI 配置…" }
                                            if ai_phase == 1 { model_status = "宿主模型服务可用；提供方由 OctoSense 管理。今日已调用约 " + ai_calls + " 次。" }
                                            if ai_phase == 2 { model_status = "宿主未配置可用模型，当前使用本地规则。" }
                                            if ai_phase == 3 { model_status = "AI 配置需要处理：" + ai_error }
                                            if ai_phase == 4 { model_status = "当前宿主不支持在线 AI，使用本地规则。" }
                                        }
                                        Hint{text: model_status}
                                        Hint{text: "模型密钥只在 OctoSense 的 AI 提供方设置中填写。本版本不读取 ai.env；语音识别暂不可用。"}
                                        View{width: Fill height: Fit flow: Right spacing: 8
                                            let model_button = "改用本地规则"
                                            if !use_ai { model_button = "启用在线 AI" }
                                            Soft{text: model_button enabled: !ai_busy on_click: || toggle_model()}
                                            Soft{text: "重新读取 AI 配置" enabled: !ai_busy && ai_phase != 0 on_click: || read_ai_config()}
                                        }
                                    }
                                    Copy{text: "最近执行记录" draw_text.text_style: theme.font_bold{font_size: 17}}
                                    if state.log.len() == 0 { Hint{text: "尚无记录。"} }
                                    for i in state.log.len() { Hint{text: state.log[state.log.len() - 1 - i].text} }
                                }
                            }}}
                            RoundedView{show_bg: true width: Fill height: Fit padding: Inset{left: 12 right: 12 top: 8 bottom: 8}
                                draw_bg +: {color: #f8f5f0d9 border_radius: 14}
                                notice := Hint{text: message draw_text.text_style.font_size: 11}}
                            actions := View{width: Fill height: Fit flow: Down spacing: 8 on_render: || {
                                View{width: Fill height: 0}
                                let p = choose_plan()
                                if tab == 2 && p != nil {
                                    if pending {
                                        confirm_consumption := Action{text: "确认吃完 · 扣减库存并写入档案" on_click: || confirm_consume()}
                                        Soft{text: "取消" on_click: || cancel_consume()}
                                    }
                                    if !pending && plan_removal == nil && !p.consumed && plan_ready(p) {
                                        if !p.accepted { Action{text: "就吃这套 · 设为今晚方案  →" enabled: !ai_busy on_click: || accept()} }
                                        if p.accepted && p.id == state.active { Action{text: "我吃完了 · 核对实际用量" enabled: !ai_busy on_click: || prepare_consume()} }
                                    }
                                }
                            }}
                        }
                    }
                }
            }}
        }
    }
}
