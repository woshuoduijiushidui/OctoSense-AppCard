        {name: "黄瓜" category: "蔬菜" spec: "500 g / 份" unit: "份" price_cents: 490 stock: 16 kcal: 16 protein: 0.8 fiber: 0.5 vitamin_c: 2.8 shelf_days: 5 emoji: "🥒"}
