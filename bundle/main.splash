let ink = #x22211f
let muted = #x77736d
let cream = #xf3efe8
let lime = #xe9e3d8
let line = #xe2ddd4
let glass = #xffffffe6
let glass_soft = #xffffffe0
let moss = #x272623
// Abstract cream light with restrained sage/lime blooms.
let Ambient = SolidView{width: Fill height: Fill draw_bg +: {
    pixel: fn(){
        let uv = self.pos
        let base = mix(#xf5f1eb, #e9e5de, uv.y)
        let sage = clamp(1.0 - length(uv - vec2(.82, .18)) * 1.65, 0.0, 1.0)
        let leaf = clamp(1.0 - length(uv - vec2(.14, .72)) * 1.35, 0.0, 1.0)
        let glow = clamp(1.0 - length(uv - vec2(.72, .84)) * 2.05, 0.0, 1.0)
        let color = mix(base, #xd7d0c5, sage * .30)
        let color = mix(color, #xc1b8aa, leaf * .18)
        let color = mix(color, #xffffff, glow * .35)
        return color
    }
}}
let Pill = ButtonFlat{draw_bg +: {
    pixel: fn(){
        let sdf = Sdf2d.viewport(self.pos * self.rect_size)
        sdf.box(1, 1, self.rect_size.x - 2, self.rect_size.y - 2, self.border_radius)
        let fill = mix(mix(self.color, self.color_hover, self.hover), self.color_down, self.down)
        sdf.fill_keep(mix(fill, #xe4e5d7, self.disabled))
        sdf.stroke(mix(fill, #x778470, self.focus), self.focus * 1.5)
        return sdf.result
    }
}}
let Action = Pill{width: Fill height: 56 margin: 0 padding: 12
    draw_bg +: {border_radius: 28 color: moss color_hover: #x373632 color_down: #x171714 color_focus: moss border_size: 0}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff text_style.font_size: 16}}
let Soft = Pill{width: Fill height: 48 margin: 0 padding: 9
    draw_bg +: {border_radius: 24 color: lime color_hover: #ded7cb color_down: #d2c9bb color_focus: lime border_size: 0}
    draw_text +: {color: ink color_hover: ink color_down: ink color_focus: ink text_style.font_size: 14}}
let Quiet = Pill{height: 42 margin: 0 padding: Inset{left: 13 right: 13}
    draw_bg +: {border_radius: 21 color: #xf4f1eced color_hover: #ebe6de color_down: #ddd6cb color_focus: #xf4f1eced border_size: 0}
    draw_text +: {color: ink color_hover: ink color_down: ink color_focus: ink text_style.font_size: 12}}
let ChosenSoft = Soft{
    draw_bg +: {color: moss color_hover: #x373632 color_down: #x171714 color_focus: moss}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff}}
let ChosenQuiet = Quiet{
    draw_bg +: {color: moss color_hover: #x373632 color_down: #x171714 color_focus: moss}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff}}
let Copy = Label{width: Fill padding: 0 draw_text +: {color: ink text_style.font_size: 14 line_spacing: 1.35}}
let Hint = Label{width: Fill padding: 0 draw_text +: {color: muted text_style.font_size: 12 line_spacing: 1.35}}
let Heading = Label{width: Fill padding: 0 draw_text +: {color: ink text_style: theme.font_bold{font_size: 27} line_spacing: 1.15}}
let Field = TextInput{width: Fill height: 54 margin: 0 padding: Inset{left: 16 right: 16}
    draw_bg +: {color: #xffffffc9 color_hover: #xffffffe5 color_focus: #xfffffff2 color_empty: #xffffffc9 border_radius: 22
        pixel: fn(){
            let sdf = Sdf2d.viewport(self.pos * self.rect_size)
            sdf.box(1, 1, self.rect_size.x - 2, self.rect_size.y - 2, 22)
            sdf.fill_keep(mix(#xffffffc9, #xfffffff2, self.focus))
            sdf.stroke(mix(#xffffffb8, #x4e765d, self.focus), 1)
            return sdf.result
        }}
    draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted text_style.font_size: 14}}
let VoiceButton = ButtonFlat{width: 64 height: 54 margin: 0 padding: 0 text: ""
    draw_bg +: {
        active: instance(0.0)
        pixel: fn(){
            let sdf = Sdf2d.viewport(self.pos * self.rect_size)
            sdf.box(2, 4, self.rect_size.x - 4, self.rect_size.y - 8, 22)
            sdf.fill(mix(#x00000000, mix(#xe8e3db80, #ddd5ca9a, self.down), self.hover))
            sdf.box(1, 11, 1, self.rect_size.y - 22, .5)
            sdf.fill(#xd8d1c7c8)
            let wave = mix(mix(#x22211f, #xc44d42, self.active), #x77736d, self.disabled)
            let cx = self.rect_size.x * .54
            let cy = self.rect_size.y * .5
            sdf.box(cx - 5, cy - 13, 10, 22, 5) sdf.fill(wave)
            sdf.box(cx - 11, cy - 2, 3, 10, 1.5) sdf.fill(wave)
            sdf.box(cx + 8, cy - 2, 3, 10, 1.5) sdf.fill(wave)
            sdf.box(cx - 9, cy + 7, 18, 3, 1.5) sdf.fill(wave)
            sdf.box(cx - 1.5, cy + 8, 3, 8, 1.5) sdf.fill(wave)
            sdf.box(cx - 7, cy + 14, 14, 3, 1.5) sdf.fill(wave)
            return sdf.result
        }}
    draw_text +: {color: #x00000000 color_hover: #x00000000 color_down: #x00000000 color_focus: #x00000000 text_style.font_size: 1}}
let Frost = RoundedView{show_bg: true width: Fill height: Fit flow: Down padding: 16 spacing: 10
    draw_bg +: {color: glass_soft border_radius: 24}}
let Tint = RoundedView{show_bg: true width: Fill height: Fit flow: Down padding: 15 spacing: 6
    draw_bg +: {color: #xf7f1df9e border_radius: 22}}
let EmojiGlass = RoundedView{show_bg: true width: 42 height: 42 flow: Overlay align: Align{x: .5 y: .5}
    draw_bg +: {color: #xffffff8f border_radius: 21}}
// The OctoSense host supplies the window frame; fill its entire content area.
// Keep the app surface in the normal draw order. GlassPanel hoists its entire
// child tree above the host's native device-permission sheet, leaving that
// sheet invisible while it still intercepts clicks.
let GlassCard = RoundedView{show_bg: true width: Fill height: Fill flow: Down padding: 0 spacing: 0
    draw_bg +: {color: #xf7f1ebe8 border_radius: 0}}
let Divider = SolidView{width: Fill height: 1 draw_bg.color: #x75826842}
let StatusDot = SolidView{width: 10 height: 10 draw_bg +: {color: #xb7a58a border_radius: 5}}
let ProgressRing = SolidView{width: 84 height: 84 draw_bg +: {
    progress: instance(.72)
    pixel: fn(){
        let sdf = Sdf2d.viewport(self.pos * self.rect_size)
        sdf.circle(self.rect_size.x * .5, self.rect_size.y * .5, self.rect_size.x * .39)
        sdf.stroke(mix(#xd4cec4, #x9f8b6d, clamp(self.progress, .0, 1.0)), self.rect_size.x * .075)
        return sdf.result
    }
}}

fn program_by_id(id){
    for p in state.programs { if p.id == id { return p } }
    nil
}
// Candidates (state.programs) are unconfirmed offers. A confirmed stage
// (state.stages) is a snapshot: it copies the candidate's targets and owns its
// own progress, per docs/adr/0001.
fn copy_stage_targets(stage, candidate){
    stage.name = candidate.name stage.days = candidate.days stage.goal = candidate.goal
    stage.daily_kcal = candidate.daily_kcal stage.kcal_goal = candidate.kcal_goal
    stage.protein_goal = candidate.protein_goal stage.fiber_goal = candidate.fiber_goal
    stage.vitamin_c_goal = candidate.vitamin_c_goal
}
fn make_stage(candidate, started){
    let s = {id: state.stage_next started: started kind: "health" meals: []
        consumed_kcal: 0 consumed_protein: 0 consumed_fiber: 0 consumed_vitamin_c: 0 intake: []}
    copy_stage_targets(s, candidate)
    state.stage_next = state.stage_next + 1
    s
}
// The current stage is the first one whose date range still covers today, so a
// multi-stage plan advances on its own dates.
fn current_stage(){
    if state.stages.len() == 0 { return nil }
    let today = health_day()
    let current = state.stages[state.stages.len() - 1]
    for s in state.stages {
        if today < floor(s.started / 86400) + s.days { current = s break }
    }
    current
}
// A plan is over once the calendar has passed the last stage's end date; the
// page must not keep calling that stage "current".
fn program_expired(){
    let stage = current_stage()
    stage != nil && program_day_index(stage) > stage.days
}
fn program_option(days, key, name, plan_goal, trait, difference, kcal_day, protein_day, fiber_day, vitamin_day){
    let p = {id: state.program_next name: name days: days variant: key
        goal: plan_goal trait: trait difference: difference daily_kcal: kcal_day
        kcal_goal: kcal_day * days protein_goal: protein_day * days
        fiber_goal: fiber_day * days vitamin_c_goal: vitamin_day * days}
    state.program_next = state.program_next + 1
    p
}
fn profile_ready(){
    let age = state.profile.age.to_f64()
    let height = state.profile.height.to_f64()
    let weight = state.profile.weight.to_f64()
    state.profile.special == "" && age >= 19 && age <= 78 && height >= 80 && height <= 230 && weight >= 25 && weight <= 300 && (state.profile.sex == "女性" || state.profile.sex == "男性")
}
fn base_daily_kcal(){
    if !profile_ready() { return 0 }
    let age = state.profile.age.to_f64()
    let height = state.profile.height.to_f64()
    let weight = state.profile.weight.to_f64()
    // Mifflin-St Jeor estimates resting expenditure, not an individual prescription.
    let resting = 10 * weight + 6.25 * height - 5 * age - 161
    if state.profile.sex == "男性" { resting = 10 * weight + 6.25 * height - 5 * age + 5 }
    let activity = 1.2
    if state.profile.activity == "中活动" { activity = 1.45 }
    if state.profile.activity == "高活动" { activity = 1.65 }
    let factor = 1.0
    if state.profile.scene == "减脂控卡" { factor = .93 }
    if state.profile.scene == "健身增肌" { factor = 1.05 }
    if state.profile.scene == "健身减脂" { factor = .96 }
    floor(max(resting, resting * activity * factor) / 50) * 50
}
fn numeric_base_kcal(){
    if !profile_ready() { return 0 }
    let base = base_daily_kcal()
    // 1350 = the 1200 kcal prototype floor plus the 150 kcal 控卡 step, so every
    // variant stays at or above the floor. A lower estimate gets no numbers.
    if base < 1350 { return 0 }
    base
}
fn training_scene(){ state.profile.scene == "健身增肌" || state.profile.scene == "健身减脂" }
fn bulking_scene(){ state.profile.scene == "健身增肌" }
fn variant_numbers(key, base){
    let weight = state.profile.weight.to_f64()
    let per_kg = .8
    if training_scene() { per_kg = 1.2 }
    let fiber_rate = .014
    let kcal = base
    if key == "protein" { per_kg = per_kg + .4 }
    if key == "fiber" { fiber_rate = .019 }
    if key == "trim" {
        per_kg = per_kg + .1 fiber_rate = .017
        if bulking_scene() { kcal = base + 150 } else { kcal = base - 150 }
        // Prototype floor: never suggest an energy target below 1200 kcal.
        if kcal < 1200 { kcal = 1200 }
    }
    let vitamin = 75
    if state.profile.sex == "男性" { vitamin = 90 }
    {kcal: kcal protein: floor(weight * per_kg) fiber: floor(kcal * fiber_rate) vitamin: vitamin}
}
fn scene_prefix(){
    if state.profile.scene == "减脂控卡" { return "减脂" }
    if state.profile.scene == "健身增肌" { return "增肌" }
    if state.profile.scene == "健身减脂" { return "健身减脂" }
    if state.profile.scene == "轻负担饮食" { return "轻负担" }
    ""
}
fn variant_label(key){
    if key == "protein" { return "高蛋白" }
    if key == "fiber" { return "高纤" }
    if key == "trim" {
        if bulking_scene() { return "加餐" }
        return "控卡"
    }
    "起步"
}
fn cycle_trait(days){
    if days == 1 { return "1 天短周期体验，先确认口味与备餐节奏，不锁定长期计划" }
    if days == 3 { return "3 天小跨度，适合周末或短期尝试" }
    if days == 7 { return "7 天一周节奏，便于观察执行难度" }
    if days == 15 { return "15 天两周过渡，开始形成稳定习惯" }
    if days == 21 { return "21 天三周，覆盖工作日与周末的波动" }
    "30 天一个月长期管理，需要持续备餐"
}
fn variant_trait(key, days){
    let text = cycle_trait(days)
    if key == "protein" { return text + "；蛋白质占比更高" }
    if key == "fiber" { return text + "；蔬菜与粗粮占比更高" }
    if key == "trim" {
        if bulking_scene() { return text + "；安排一次加餐" }
        return text + "；总量更克制"
    }
    text + "；各项按基线执行"
}
fn variant_goal(key, days, n, ready){
    let reason = "当前档案不能自动推算安全的数值目标；请由专业人员确认后再使用数值追踪。"
    if !ready {
        if key == "protein" { return reason + "该候选侧重蛋白质。" }
        if key == "fiber" { return reason + "该候选侧重膳食纤维。" }
        if key == "trim" {
            if bulking_scene() { return reason + "该候选安排一次加餐。" }
            return reason + "该候选在总能量上更克制。"
        }
        return reason + "该候选按基线执行。"
    }
    if key == "protein" { return "在 " + days + " 天里保持每日约 " + n.kcal + " kcal，把蛋白质提高到 " + n.protein + " g/天，优先训练恢复与饱腹。" }
    if key == "fiber" { return "在 " + days + " 天里保持每日约 " + n.kcal + " kcal，把膳食纤维提高到 " + n.fiber + " g/天，多用蔬菜与粗粮。" }
    if key == "trim" {
        if bulking_scene() { return "每日约 " + n.kcal + " kcal，用一次加餐补足增肌所需能量。" }
        return "每日约 " + n.kcal + " kcal，比基线更克制并略增纤维，控制总能量。"
    }
    "在 " + days + " 天里保持每日约 " + n.kcal + " kcal，蛋白质 " + n.protein + " g、膳食纤维 " + n.fiber + " g 的基线节奏。"
}
fn variant_difference(key, n, balance, ready){
    if !ready { return "档案信息不足，暂不推算数值差异。" }
    if key == "balance" { return "本周期基线方案；同周期另两份在蛋白质、纤维或能量上各有侧重。" }
    if key == "protein" { return "蛋白质比「起步」多 " + (n.protein - balance.protein) + " g/天，热量相同。" }
    if key == "fiber" { return "膳食纤维比「起步」多 " + (n.fiber - balance.fiber) + " g/天，热量相同。" }
    if bulking_scene() { return "热量比「起步」多 " + (n.kcal - balance.kcal) + " kcal/天，蛋白质略高。" }
    "热量比「起步」少 " + (balance.kcal - n.kcal) + " kcal/天，纤维略高。"
}
fn cycle_index(days){
    let index = 0
    for d in cycle_days { if d == days { return index } index = index + 1 }
    -1
}
fn cycle_candidates(days){
    let out = []
    for p in state.programs { if p.days == days { out.push(p) } }
    out
}
fn balance_id(days){
    let options = cycle_candidates(days)
    for p in options { if p.variant == "balance" { return p.id } }
    0
}
fn default_program_id(){
    if state.programs.len() == 0 { return 0 }
    let id = balance_id(7)
    if id == 0 { id = state.programs[0].id }
    id
}
fn select_cycle(days){
    experience_selected = false
    cycle_view = days
    // Keep the marker and the confirm button on the page the user is looking at.
    let found = false
    for p in state.programs { if p.id == program_selected && p.days == days { found = true } }
    if !found {
        let id = balance_id(days)
        if id > 0 { program_selected = id }
    }
    redraw()
}
fn variant_key(template){
    if template == 1 { return "protein" }
    if template == 2 { return "fiber" }
    if template == 3 { return "trim" }
    "balance"
}
fn make_cycle_candidates(days, seed){
    // A profile estimate below the prototype floor cannot support a safe target.
    let base = numeric_base_kcal()
    let ready = base > 0
    let balance = {kcal: 0 protein: 0 fiber: 0 vitamin: 0}
    if ready { balance = variant_numbers("balance", base) }
    // Seeded line-up: always the baseline plus two of the other three emphases,
    // so regeneration offers a genuinely different, still-safe candidate set.
    let second = 1 + (seed % 3)
    let third = 1 + ((seed + 1) % 3)
    for slot in 3 {
        let template = 0
        if slot == 1 { template = second }
        if slot == 2 { template = third }
        let key = variant_key(template)
        let n = {kcal: 0 protein: 0 fiber: 0 vitamin: 0}
        if ready { n = variant_numbers(key, base) }
        state.programs.push(program_option(days, key,
            "" + days + "天" + scene_prefix() + variant_label(key),
            variant_goal(key, days, n, ready), variant_trait(key, days),
            variant_difference(key, n, balance, ready),
            n.kcal, n.protein, n.fiber, n.vitamin))
    }
}
fn make_programs(){
    state.programs = []
    let index = 0
    for days in cycle_days {
        make_cycle_candidates(days, state.cycle_seed[index])
        index = index + 1
    }
    // 7-day baseline is the default single choice; 1-day stays available for the short trial.
    // Rebuilding the list also resets the viewed cycle so selection and view stay in sync.
    cycle_view = 7
    program_selected = default_program_id()
}
fn regenerate_cycle(){
    if pending || ai_busy || plan_removal != nil { message = "请先结束当前确认或方案生成。" redraw() return }
    let index = cycle_index(cycle_view)
    if index < 0 { return }
    let before = state.to_json()
    // Candidates are unconfirmed only; confirmed stages live in state.stages and
    // are never rewritten here.
    let kept = []
    for p in state.programs {
        if p.days != cycle_view { kept.push(p) }
    }
    state.programs = kept
    state.cycle_seed[index] = state.cycle_seed[index] + 1
    make_cycle_candidates(cycle_view, state.cycle_seed[index])
    let ordered = []
    for days in cycle_days { for p in state.programs { if p.days == days { ordered.push(p) } } }
    state.programs = ordered
    if program_by_id(program_selected) == nil {
        let fallback = balance_id(cycle_view)
        if fallback == 0 && state.programs.len() > 0 { fallback = state.programs[0].id }
        program_selected = fallback
    }
    // The draft may reference candidates that were just replaced.
    let remaining = []
    for id in plan_draft { if program_by_id(id) != nil { remaining.push(id) } }
    plan_draft = remaining
    draft_swap = -1
    record("重新生成 " + cycle_view + " 天周期候选；已确认计划与其它周期不变")
    if commit(before) { message = cycle_view + " 天候选已重新生成；已确认的计划与其它周期不受影响。" }
    redraw()
}
fn select_program(id){ experience_selected = false program_selected = id message = "已选择周期候选；确认后才开始执行。" redraw() }
fn draft_add(id){
    experience_selected = false
    let candidate = program_by_id(id)
    if candidate == nil { return }
    if plan_draft.len() >= 12 { message = "单个计划最多 12 个阶段；请先移除或调整已有阶段。" redraw() return }
    plan_draft.push(id)
    message = "已加入第 " + plan_draft.len() + " 阶段：" + candidate.name + "。确认前可调整顺序、替换或移除。"
    redraw()
}
fn draft_remove(index){
    if index < 0 || index >= plan_draft.len() { return }
    let gone = program_by_id(plan_draft[index])
    plan_draft.remove(index)
    draft_swap = -1
    if gone != nil { message = "已移除阶段：" + gone.name + "。" }
    redraw()
}
fn draft_move(index, delta){
    let target = index + delta
    if index < 0 || index >= plan_draft.len() || target < 0 || target >= plan_draft.len() { return }
    let held = plan_draft[index]
    plan_draft[index] = plan_draft[target]
    plan_draft[target] = held
    draft_swap = -1
    message = "已调整阶段顺序。"
    redraw()
}
fn draft_replace(index, id){
    if index < 0 || index >= plan_draft.len() || program_by_id(id) == nil { return }
    plan_draft[index] = id
    draft_swap = -1
    message = "已替换第 " + (index + 1) + " 阶段。"
    redraw()
}
fn draft_total_days(){
    let total = 0
    for id in plan_draft { let c = program_by_id(id) if c != nil { total = total + c.days } }
    total
}
// Start day number of the draft entry at index, counting from today.
fn plan_start_day(index){
    let cursor = floor(now() / 86400)
    for i in plan_draft.len() {
        if i >= index { return cursor }
        let c = program_by_id(plan_draft[i])
        if c != nil { cursor = cursor + c.days }
    }
    cursor
}
// Civil date from a day number (Howard Hinnant's algorithm), UTC like the rest of
// the app's day arithmetic.
fn month_day(day){
    let z = day + 719468
    let era = floor(z / 146097)
    let doe = z - era * 146097
    let yoe = floor((doe - floor(doe / 1460) + floor(doe / 36524) - floor(doe / 146096)) / 365)
    let doy = doe - (365 * yoe + floor(yoe / 4) - floor(yoe / 100))
    let mp = floor((5 * doy + 2) / 153)
    let d = doy - floor((153 * mp + 2) / 5) + 1
    let m = mp + 3 - 12 * floor(mp / 10)
    "" + m + "月" + d + "日"
}
fn stage_span_at(start, days){ month_day(start) + " – " + month_day(start + days - 1) }
fn stage_range(index, days){ stage_span_at(plan_start_day(index), days) }
fn plan_total_days(){
    let total = 0
    for s in state.stages { total = total + s.days }
    total
}
// Issue #10: a stage locks on the day its start date arrives. Editing only the
// not-yet-started suffix is what keeps confirmed progress and intake records
// safe, including when the user has fallen behind and never logged that day.
fn stage_locked(stage){ floor(stage.started / 86400) <= health_day() }
fn stage_span(stage){ stage_span_at(floor(stage.started / 86400), stage.days) }
fn stage_lock_hint(stage){
    if !stage_locked(stage) { return "尚未开始 · 替换、移除或改目标不受限；与相邻未开始阶段之间可调整顺序。" }
    if stage.intake.len() == 0 { return "阶段起始日期已到但还没有确认用餐记录；按日历锁定，不是故障。" }
    "已开始并已记录用餐，锁定以保留已完成进度。"
}
// Re-anchor every start date end-to-start from the plan's first day. Locked
// stages lead the list and keep their dates, so only the future suffix moves.
fn relayout_stages(){
    if state.stages.len() == 0 { return }
    let cursor = state.stages[0].started
    for s in state.stages { s.started = cursor cursor = cursor + s.days * 86400 }
}
fn future_stage_names(start_index){
    let names = ""
    for i in state.stages.len() {
        if i >= start_index {
            let s = state.stages[i]
            if names != "" { names = names + "、" }
            names = names + "第 " + (i + 1) + " 阶段 " + s.name + "（" + stage_span(s) + "）"
        }
    }
    names
}
fn stage_move(index, delta){
    let target = index + delta
    if index < 0 || index >= state.stages.len() || target < 0 || target >= state.stages.len() { return }
    if stage_locked(state.stages[index]) || stage_locked(state.stages[target]) {
        message = "已开始的阶段按起止日期锁定，不能调整顺序；只有尚未开始的阶段可以移动。"
        redraw() return
    }
    let before = state.to_json()
    let held = state.stages[index]
    state.stages[index] = state.stages[target]
    state.stages[target] = held
    relayout_stages()
    stage_edit = -1
    let impact = future_stage_names(min(index, target))
    record("调整未开始阶段顺序；已开始阶段与已确认记录不变")
    if commit(before) { message = "已调整顺序。受影响的未来目标：" + impact + "。已开始的阶段与已确认用餐记录不变。" }
    redraw()
}
fn stage_remove(index){
    if index < 0 || index >= state.stages.len() { return }
    if stage_locked(state.stages[index]) {
        message = "该阶段已开始，按起止日期锁定，不能移除。" + stage_lock_hint(state.stages[index])
        redraw() return
    }
    if state.stages.len() <= 1 { message = "计划至少保留一个阶段。" redraw() return }
    let before = state.to_json()
    state.stages.remove(index)
    relayout_stages()
    stage_edit = -1
    let impact = future_stage_names(index)
    record("移除未开始的未来阶段；已确认记录保留")
    if commit(before) { message = "已移除该未来阶段。受影响的未来目标：" + impact + "。已获得的进度与确认记录不变。" }
    redraw()
}
// Retarget a future stage by snapshotting another candidate over it. Same op
// covers both "替换" (a different cycle) and "改目标" (a different emphasis).
fn stage_replace(index, candidate_id){
    if index < 0 || index >= state.stages.len() { return }
    let stage = state.stages[index]
    if stage_locked(stage) {
        message = "该阶段已开始，按起止日期锁定，不能改目标。" + stage_lock_hint(stage)
        redraw() return
    }
    let candidate = program_by_id(candidate_id)
    if candidate == nil { return }
    if candidate.kcal_goal <= 0 { message = "该候选没有可用的数值目标，不能设为阶段目标。" redraw() return }
    let before = state.to_json()
    copy_stage_targets(stage, candidate)
    relayout_stages()
    stage_edit = -1
    let impact = future_stage_names(index)
    record("修改未开始阶段的目标：" + stage.name + "；已确认记录保留")
    if commit(before) { message = "已更新第 " + (index + 1) + " 阶段目标。受影响的未来目标：" + impact + "。已获得的进度与确认记录不变。" }
    redraw()
}
// 每日餐次固定为 3（早、中、晚）；进度口径见 GLOSSARY「进度」。
fn meals_per_day(){ 3 }
fn stage_done_meals(stage){ stage.intake.len() }
fn stage_planned_meals(stage){ stage.days * meals_per_day() }
fn stage_progress_percent(stage){
    goal_percent(stage_done_meals(stage), stage_planned_meals(stage))
}
fn stage_today_intake(stage){
    let today = health_day()
    let out = []
    if stage == nil { return out }
    for meal in stage.intake { if meal.day == today { out.push(meal) } }
    out
}
// Plan progress rolls up the per-stage meals. A future stage has no confirmed
// meals yet, so editing it never changes the confirmed numerator.
fn plan_done_meals(){
    let done = 0
    for s in state.stages { done = done + stage_done_meals(s) }
    done
}
fn plan_planned_meals(){
    let planned = 0
    for s in state.stages { planned = planned + stage_planned_meals(s) }
    planned
}
fn plan_progress_percent(){
    goal_percent(plan_done_meals(), plan_planned_meals())
}
fn plan_stage_index(stage){
    let i = 0
    for s in state.stages { i = i + 1 if s.id == stage.id { return i } }
    1
}
fn confirm_health_plan(){
    let entries = []
    for id in plan_draft { let c = program_by_id(id) if c != nil { entries.push(c) } }
    if entries.len() == 0 {
        let chosen = program_by_id(program_selected)
        if chosen == nil { message = "请先选择或组合一份周期方案。" redraw() return }
        entries.push(chosen)
    }
    for c in entries {
        if c.kcal_goal <= 0 {
            message = "当前档案不能自动推算安全的数值目标，请由专业人员确认后再使用数值追踪。"
            redraw() return
        }
    }
    let before = state.to_json()
    let saved_draft = plan_draft
    let saved_step = onboarding_step
    // Each stage snapshots its candidate's targets and starts where the previous
    // stage ended, so the ranges meet end-to-start.
    let cursor = floor(now() / 86400) * 86400
    let names = ""
    for c in entries {
        let stage = make_stage(c, cursor)
        if experience_selected { stage.kind = "experience" stage.name = "1 天轻食体验" }
        state.stages.push(stage)
        cursor = cursor + c.days * 86400
        if names != "" { names = names + " + " }
        names = names + c.name + "（" + c.days + " 天）"
    }
    state.profile.plan_approved = true
    state.health.start = now()
    state.health.day = floor(now() / 86400)
    state.health.meals_week = 0 state.health.meals_today = 0
    state.health.protein_week = 0 state.health.fiber_week = 0
    onboarding_step = 3
    let first = current_stage()
    if first != nil {
        state.daily_target = first.daily_kcal
        state.health.protein_goal = floor(first.protein_goal * 7 / first.days)
        state.health.fiber_goal = floor(first.fiber_goal * 7 / first.days)
    }
    state.consumed_kcal = 0
    plan_draft = [] draft_swap = -1 stage_edit = -1
    record("确认计划：" + entries.len() + " 个阶段 · " + names)
    if profile_edit_backup != nil {
        let original = profile_edit_backup
        state.profile.done = true
        onboarding_step = 4 tab = 4
        if commit(original) { message = "用户画像与新周期方案已保存，原有库存不变。" }
        profile_edit_backup = nil
        redraw() return
    }
    if commit(before) {
        message = "已启用 " + entries.len() + " 个阶段的计划。现在请录入冰箱里的真实食材。"
    } else {
        // Keep the composed plan when the write failed instead of dropping it.
        plan_draft = saved_draft
        onboarding_step = saved_step
    }
    redraw()
}
// Archive the current plan into bounded history and clear the live stages.
fn archive_plan(){
    if state.stages.len() > 0 {
        if state.plan_history.len() >= 12 { state.plan_history.remove(0) }
        state.plan_history.push(state.stages.to_json().parse_json())
    }
    state.stages = []
}
fn renew_programs(){
    experience_selected = false
    if pending || ai_busy || plan_removal != nil { message = "请先结束当前确认或方案生成。" redraw() return }
    let before = state.to_json()
    archive_plan() state.profile.plan_approved = false
    state.profile.done = false state.active = 0 state.revision = state.revision + 1
    plan_draft = [] draft_swap = -1 stage_edit = -1
    make_programs() onboarding_step = 2 cycle_view = 7 tab = 0
    record("开始选择下一周期；旧周期已存档，库存保持不变")
    if commit(before) { message = "新周期候选已生成。请选定后继续；旧库存未删除。" }
    redraw()
}
fn program_day_index(p){
    if p == nil || p.started <= 0 { return 0 }
    health_day() - floor(p.started / 86400) + 1
}
fn program_today_kcal(p){
    if p == nil { return 0 }
    let today = health_day()
    let total = 0
    for meal in p.intake { if meal.day == today { total = total + meal.kcal } }
    total
}
fn program_remaining_total(p){ if p == nil { return 0 } max(0, p.kcal_goal - p.consumed_kcal) }
fn program_remaining_daily(p){
    if p == nil || program_day_index(p) > p.days || program_day_index(p) < 1 { return 0 }
    min(program_remaining_total(p), max(0, p.daily_kcal - program_today_kcal(p)))
}
fn goal_percent(value, target){ if target <= 0 { return 0 } min(100, floor(value * 100 / target)) }
fn health_day(){ floor(now() / 86400) }
fn health_today_meals(){ if state.health.day != health_day() { return 0 } state.health.meals_today }
fn health_week_meals(){ if state.health.start <= 0 || now() - state.health.start >= 604800 { return 0 } state.health.meals_week }
fn health_week_protein(){ if health_week_meals() == 0 { return 0 } state.health.protein_week }
fn health_week_fiber(){ if health_week_meals() == 0 { return 0 } state.health.fiber_week }
fn health_daily_percent(){
    min(100, floor(health_today_meals() * 100 / meals_per_day()))
}
fn health_week_percent(){
    min(100, floor(health_week_meals() * 100 / (meals_per_day() * 7)))
}
fn nutrient_reference(name, food_id){
    for f in state.foods {
        if f.id == food_id && has_field(f, "nutrition") {
            let n = f.nutrition.to_json().parse_json() n.known = true return n
        }
    }
    if name == "豆腐" { return {known: true kcal: 76 protein: 8 fiber: 1 vitamin_c: 0} }
    if name == "菠菜" { return {known: true kcal: 23 protein: 3 fiber: 2.2 vitamin_c: 28} }
    if name == "鸡蛋" { return {known: true kcal: 143 protein: 13 fiber: 0 vitamin_c: 0} }
    if name == "蘑菇" { return {known: true kcal: 22 protein: 3 fiber: 1 vitamin_c: 2} }
    {known: false kcal: 0 protein: 0 fiber: 0 vitamin_c: 0}
}
fn meal_nutrients(uses){
    let kcal = 0
    let protein = 0
    let fiber = 0
    let vitamin = 0
    let complete = true
    for u in uses {
        let n = nutrient_reference(u.name, u.food_id)
        if has_field(u, "nutrition") { n = u.nutrition }
        if !(u.grams > 0) { n = {known: false} }
        if !n.known { complete = false }
        if n.known {
            kcal = kcal + u.grams * n.kcal / 100
            protein = protein + u.grams * n.protein / 100
            fiber = fiber + u.grams * n.fiber / 100
            vitamin = vitamin + u.grams * n.vitamin_c / 100
        }
    }
    {complete: complete kcal: floor(kcal) protein: floor(protein * 10) / 10
        fiber: floor(fiber * 10) / 10 vitamin_c: floor(vitamin * 10) / 10}
}
fn record_health_meal(uses, numeric){
    if state.health.start <= 0 { state.health.start = now() }
    if now() - state.health.start >= 604800 {
        state.health.start = now() state.health.meals_week = 0
        state.health.protein_week = 0 state.health.fiber_week = 0
        state.health.meals_today = 0 state.health.day = health_day()
    }
    if state.health.day != health_day() { state.health.day = health_day() state.health.meals_today = 0 }
    state.health.meals_today = state.health.meals_today + 1
    state.health.meals_week = state.health.meals_week + 1
    let estimate = meal_nutrients(uses)
    if numeric {
        state.health.protein_week = state.health.protein_week + estimate.protein
        state.health.fiber_week = state.health.fiber_week + estimate.fiber
    }
}
fn clear_nutrition_draft(){
    draft_kcal = "" draft_protein = "" draft_fiber = "" draft_vitamin_c = ""
    show_nutrition_input = false
}

fn plan_numeric(p){
    if p != nil && p.to_json().search("\"numeric\"") >= 0 && p.numeric == false { return false }
    true
}
// Issue #23: a menu is one day with three meals. `uses` stays the merged list so
// stock, budget and eating keep one place to look. Acceptance checks only
// 过敏忌口、营养参考 and 当天剩余额度; 库存 becomes a per-ingredient status.
fn menu_meals(p){
    if p != nil && p.to_json().search("\"meals\"") >= 0 { return p.meals }
    let empty = []
    empty
}
fn meal_label(index){ if index == 0 { return "早餐" } if index == 1 { return "午餐" } "晚餐" }
fn use_grams(item){
    if item.grams > 0 { return item.grams }
    for f in state.foods { if f.id == item.food_id { return batch_grams(f) } }
    0
}
fn use_amount_text(item){
    if item.grams > 0 { return use_grams(item) + " g" }
    use_quantity(item) + use_unit_text(item)
}
fn menu_meal_grams(meal){
    let total = 0
    for item in meal.uses { total = total + use_grams(item) }
    total
}
fn menu_title(p){
    if p == nil { return "日菜单" }
    if p.to_json().search("\"title\"") >= 0 && p.title != "" { return p.title }
    "日菜单"
}
fn menu_issue(p){
    if p == nil { return "这份菜单不存在。" }
    if p.consumed { return "这份菜单已经记录过用餐。" }
    if p.uses.len() == 0 { return "这份菜单没有食材。" }
    if p.to_json().search("\"stage_id\":") >= 0 {
        let stage = current_stage()
        if stage == nil || p.stage_id != stage.id { return "当前阶段已变化，请重新生成菜单。" }
    }
    for item in p.uses {
        if excluded_food(item.name) { return "「" + item.name + "」违反过敏或忌口，不能接受。" }
    }
    let estimate = meal_nutrients(p.uses)
    if !estimate.complete { return "有食材缺少每 100 g 营养参考，无法核算，不能接受。" }
    if estimate.kcal <= 0 { return "这份菜单没有可核算的热量，不能接受。" }
    let program = current_stage()
    if program == nil || program_remaining_daily(program) <= 0 { return "当前阶段未启用、已结束，或今天额度已用完。" }
    if estimate.kcal > program_remaining_daily(program) { return "整份菜单约 " + estimate.kcal + " kcal，超过今天剩余 " + program_remaining_daily(program) + " kcal。" }
    ""
}
fn menu_ready(p){ menu_issue(p) == "" }
fn menu_ingredients(p){
    let lines = []
    for item in p.uses {
        let found = -1
        for i in lines.len() { if lines[i].name == item.name { found = i } }
        if found >= 0 { lines[found].grams = lines[found].grams + use_grams(item) }
        else { lines.push({name: item.name grams: use_grams(item)}) }
    }
    lines
}
fn available_grams(name){
    let total = 0
    for food in state.foods { if food.name == name && plan_eligible(food) { total = total + batch_grams(food) } }
    total
}
fn menu_stock_lines(p){
    let out = []
    for line in menu_ingredients(p) {
        let have = available_grams(line.name)
        let short = 0
        if have < line.grams { short = ceil(line.grams - have) }
        out.push({name: line.name grams: line.grams available: have short: short})
    }
    out
}
// Issue #25: the 模拟商品 catalog is fixed demo data shipped with the bundle —
// no network, no real prices. 秋葵 is deliberately absent so at least one 缺菜
// can demonstrate the "no matching product" path.
fn market_products(){
    [
        {name: "菠菜" category: "蔬菜" spec: "300 g / 把" unit: "把" price_cents: 480 stock: 20 kcal: 23 protein: 3 fiber: 2.2 vitamin_c: 28 shelf_days: 3 emoji: "🥬"}
        {name: "青菜" category: "蔬菜" spec: "400 g / 把" unit: "把" price_cents: 420 stock: 15 kcal: 15 protein: 1.5 fiber: 1.5 vitamin_c: 45 shelf_days: 3 emoji: "🥬"}
        {name: "生菜" category: "蔬菜" spec: "250 g / 把" unit: "把" price_cents: 390 stock: 10 kcal: 15 protein: 1.4 fiber: 1.3 vitamin_c: 8 shelf_days: 4 emoji: "🥬"}
        {name: "番茄" category: "蔬菜" spec: "500 g / 份" unit: "份" price_cents: 690 stock: 18 kcal: 18 protein: 0.9 fiber: 1.2 vitamin_c: 14 shelf_days: 6 emoji: "🍅"}
        {name: "胡萝卜" category: "蔬菜" spec: "500 g / 袋" unit: "袋" price_cents: 350 stock: 22 kcal: 39 protein: 1 fiber: 2.8 vitamin_c: 5.9 shelf_days: 14 emoji: "🥕"}
        {name: "土豆" category: "蔬菜" spec: "1 kg / 袋" unit: "袋" price_cents: 590 stock: 25 kcal: 77 protein: 2 fiber: 2.2 vitamin_c: 19 shelf_days: 20 emoji: "🥔"}
        {name: "西兰花" category: "蔬菜" spec: "400 g / 个" unit: "个" price_cents: 780 stock: 12 kcal: 34 protein: 2.8 fiber: 2.6 vitamin_c: 89 shelf_days: 5 emoji: "🥦"}
        {name: "黄瓜" category: "蔬菜" spec: "500 g / 份" unit: "份" price_cents: 490 stock: 16 kcal: 16 protein: 0.8 fiber: 0.5 vitamin_c: 2.8 shelf_days: 5 emoji: "🥒"}
        {name: "蘑菇" category: "蔬菜" spec: "200 g / 盒" unit: "盒" price_cents: 620 stock: 14 kcal: 22 protein: 3.1 fiber: 1 vitamin_c: 2 shelf_days: 5 emoji: "🍄"}
