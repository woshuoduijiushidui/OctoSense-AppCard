                                    Copy{text: "饮食偏好与忌口" draw_text.text_style: theme.font_bold{font_size: 16}}
                                    Field{text: profile_diet empty_text: "例如：清淡、家常、少油" on_change: |text| { profile_diet = text }}
                                    Field{text: profile_avoid empty_text: "过敏 / 忌口 / 不喜欢的食材" on_change: |text| { profile_avoid = text }}
